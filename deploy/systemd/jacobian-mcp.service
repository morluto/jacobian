[Unit]
Description=Jacobian remote MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jacobian
Group=jacobian
WorkingDirectory=/opt/jacobian/current
Environment=PYTHONUNBUFFERED=1
LoadCredential=tokens.json:/etc/jacobian-mcp/tokens.json
ExecStart=/usr/bin/env /opt/jacobian/current/.venv/bin/jacobian-remote-mcp \
  --transport streamable-http \
  --host 127.0.0.1 \
  --port 8765 \
  --path /mcp \
  --auth-tokens-file %d/tokens.json \
  --public-base-url https://math-tools.example.org
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=jacobian-mcp
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
