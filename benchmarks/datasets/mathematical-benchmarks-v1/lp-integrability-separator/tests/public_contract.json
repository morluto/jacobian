{
  "evidence": {
    "allowed_paths": [
      "evidence/answer.txt"
    ],
    "digest_pattern": "^sha256:[0-9a-f]{64}$",
    "max_items": 1,
    "media_types": [
      "text/plain"
    ],
    "min_items": 1,
    "payload_shape": null
  },
  "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result and validates a witness only where the task needs one.",
  "required_artifact_filenames": [
    "evidence/answer.txt"
  ],
  "schema_definitions": {},
  "schema_version": "1",
  "submission_path": "/app/submission.json",
  "submission_result": {
    "additionalProperties": false,
    "properties": {
      "beta": {
        "maxLength": 80,
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
        "type": "string"
      },
      "critical_p": {
        "const": "2"
      },
      "infinity_power_coefficient": {
        "const": "-1/2"
      },
      "lower_regime": {
        "const": {
          "obstruction": "INFINITY_POWER_TAIL",
          "p_interval": "0<p<2"
        }
      },
      "origin_power_coefficient": {
        "const": "-1/2"
      },
      "p2_integral_each": {
        "maxLength": 80,
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
        "type": "string"
      },
      "p2_log_exponent": {
        "maxLength": 80,
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
        "type": "string"
      },
      "upper_regime": {
        "const": {
          "obstruction": "ORIGIN_POWER_SINGULARITY",
          "p_interval": "p>2"
        }
      }
    },
    "required": [
      "beta",
      "origin_power_coefficient",
      "infinity_power_coefficient",
      "p2_log_exponent",
      "p2_integral_each",
      "critical_p",
      "lower_regime",
      "upper_regime"
    ],
    "type": "object"
  },
  "submission_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "result": {
        "additionalProperties": false,
        "properties": {
          "beta": {
            "maxLength": 80,
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
            "type": "string"
          },
          "critical_p": {
            "const": "2"
          },
          "infinity_power_coefficient": {
            "const": "-1/2"
          },
          "lower_regime": {
            "const": {
              "obstruction": "INFINITY_POWER_TAIL",
              "p_interval": "0<p<2"
            }
          },
          "origin_power_coefficient": {
            "const": "-1/2"
          },
          "p2_integral_each": {
            "maxLength": 80,
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
            "type": "string"
          },
          "p2_log_exponent": {
            "maxLength": 80,
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
