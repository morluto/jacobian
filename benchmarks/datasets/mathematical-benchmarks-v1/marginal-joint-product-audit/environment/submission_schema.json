{
  "$defs": {
    "joint_entry": {
      "additionalProperties": false,
      "properties": {
        "mass": {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "minimum": 1,
              "type": "integer"
            },
            "numerator": {
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "mass"
      ],
      "type": "object"
    },
    "product_entry": {
      "additionalProperties": false,
      "properties": {
        "mass": {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "minimum": 1,
              "type": "integer"
            },
            "numerator": {
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "value",
        "mass"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "const": "MISSING_JOINT_LAW_CONTROL"
        },
        "limit_joint": {
          "items": {
            "$ref": "#/$defs/joint_entry"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "limit_product_distribution": {
          "items": {
            "$ref": "#/$defs/product_entry"
          },
          "minItems": 1,
          "type": "array"
        },
        "missing_assumption": {
          "enum": [
            "JOINT_CONVERGENCE",
            "LIMIT_PAIR_INDEPENDENCE"
          ]
        },
        "prelimit_joint": {
          "items": {
            "$ref": "#/$defs/joint_entry"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "prelimit_product_distribution": {
          "items": {
            "$ref": "#/$defs/product_entry"
          },
          "minItems": 1,
          "type": "array"
        },
        "sequence_model": {
          "const": "CONSTANT_IN_N"
        },
        "support": {
          "const": [
            -3,
            -1,
            2,
            5
          ]
        },
        "witness_product_value": {
          "type": "integer"
        }
      },
      "required": [
        "diagnosis",
        "sequence_model",
        "support",
        "prelimit_joint",
        "limit_joint",
        "prelimit_product_distribution",
        "limit_product_distribution",
        "witness_product_value",
        "missing_assumption"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
