{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "enum": [
            "constructive",
            "obstruction"
          ],
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "GRAPHICAL",
            "NONGRAPHICAL"
          ]
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/violation"
          },
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "status",
        "edges",
        "violations"
      ],
      "type": "object"
    },
    "edge": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "violation": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "minimum": 1,
          "type": "integer"
        },
        "lhs": {
          "minimum": 0,
          "type": "integer"
        },
        "rhs": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "k",
        "lhs",
        "rhs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "constructive"
                  }
                },
                "required": [
                  "case_id"
                ],
                "type": "object"
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "obstruction"
                  }
                },
                "required": [
                  "case_id"
                ],
                "type": "object"
              },
              "maxContains": 1,
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/case"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
