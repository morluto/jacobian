#!/usr/bin/env python3
"""Plan Harbor contract and Oracle work from changed benchmark paths.

This planner is deliberately independent from the product CI classifier.  A
benchmark-only change never turns on a product Python lane, and a product-only
change never turns on Harbor execution.
"""

from __future__ import annotations

import argparse
import importlib
import json
import math
import subprocess
import sys
import tomllib
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

EVENTS = ("pull_request", "merge_group", "push", "schedule", "workflow_dispatch")
MAX_PULL_REQUEST_ORACLE_TASKS = 8
TARGET_TASKS_PER_SHARD = 12
MAX_DATASET_SHARDS = 4
BENCHMARK_CONTROL_PATHS = frozenset(
    {
        ".github/scripts/plan-benchmarks",
        ".github/scripts/validate-benchmark-plan",
        ".github/workflows/benchmarks.yml",
        ".github/workflows/heldout-benchmarks.yml",
        "Makefile",
        "tools/check_benchmark_adapters.py",
        "tools/check_benchmark_contracts.py",
        "tools/check_harbor_dataset.py",
        "tools/sync_harbor_verifier_support.py",
    }
)
BENCHMARK_EXECUTION_CONTROL_PATHS = frozenset(
    {
        "tools/check_benchmark_adapters.py",
        "tools/check_benchmark_contracts.py",
        "tools/check_harbor_dataset.py",
        "tools/sync_harbor_verifier_support.py",
    }
)
BENCHMARK_CONFIG_PREFIX = "benchmarks/config/"


def _json(value: object) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def _harbor_suite() -> Any:
    return importlib.import_module("benchmarks.tooling.harbor_suite")


def _digest(path: Path) -> str:
    digest = _harbor_suite().task_digest(path)
    return digest if digest.startswith("sha256:") else f"sha256:{digest}"


def _membership() -> tuple[dict[str, list[tuple[str, Path]]], dict[str, Any]]:
    by_task: dict[str, list[tuple[str, Path]]] = {}
    suites: dict[str, Any] = {}
    for suite in _harbor_suite().load_registry():
        suites[suite.id] = suite
        for ref in suite.tasks:
            by_task.setdefault(ref.path.name, []).append((suite.id, ref.path))
    return by_task, suites


def _exact_entry(dataset: str, task: str, path: Path) -> dict[str, Any]:
    return {
        "dataset": dataset,
        "shard": task,
        "tasks": [task],
        "task_digests": [{"task": task, "digest": _digest(path)}],
    }


def _shard_entries(
    suites: list[Any] | tuple[Any, ...],
    *,
    timings: dict[str, float] | None = None,
) -> list[dict[str, Any]]:
    timings = timings or {}
    matrix: list[dict[str, Any]] = []
    for suite in suites:
        tasks = list(suite.tasks)
        if not tasks:
            continue
        shard_count = min(
            MAX_DATASET_SHARDS,
            max(1, math.ceil(len(tasks) / TARGET_TASKS_PER_SHARD)),
        )
        bins: list[tuple[float, list[Any]]] = [(0.0, []) for _ in range(shard_count)]
        weighted = sorted(
            tasks,
            key=lambda ref: (
                -timings.get(f"{suite.id}/{ref.path.name}", 1.0),
                ref.path.name,
            ),
        )
        for ref in weighted:
            index = min(range(shard_count), key=lambda item: (bins[item][0], item))
            weight, assigned = bins[index]
            assigned.append(ref)
            bins[index] = (
                weight + timings.get(f"{suite.id}/{ref.path.name}", 1.0),
                assigned,
            )
        for index, (_weight, assigned) in enumerate(bins, start=1):
            ordered = sorted(assigned, key=lambda ref: ref.path.name)
            matrix.append(
                {
                    "dataset": suite.id,
                    "shard": f"{index:02d}-of-{shard_count:02d}",
                    "tasks": [ref.path.name for ref in ordered],
                    "task_digests": [
                        {"task": ref.path.name, "digest": _digest(ref.path)}
                        for ref in ordered
                    ],
                }
            )
    return matrix


def _full_plan(
    reason: str, *, timings: dict[str, float] | None = None
) -> dict[str, str]:
    suites = _harbor_suite().load_registry()
    matrix = _shard_entries(suites, timings=timings)
    return {
        "run-benchmark-check": "true",
        "run-benchmark-oracle": "true",
        "benchmark-oracle-scope": "all",
        "benchmark-oracle-matrix": _json(matrix),
        "benchmark-plan-reasons": _json([reason]),
    }


def _require_dataset_version_bumps(
    paths: list[str], *, base: str | None = None
) -> None:
    changed = set(paths)
    requiring_bump: set[str] = set()
    for path in paths:
        parts = Path(path).parts
        if len(parts) < 4 or parts[:2] != ("benchmarks", "datasets"):
            continue
        dataset = parts[2]
        relative = parts[3:]
        if (
            relative == ("suite.toml",)
            or relative[:1] == ("members",)
            or (
                len(relative) >= 2
                and relative[1:] != ("README.md",)
                and relative[0] not in {"jobs", "members"}
            )
        ):
            requiring_bump.add(dataset)
    missing = sorted(
        dataset
        for dataset in requiring_bump
        if f"benchmarks/datasets/{dataset}/suite.toml" not in changed
    )
    if missing:
        raise _harbor_suite().HarborSuiteError(
            "benchmark task or membership changes require a dataset version bump in "
            + ", ".join(
                f"benchmarks/datasets/{dataset}/suite.toml" for dataset in missing
            )
        )
    if base is None:
        return
    unchanged: list[str] = []
    for dataset in requiring_bump:
        path = f"benchmarks/datasets/{dataset}/suite.toml"
        current = tomllib.loads((ROOT / path).read_text(encoding="utf-8"))
        previous_text = subprocess.run(
            ["git", "show", f"{base}:{path}"],
            cwd=ROOT,
            check=False,
            capture_output=True,
            text=True,
        ).stdout
        if not previous_text:
            continue
        previous = tomllib.loads(previous_text)
        if current.get("dataset", {}).get("version") == previous.get("dataset", {}).get(
            "version"
        ):
            unchanged.append(path)
    if unchanged:
        raise _harbor_suite().HarborSuiteError(
            "benchmark dataset version value did not change in "
            + ", ".join(sorted(unchanged))
        )


def _oracle_matrix(
    *,
    scope: str,
    oracle_tasks: set[str],
    affected_datasets: set[str],
    by_task: dict[str, list[tuple[str, Path]]],
    suites_by_id: dict[str, Any],
    timings: dict[str, float] | None,
) -> list[dict[str, Any]]:
    if scope == "all":
        return _shard_entries(_harbor_suite().load_registry(), timings=timings)
    if scope == "affected-datasets":
        return _shard_entries(
            [suite for suite in suites_by_id.values() if suite.id in affected_datasets],
            timings=timings,
        )
    return [
        _exact_entry(dataset, task_id, path)
        for task_id in sorted(oracle_tasks)
        for dataset, path in by_task[task_id]
    ]


def _forced_full_plan(
    *,
    paths: list[str],
    base: str | None,
    timings: dict[str, float] | None,
    reason: str,
) -> dict[str, str]:
    if paths:
        benchmark_changed = [
            path
            for path in paths
            if path == "benchmarks"
            or path.startswith("benchmarks/")
            or path in BENCHMARK_CONTROL_PATHS
        ]
        if benchmark_changed:
            _require_dataset_version_bumps(benchmark_changed, base=base)
    return _full_plan(reason, timings=timings)


def plan(
    paths: list[str],
    *,
    event: str = "pull_request",
    force_full: bool = False,
    timings: dict[str, float] | None = None,
    base: str | None = None,
) -> dict[str, str]:
    if event not in EVENTS:
        raise ValueError(f"unsupported benchmark event: {event}")
    if force_full or event in {"schedule", "workflow_dispatch"}:
        reason = "forced full portfolio" if force_full else f"{event} full portfolio"
        return _forced_full_plan(paths=paths, base=base, timings=timings, reason=reason)

    benchmark_paths = [
        path
        for path in paths
        if path == "benchmarks"
        or path.startswith("benchmarks/")
        or path in BENCHMARK_CONTROL_PATHS
    ]
    if not benchmark_paths:
        return {
            "run-benchmark-check": "false",
            "run-benchmark-oracle": "false",
            "benchmark-oracle-scope": "none",
            "benchmark-oracle-matrix": "[]",
            "benchmark-plan-reasons": "[]",
        }
    _require_dataset_version_bumps(benchmark_paths, base=base)

    # Merge groups own integration Oracle evidence.  A main push repeats the
    # deterministic contract check for the landed tree without rerunning the
    # same Docker portfolio after merge-queue validation.
    if event == "push":
        return {
            "run-benchmark-check": "true",
            "run-benchmark-oracle": "false",
            "benchmark-oracle-scope": "none",
            "benchmark-oracle-matrix": "[]",
            "benchmark-plan-reasons": _json(
                ["main push repeats contracts; merge queue owns Oracle evidence"]
            ),
        }

    by_task, suites_by_id = _membership()
    oracle_tasks: set[str] = set()
    affected_datasets: set[str] = set()
    reasons: list[str] = []
    run_oracle = False
    scope = "none"
    unknown = False
    integration = event == "merge_group"

    for path in benchmark_paths:
        if path.startswith(BENCHMARK_CONFIG_PREFIX):
            if integration:
                scope = "all"
                run_oracle = True
                reasons.append("benchmark execution configuration change")
            else:
                reasons.append(
                    "benchmark execution configuration Oracle deferred to merge queue"
                )
            continue
        if path in BENCHMARK_CONTROL_PATHS:
            if path in BENCHMARK_EXECUTION_CONTROL_PATHS and integration:
                scope = "all"
                run_oracle = True
                reasons.append("benchmark execution control-plane change")
            elif path in BENCHMARK_EXECUTION_CONTROL_PATHS:
                reasons.append("control-plane Oracle deferred to merge queue")
            else:
                reasons.append("benchmark planning or workflow contract change")
            continue

        parts = Path(path).parts
        if len(parts) >= 3 and parts[:2] == ("benchmarks", "datasets"):
            dataset_id = parts[2]
            if dataset_id not in suites_by_id:
                unknown = True
                reasons.append(f"unknown dataset path: {path}")
                continue
            relative = parts[3:]
            task_id = relative[0] if len(relative) >= 2 else None
            suite = suites_by_id[dataset_id]
            suite_task_ids = {ref.path.name for ref in suite.tasks}
            if task_id in suite_task_ids:
                affected_datasets.add(dataset_id)
                task_relative = relative[1:]
                if task_relative != ("README.md",):
                    oracle_tasks.add(task_id)
                    run_oracle = True
                    reasons.append(f"executable task change: {task_id}")
                else:
                    reasons.append(f"task documentation change: {task_id}")
                continue
            if relative[:1] in {("README.md",), ("dataset.toml",)}:
                reasons.append(
                    f"dataset documentation or generated manifest: {dataset_id}"
                )
                continue
            affected_datasets.add(dataset_id)
            if integration:
                scope = "affected-datasets"
                run_oracle = True
                reasons.append(f"dataset integration change: {dataset_id}")
            else:
                reasons.append(f"dataset Oracle deferred to merge queue: {dataset_id}")
            continue

        if path.startswith("benchmarks/validation/") or path in {
            "benchmarks/README.md",
            "benchmarks/__init__.py",
        }:
            reasons.append("benchmark validation or documentation change")
            continue
        if path.startswith("benchmarks/templates/"):
            reasons.append("benchmark authoring template change")
            continue
        if path == "benchmarks/adapters/README.md":
            reasons.append("adapter documentation change")
            continue
        if path.startswith("benchmarks/adapters/"):
            if integration:
                scope = "all"
                run_oracle = True
                reasons.append("adapter integration change")
            else:
                reasons.append("adapter Oracle deferred to merge queue")
            continue
        if path.startswith(("benchmarks/tooling/", "benchmarks/schemas/")) or path == (
            "benchmarks/registry.toml"
        ):
            if integration:
                scope = "all"
                run_oracle = True
                reasons.append("shared benchmark integration change")
            else:
                reasons.append("shared-support Oracle deferred to merge queue")
            continue
        unknown = True
        reasons.append(f"unclassified benchmark path: {path}")

    if unknown:
        scope = "all"
        run_oracle = True
        reasons.append("fail-closed benchmark path classification")

    if (
        event == "pull_request"
        and scope == "none"
        and len(oracle_tasks) > MAX_PULL_REQUEST_ORACLE_TASKS
    ):
        run_oracle = False
        oracle_tasks.clear()
        reasons.append(
            "large changed-task Oracle set deferred to merge queue "
            f"(limit {MAX_PULL_REQUEST_ORACLE_TASKS})"
        )

    matrix = _oracle_matrix(
        scope=scope,
        oracle_tasks=oracle_tasks,
        affected_datasets=affected_datasets,
        by_task=by_task,
        suites_by_id=suites_by_id,
        timings=timings,
    )

    if run_oracle and scope == "none":
        scope = "changed-tasks"
    return {
        "run-benchmark-check": "true",
        "run-benchmark-oracle": str(run_oracle).lower(),
        "benchmark-oracle-scope": scope,
        "benchmark-oracle-matrix": _json(matrix if run_oracle else []),
        "benchmark-plan-reasons": _json(list(dict.fromkeys(reasons))),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--event", choices=EVENTS, default="pull_request")
    parser.add_argument("--force-full", action="store_true")
    parser.add_argument("--timings-file", type=Path)
    parser.add_argument("--base")
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args()
    paths = args.paths[1:] if args.paths[:1] == ["--"] else args.paths
    try:
        timings: dict[str, float] | None = None
        if args.timings_file is not None:
            try:
                raw_timings = json.loads(args.timings_file.read_text(encoding="utf-8"))
            except (OSError, UnicodeError, json.JSONDecodeError) as exc:
                print(
                    f"warning: ignoring invalid benchmark timings file: {exc}",
                    file=sys.stderr,
                )
            else:
                valid = isinstance(raw_timings, dict) and all(
                    isinstance(key, str)
                    and isinstance(value, (int, float))
                    and not isinstance(value, bool)
                    and value > 0
                    for key, value in raw_timings.items()
                )
                if not valid:
                    print(
                        "warning: ignoring incompatible benchmark timings file",
                        file=sys.stderr,
                    )
                else:
                    timings = {key: float(value) for key, value in raw_timings.items()}
        for key, value in plan(
            paths,
            event=args.event,
            force_full=args.force_full,
            timings=timings,
            base=args.base,
        ).items():
            print(f"{key}={value}")
    except _harbor_suite().HarborSuiteError as exc:
        parser.error(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
