      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "polynomial": {
      "additionalProperties": false,
      "properties": {
        "terms": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "coefficient": {
                "$ref": "#/$defs/rational"
              },
              "exponents": {
                "items": {
                  "maximum": 32,
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 3,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "coefficient",
              "exponents"
