{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/schemas/frontier-status-v2.json",
  "title": "Jacobian Frontier portfolio status and evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "title",
    "purpose",
    "evaluation_class",
    "scored",
    "captured_at",
    "source_suite",
    "portfolio_snapshot",
    "evaluation_portfolio_snapshot",
    "evaluation_protocol",
    "move_ledger",
    "cases",
    "capability_candidates",
    "deferred_workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "CURRENT_PORTFOLIO_STATUS_AND_PUBLIC_EVALUATION"
    },
    "evaluation_class": {
      "const": "PUBLIC_ANSWER_VISIBLE_DIAGNOSTIC"
    },
    "scored": {
      "const": false
    },
    "captured_at": {
      "type": "string",
      "format": "date"
    },
    "source_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "snapshot_semantics"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "snapshot_semantics": {
          "const": "IMMUTABLE_HISTORICAL_INPUT"
        }
      }
    },
    "portfolio_snapshot": {
      "$ref": "#/$defs/portfolioSnapshot"
    },
    "evaluation_portfolio_snapshot": {
      "$ref": "#/$defs/portfolioSnapshot"
    },
    "evaluation_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "prompt_handling",
        "source_urls_withheld",
        "capability_policy_profile",
        "retrieval_capabilities_available",
        "minimum_repetitions_for_comparison",
        "false_certification_first",
        "held_out_claims_allowed"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "prompt_handling": {
          "const": "PASS_PUBLISHED_PROMPT_UNCHANGED"
        },
        "source_urls_withheld": {
          "const": true
        },
        "capability_policy_profile": {
          "const": "COMPUTE_VERIFY_NO_RETRIEVAL"
        },
        "retrieval_capabilities_available": {
          "const": false
        },
        "minimum_repetitions_for_comparison": {
          "type": "integer",
          "minimum": 2
        },
        "false_certification_first": {
          "const": true
        },
        "held_out_claims_allowed": {
          "const": false
        }
      }
    },
    "move_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/moveLedgerEntry"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/caseStatus"
      }
    },
    "capability_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "coverage_matrix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageArea"
      }
    },
    "deferred_workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredWorkflow"
      }
    }
  },
  "$defs": {
    "moveLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "source",
        "mathematical_move",
        "required_input",
        "output_artifact",
        "trust_boundary",
        "recurrence_signal",
        "candidate_ids",
        "disposition"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "mathematical_move": {
          "type": "string",
          "minLength": 1
        },
        "required_input": {
          "type": "string",
          "minLength": 1
        },
        "output_artifact": {
          "type": "string",
          "minLength": 1
        },
        "trust_boundary": {
          "type": "string",
          "minLength": 1
        },
        "recurrence_signal": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "disposition": {
          "enum": [
            "PROMOTED",
            "SPLIT",
            "DEFERRED"
          ]
        }
      }
    },
    "portfolioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit",
        "snapshot_basis",
        "catalog_version",
        "catalog_digest",
        "capability_count",
        "policy_profile",
        "policy_digest",
        "captured_at"
      ],
      "properties": {
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "snapshot_basis": {
          "const": "PRE_MANIFEST_ENVIRONMENT_AT_REPOSITORY_COMMIT"
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capability_count": {
          "type": "integer",
          "minimum": 1
        },
        "policy_profile": {
          "enum": [
            "DEFAULT",
            "COMPUTE_VERIFY_NO_RETRIEVAL"
          ]
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "caseStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "historical_fit",
        "current_status",
        "current_capabilities",
        "repository_evidence",
        "current_boundary",
        "evaluation_status",
        "next_action"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "pattern": "^jcb-postdoc-[0-9]{3}$"
        },
        "historical_fit": {
          "enum": [
            "DIRECT",
            "PARTIAL",
            "MISSING"
          ]
        },
        "current_status": {
          "enum": [
            "COVERED",
            "PARTIAL",
            "OPEN_GAP"
          ]
        },
        "current_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "repository_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_boundary": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_status": {
          "enum": [
            "REGRESSION_COVERED",
            "RUNNABLE_PUBLIC_REPRODUCTION",
            "BLOCKED_ON_INTERVENTION"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "stage",
        "status",
        "summary",
        "evidence",
        "open_gaps",
        "next_action",
        "reproduction_assets",
        "provisional_capability_id",
        "atomic_outcome",
        "recurrence_basis",
        "nearby_portfolio",
        "provider_boundary",
        "verification_boundary",
        "public_reproduction",
        "evaluation_hypothesis",
        "evaluation_readiness",
        "primary_sources",
        "next_stage"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "stage": {
          "const": "discovery"
        },
        "status": {
          "enum": [
            "accepted",
            "needs_revision"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "reproduction_assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provisional_capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "provisional_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "atomic_outcome": {
          "type": "string",
          "minLength": 1
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "runtime_snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "assurance": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "recurrence_basis": {
          "type": "string",
          "minLength": 1
        },
        "nearby_portfolio": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "provider_boundary": {
          "type": "string",
          "minLength": 1
        },
        "verification_boundary": {
          "type": "string",
          "minLength": 1
        },
        "public_reproduction": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_readiness": {
          "enum": [
            "READY_FOR_IMPLEMENTATION",
            "BLOCKED_ON_CONTRACT_OR_PROVIDER"
          ]
        },
        "primary_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "next_stage": {
          "enum": [
            "implement-math-capability",
            "implement-math-capability-checker",
            "discover-math-capabilities"
          ]
        }
      }
    },
    "coverageArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area_id",
        "capability_prefixes",
        "installed_capability_count",
        "representative_capabilities",
        "current_support",
        "accepted_delta",
        "deferred_boundary",
        "decision"
      ],
      "properties": {
        "area_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "capability_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "installed_capability_count": {
          "type": "integer",
          "minimum": 0
        },
        "representative_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "current_support": {
          "type": "string",
          "minLength": 1
        },
        "accepted_delta": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "deferred_boundary": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "ACCEPT_FOUNDATION",
            "REVISE",
            "DEFER"
          ]
        }
      }
    },
    "deferredWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "decision",
        "reason",
        "revisit_gate"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "DEFER"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "revisit_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
