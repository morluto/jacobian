{
  "$defs": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cleared_identity_residual": {
          "maxItems": 0,
          "type": "array"
        },
        "degree": {
          "maximum": 39,
          "minimum": 11,
          "type": "integer"
        },
        "m": {
          "maximum": 20,
          "minimum": 6,
          "type": "integer"
        },
        "polynomial_terms": {
          "items": {
            "$ref": "#/$defs/term"
          },
          "maxItems": 20,
          "minItems": 6,
          "type": "array"
        },
        "quotient_degree": {
          "maximum": 38,
          "minimum": 10,
          "type": "integer"
        },
        "quotient_terms": {
          "items": {
            "$ref": "#/$defs/term"
          },
          "maxItems": 20,
          "minItems": 6,
          "type": "array"
        },
        "reverse_quotient_constant": {
          "enum": [
            -1,
            1
          ],
          "type": "integer"
        },
        "reverse_terms": {
          "items": {
            "$ref": "#/$defs/term"
          },
          "maxItems": 20,
          "minItems": 6,
          "type": "array"
        }
      },
      "required": [
        "m",
        "polynomial_terms",
        "quotient_terms",
        "reverse_terms",
        "reverse_quotient_constant",
        "degree",
        "quotient_degree",
        "cleared_identity_residual"
      ],
      "type": "object"
    },
    "term": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "maximum": 1,
          "minimum": -1,
          "type": "integer"
        },
        "exponent": {
          "maximum": 39,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "exponent",
        "coefficient"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "FAMILY_MEMBER_CERTIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/classification-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "GENERAL_CLASSIFICATION_DEGREE_ARGUMENT_TRUSTED"
      ]
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "scope": {
      "const": "SUBMITTED_MEMBER_AND_FROZEN_CLASSIFICATION_CHAIN",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/reciprocal-polynomial-classification"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
