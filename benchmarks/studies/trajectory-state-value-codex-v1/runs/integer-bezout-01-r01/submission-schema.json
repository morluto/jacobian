{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer": {
      "additionalProperties": false,
      "properties": {
        "gcd": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "left_coefficient": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "right_coefficient": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "gcd",
        "left_coefficient",
        "right_coefficient"
      ],
      "type": "object"
    },
    "task_id": {
      "const": "integer-bezout-01"
    }
  },
  "required": [
    "task_id",
    "answer"
  ],
  "type": "object"
}
