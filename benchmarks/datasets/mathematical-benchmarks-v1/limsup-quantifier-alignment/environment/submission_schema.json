{
  "$defs": {
    "model": {
      "additionalProperties": false,
      "properties": {
        "distinguishing_index": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        "intended_truth": {
          "type": "boolean"
        },
        "limsup_values": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "proposed_truth": {
          "type": "boolean"
        }
      },
      "required": [
        "limsup_values",
        "intended_truth",
        "proposed_truth",
        "distinguishing_index"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "intended_only_model": {
          "$ref": "#/$defs/model"
        },
        "proposed_only_model": {
          "$ref": "#/$defs/model"
        },
        "relationship": {
          "const": "INCOMPARABLE"
        }
      },
      "required": [
        "relationship",
        "intended_only_model",
        "proposed_only_model"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
