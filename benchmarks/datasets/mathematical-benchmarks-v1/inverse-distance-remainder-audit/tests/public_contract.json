{
    "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result.",
    "schema_definitions": {
        "rational": {
            "additionalProperties": false,
            "properties": {
                "denominator": {
                    "maximum": 1000000,
                    "minimum": 1,
                    "type": "integer"
                },
                "numerator": {
                    "maximum": 1000000,
                    "minimum": -1000000,
                    "type": "integer"
                }
            },
            "required": [
                "numerator",
                "denominator"
            ],
            "type": "object"
        }
    },
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "additionalProperties": false,
        "properties": {
            "claim_status": {
                "const": "FALSE"
            },
            "directional_witnesses": {
                "items": {
                    "additionalProperties": false,
                    "properties": {
                        "direction": {
                            "items": {
                                "$ref": "#/$defs/rational"
                            },
                            "maxItems": 4,
                            "minItems": 2,
                            "type": "array"
                        },
                        "normalized_residual_limit": {
                            "const": "quadratic_coefficient"
                        },
                        "quadratic_coefficient": {
                            "$ref": "#/$defs/rational"
                        },
                        "sign": {
                            "enum": [
                                "POSITIVE",
                                "NEGATIVE"
                            ]
                        }
                    },
                    "required": [
                        "direction",
                        "quadratic_coefficient",
                        "sign",
                        "normalized_residual_limit"
                    ],
                    "type": "object"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
            },
            "response_audit": {
                "additionalProperties": false,
                "properties": {
                    "conclusion": {
                        "const": "RIGHT_CONCLUSION_WITH_INVALID_ORDER_STEP"
                    },
                    "defects": {
                        "items": {
                            "enum": [
                                "EPSILON_SQUARED_ORDER_MISCLASSIFIED",
                                "EXPLICIT_QUADRATIC_TERM_DROPPED",
                                "CUBIC_REMAINDER_FALSE"
                            ]
                        },
                        "maxItems": 3,
                        "minItems": 2,
                        "type": "array",
                        "uniqueItems": true
                    }
                },
                "required": [
                    "conclusion",
                    "defects"
                ],
                "type": "object"
            },
            "second_order_term": {
                "additionalProperties": false,
                "properties": {
                    "denominator_power": {
                        "const": 5
                    },
                    "dot_square_coefficient": {
                        "$ref": "#/$defs/rational"
                    },
                    "norm_square_coefficient": {
                        "$ref": "#/$defs/rational"
                    },
                    "remainder": {
                        "const": "O(|y|^3/|x|^4)"
                    }
                },
                "required": [
                    "dot_square_coefficient",
                    "norm_square_coefficient",
                    "denominator_power",
                    "remainder"
                ],
                "type": "object"
            }
        },
        "required": [
            "claim_status",
            "second_order_term",
            "directional_witnesses",
            "response_audit"
        ],
        "type": "object"
    },
    "task_id": "jacobian/inverse-distance-remainder-audit"
}
