{
  "$defs": {
    "result": {
      "$ref": "#/properties/result"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "coprime_factor": {
          "const": 1
        },
        "cycle_count": {
          "minimum": 4,
          "type": "integer"
        },
        "cycle_groups": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cycle_sum": {
                "minimum": 1,
                "type": "integer"
              },
              "multiplicity": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "multiplicity",
              "cycle_sum"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 2,
          "type": "array"
        },
        "exponent": {
          "maximum": 6,
          "minimum": 2,
          "type": "integer"
        },
        "global_statement": {
          "const": "TOTAL_NOT_DIVISIBLE_BY_M"
        },
        "local_statement": {
          "const": "ALL_CYCLE_SUMS_DIVISIBLE_BY_P"
        },
        "missing_condition": {
          "const": "PRIME_POWER_MULTIPLICITIES"
        },
        "modulus": {
          "maximum": 10000,
          "minimum": 4,
          "type": "integer"
        },
        "p_valuation_modulus": {
          "minimum": 2,
          "type": "integer"
        },
        "p_valuation_total": {
          "minimum": 1,
          "type": "integer"
        },
        "prime": {
          "maximum": 29,
          "minimum": 2,
          "type": "integer"
        },
        "total_sum": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "prime",
        "exponent",
        "coprime_factor",
        "modulus",
        "cycle_count",
        "cycle_groups",
        "total_sum",
        "p_valuation_modulus",
        "p_valuation_total",
        "local_statement",
        "global_statement",
        "missing_condition"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/divisibility-audit.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
