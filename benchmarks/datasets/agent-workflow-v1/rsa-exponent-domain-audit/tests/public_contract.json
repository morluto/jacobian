    "evidence/answer.txt"
  ],
  "schema_definitions": {
    "witness": {
      "additionalProperties": false,
      "properties": {
        "C": {
          "type": "integer"
        },
        "d": {
          "minimum": 1,
          "type": "integer"
        },
        "d_p": {
          "minimum": 1,
          "type": "integer"
        },
        "left_residue": {
          "type": "integer"
        },
        "p": {
          "minimum": 3,
          "type": "integer"
        },
        "right_residue": {
          "type": "integer"
        }
      },
      "required": [
        "p",
        "d",
        "d_p",
        "C",
        "left_residue",
        "right_residue"
      ],
      "type": "object"
    }
  },
  "schema_version": "1",
