{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "result": {
            "oneOf": [
                {
                    "additionalProperties": false,
                    "properties": {
                        "status": {
                            "const": "SATISFIABLE"
                        },
                        "assignment": {
                            "additionalProperties": false,
                            "properties": {
                                "x": {
                                    "type": "boolean"
                                },
                                "y": {
                                    "type": "boolean"
                                },
                                "z": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "x",
                                "y",
                                "z"
                            ],
                            "type": "object"
                        }
                    },
                    "required": [
                        "status",
                        "assignment"
                    ],
                    "type": "object"
                },
                {
                    "additionalProperties": false,
                    "properties": {
                        "status": {
                            "const": "UNSATISFIABLE"
                        }
                    },
                    "required": [
                        "status"
                    ],
                    "type": "object"
                }
            ]
        }
    },
    "required": [
        "result"
    ],
    "type": "object"
}
