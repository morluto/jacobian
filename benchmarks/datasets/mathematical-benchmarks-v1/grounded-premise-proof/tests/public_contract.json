{
    "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result.",
    "schema_definitions": {},
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "additionalProperties": false,
        "properties": {
            "proof_steps": {
                "items": {
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "pattern": "^[a-z][a-z0-9_]{0,31}$",
                            "type": "string"
                        },
                        "inputs": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array",
                            "uniqueItems": true
                        },
                        "output": {
                            "type": "string"
                        },
                        "rule": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "rule",
                        "inputs",
                        "output"
                    ],
                    "type": "object"
                },
                "maxItems": 12,
                "minItems": 1,
                "type": "array"
            },
            "selected_premises": {
                "items": {
                    "type": "string"
                },
                "type": "array",
                "uniqueItems": true
            },
            "target_fact": {
                "type": "string"
            }
        },
        "required": [
            "selected_premises",
            "proof_steps",
            "target_fact"
        ],
        "type": "object"
    },
    "task_id": "jacobian/grounded-premise-proof"
}
