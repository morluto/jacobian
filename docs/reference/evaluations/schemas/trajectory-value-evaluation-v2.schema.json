{
  "$defs": {
    "EstimateUncertainty": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lower",
          "type": "number"
        },
        "method": {
          "const": "wilson-score-95",
          "default": "wilson-score-95",
          "title": "Method",
          "type": "string"
        },
        "success_count": {
          "minimum": 0,
          "title": "Success Count",
          "type": "integer"
        },
        "support_count": {
          "minimum": 1,
          "title": "Support Count",
          "type": "integer"
        },
        "upper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Upper",
          "type": "number"
        },
        "width": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "support_count",
        "success_count",
        "lower",
        "upper",
        "width"
      ],
      "title": "EstimateUncertainty",
      "type": "object"
    },
    "EstimatorEvaluationV2": {
      "additionalProperties": false,
      "properties": {
        "clusters": {
          "items": {
            "$ref": "#/$defs/SemanticClusterSummary"
          },
          "minItems": 1,
          "title": "Clusters",
          "type": "array"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/SemanticStateValueEstimate"
          },
          "minItems": 1,
          "title": "Estimates",
          "type": "array"
        },
        "estimator": {
          "$ref": "#/$defs/EstimatorKindV2"
        },
        "metrics": {
          "$ref": "#/$defs/EstimatorMetricsV2"
        }
      },
      "required": [
        "estimator",
        "clusters",
        "estimates",
        "metrics"
      ],
      "title": "EstimatorEvaluationV2",
      "type": "object"
    },
    "EstimatorKindV2": {
      "enum": [
        "GROUP_ROLLOUT",
        "NUMCA_NUMERICAL",
        "REASONING_TEXT",
        "JACOBIAN_TYPED_EXACT",
        "ABSTRACT_VALUE_STATE",
        "ABSTRACT_VALUE_STATE_TEXT"
      ],
      "title": "EstimatorKindV2",
      "type": "string"
    },
    "EstimatorMetricsV2": {
      "additionalProperties": false,
      "properties": {
        "brier_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brier Score",
          "type": "number"
        },
        "cluster_count": {
          "minimum": 1,
          "title": "Cluster Count",
          "type": "integer"
        },
        "cluster_observation_sizes": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Cluster Observation Sizes",
          "type": "array"
        },
        "cluster_trajectory_sizes": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Cluster Trajectory Sizes",
          "type": "array"
        },
        "mean_absolute_error": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Absolute Error",
          "type": "number"
        },
        "mean_support_count": {
          "minimum": 1.0,
          "title": "Mean Support Count",
          "type": "number"
        },
        "mean_wilson_interval_width": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Wilson Interval Width",
          "type": "number"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "support_count_max": {
          "minimum": 1,
          "title": "Support Count Max",
          "type": "integer"
        },
        "support_count_min": {
          "minimum": 1,
          "title": "Support Count Min",
          "type": "integer"
        },
        "task_group_fallback_count": {
          "minimum": 0,
          "title": "Task Group Fallback Count",
          "type": "integer"
        },
        "trajectory_count": {
          "minimum": 2,
          "title": "Trajectory Count",
          "type": "integer"
        }
      },
      "required": [
        "observation_count",
        "trajectory_count",
        "cluster_count",
        "cluster_observation_sizes",
        "cluster_trajectory_sizes",
        "task_group_fallback_count",
        "support_count_min",
        "support_count_max",
        "mean_support_count",
        "mean_wilson_interval_width",
        "brier_score",
        "mean_absolute_error"
      ],
      "title": "EstimatorMetricsV2",
      "type": "object"
    },
    "SemanticClusterSummary": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Cluster Id",
          "type": "string"
        },
        "estimator": {
          "$ref": "#/$defs/EstimatorKindV2"
        },
        "feature_summary": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Feature Summary",
          "type": "string"
        },
        "member_observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Observation Ids",
          "type": "array"
        },
        "member_trajectory_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Trajectory Ids",
          "type": "array"
        }
      },
      "required": [
        "cluster_id",
        "estimator",
        "member_observation_ids",
        "member_trajectory_ids",
        "feature_summary"
      ],
      "title": "SemanticClusterSummary",
      "type": "object"
    },
    "SemanticStateValueEstimate": {
      "additionalProperties": false,
      "properties": {
        "abstract_value_state": {
          "$ref": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-value-state-abstraction-v1.schema.json"
        },
        "abstract_value_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Abstract Value State Digest",
          "type": "string"
        },
        "assurance_authority": {
          "const": false,
          "default": false,
          "title": "Assurance Authority",
          "type": "boolean"
        },
        "boundary": {
          "$ref": "#/$defs/StateBoundary"
        },
        "cluster_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Cluster Id",
          "type": "string"
        },
        "cluster_member_observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cluster Member Observation Ids",
          "type": "array"
        },
        "estimated_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Estimated Value",
          "type": "number"
        },
        "estimator": {
          "$ref": "#/$defs/EstimatorKindV2"
        },
        "eventual_terminal_reward": {
          "enum": [
            0,
            1
          ],
          "title": "Eventual Terminal Reward",
          "type": "integer"
        },
        "exact_typed_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Typed State Digest",
          "type": "string"
        },
        "milestone_eligible": {
          "title": "Milestone Eligible",
          "type": "boolean"
        },
        "numerical_milestones": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Numerical Milestones",
          "type": "array"
        },
        "observation_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Observation Id",
          "type": "string"
        },
        "reasoning_text_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reasoning Text Digest",
          "type": "string"
        },
        "state_index": {
          "minimum": 0,
          "title": "State Index",
          "type": "integer"
        },
        "supporting_trajectory_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Trajectory Ids",
          "type": "array"
        },
        "task_group": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Task Group",
          "type": "string"
        },
        "trajectory_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Trajectory Id",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/EstimateUncertainty"
        },
        "value_source": {
          "$ref": "#/$defs/ValueSource"
        }
      },
      "required": [
        "observation_id",
        "trajectory_id",
        "task_group",
        "state_index",
        "boundary",
        "milestone_eligible",
        "estimator",
        "cluster_id",
        "estimated_value",
        "eventual_terminal_reward",
        "value_source",
        "supporting_trajectory_ids",
        "cluster_member_observation_ids",
        "exact_typed_state_digest",
        "abstract_value_state_digest",
        "abstract_value_state",
        "reasoning_text_digest",
        "uncertainty"
      ],
      "title": "SemanticStateValueEstimate",
      "type": "object"
    },
    "StateBoundary": {
      "enum": [
        "PLAN",
        "TOOL_RESULT",
        "AFTER_TOOL",
        "FINAL",
        "TERMINAL"
      ],
      "title": "StateBoundary",
      "type": "string"
    },
    "ValueEstimatorConfig": {
      "additionalProperties": false,
      "properties": {
        "config_schema_version": {
          "const": "1",
          "default": "1",
          "title": "Config Schema Version",
          "type": "string"
        },
        "linkage": {
          "const": "average",
          "default": "average",
          "title": "Linkage",
          "type": "string"
        },
        "state_selection": {
          "const": "plan-milestone-and-post-milestone-after-tool",
          "default": "plan-milestone-and-post-milestone-after-tool",
          "title": "State Selection",
          "type": "string"
        },
        "text_ngram_range": {
          "const": "word-1-2",
          "default": "word-1-2",
          "title": "Text Ngram Range",
          "type": "string"
        },
        "text_similarity_threshold_millionths": {
          "default": 350000,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Text Similarity Threshold Millionths",
          "type": "integer"
        },
        "trajectory_metric_weighting": {
          "const": "equal",
          "default": "equal",
          "title": "Trajectory Metric Weighting",
          "type": "string"
        },
        "validation": {
          "const": "leave-one-trajectory-out",
          "default": "leave-one-trajectory-out",
          "title": "Validation",
          "type": "string"
        }
      },
      "title": "ValueEstimatorConfig",
      "type": "object"
    },
    "ValueSource": {
      "enum": [
        "CLUSTER",
        "TASK_GROUP_PRIOR"
      ],
      "title": "ValueSource",
      "type": "string"
    }
  },
  "$id": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-value-evaluation-v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "assurance_authority": {
      "const": false,
      "default": false,
      "title": "Assurance Authority",
      "type": "boolean"
    },
    "comparison_schema_version": {
      "const": "2",
      "default": "2",
      "title": "Comparison Schema Version",
      "type": "string"
    },
    "corpus_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpus Digest",
      "type": "string"
    },
    "corpus_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Corpus Id",
      "type": "string"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/EstimatorEvaluationV2"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "evaluator_config": {
      "$ref": "#/$defs/ValueEstimatorConfig"
    },
    "evaluator_id": {
      "const": "jacobian.offline-trajectory-value.v2",
      "default": "jacobian.offline-trajectory-value.v2",
      "title": "Evaluator Id",
      "type": "string"
    },
    "learned_components": {
      "const": false,
      "default": false,
      "title": "Learned Components",
      "type": "boolean"
    },
    "source_corpus": {
      "$ref": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-value-corpus-v1.schema.json"
    },
    "state_roles": {
      "const": "exact-v1=replay-integrity;abstract-v1=clustering-only",
      "default": "exact-v1=replay-integrity;abstract-v1=clustering-only",
      "title": "State Roles",
      "type": "string"
    },
    "terminal_reward_semantics": {
      "const": "1=clean-room accepted;0=clean-room rejected;inconclusive=excluded",
      "default": "1=clean-room accepted;0=clean-room rejected;inconclusive=excluded",
      "title": "Terminal Reward Semantics",
      "type": "string"
    },
    "trajectory_metric_weighting": {
      "const": "equal",
      "default": "equal",
      "title": "Trajectory Metric Weighting",
      "type": "string"
    },
    "validation": {
      "const": "leave-one-trajectory-out",
      "default": "leave-one-trajectory-out",
      "title": "Validation",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "corpus_digest",
    "source_corpus",
    "evaluator_config",
    "evaluations"
  ],
  "title": "OfflineValueComparisonV2",
  "type": "object"
}
