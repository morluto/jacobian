{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "enum": [
        "PROOF_RECONSTRUCTED",
        "NO_PROOF_FOUND",
        "UNSUPPORTED"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/resolution-proof.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "const": "FROZEN_RESOLUTION_CALCULUS_ONLY"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "axioms": {
          "items": {
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "root": {
          "const": 7
        },
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "child": {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              },
              "parents": {
                "items": {
                  "maximum": 8,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "child",
              "parents"
            ],
            "type": "object"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "axioms",
        "steps",
        "root"
      ],
      "type": "object"
    },
    "scope": {
      "const": "binary first-order resolution replay over the eight frozen clauses",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/superposition-proof-replay"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
