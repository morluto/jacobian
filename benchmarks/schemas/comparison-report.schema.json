{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/comparison-report.schema.json",
  "title": "Jacobian paired public workflow comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "causal_claim_authorized", "status", "dataset", "source_sha", "snapshot_id", "conditions", "pair_count", "task_count", "family_count", "family_count_meaning", "repetitions_per_task", "metrics", "validation_failures"],
  "allOf": [{
    "if": {"properties": {"status": {"const": "VALID"}}},
    "then": {"properties": {"snapshot_id": {"type": "string"}}}
  }],
  "properties": {
    "schema_version": {"const": "3"},
    "evidence_class": {"enum": ["public-workflow-comparison", "held-out-comparison"]},
    "causal_claim_authorized": {"const": false},
    "status": {"enum": ["VALID", "INVALID"]},
    "dataset": {"type": ["string", "null"]},
    "source_sha": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "conditions": {"type": "object"},
    "pair_count": {"type": "integer", "minimum": 0},
    "task_count": {"type": "integer", "minimum": 0},
    "family_count": {"type": ["integer", "null"], "minimum": 0},
    "family_count_meaning": {"const": "declared labels, not established independent units"},
    "repetitions_per_task": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "metrics": {"type": "object", "additionalProperties": {
      "type": "object",
      "required": ["pair_count", "missing_pair_count", "weighting", "tasks", "task_average", "families", "bootstrap_95_interval", "mcnemar_exact_p", "interpretation", "inference_unavailable_reason"],
      "properties": {
        "bootstrap_95_interval": {"type": "null"},
        "mcnemar_exact_p": {"type": "null"},
        "interpretation": {"const": "descriptive-only"},
        "inference_unavailable_reason": {"type": "string", "minLength": 1}
      }
    }},
    "validation_failures": {"type": "array", "items": {"type": "string"}}
  }
}
