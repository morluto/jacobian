{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "FALSE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "p_coefficients": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "minItems": 3,
          "type": "array"
        },
        "p_roots": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "type": "array"
        },
        "q_coefficients": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "q_roots": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "type": "array"
        },
        "x1": {
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "type": "string"
        },
        "x2": {
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "p_coefficients",
        "q_coefficients",
        "p_roots",
        "q_roots",
        "x1",
        "x2"
      ],
      "type": "object"
    },
    "scope": {
      "const": "polynomial-tail-counterexample exact rational witness",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/polynomial-tail-counterexample"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
