{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "OPTIMUM_STRATEGIES_CERTIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "lower_strategy": {
          "additionalProperties": false,
          "properties": {
            "counts": {
              "additionalProperties": false,
              "properties": {
                "ben_moves_before_100th": {
                  "const": 99
                },
                "eligible": {
                  "const": 200
                }
              },
              "required": [
                "eligible",
                "ben_moves_before_100th"
              ],
              "type": "object"
            },
            "eligible_sites": {
              "items": {
                "pattern": "^(?:[1-9]|1[0-9]|20),(?:[1-9]|1[0-9]|20)$",
                "type": "string"
              },
              "maxItems": 200,
              "minItems": 200,
              "type": "array",
              "uniqueItems": true
            },
            "guaranteed_red": {
              "const": 100
            },
            "parity": {
              "enum": [
                0,
                1
              ]
            }
          },
          "required": [
            "parity",
            "eligible_sites",
            "guaranteed_red",
            "counts"
          ],
          "type": "object"
        },
        "upper_strategy": {
          "additionalProperties": false,
          "properties": {
            "cycles": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "opposite_pairs": {
                    "items": {
                      "items": {
                        "pattern": "^(?:[1-9]|1[0-9]|20),(?:[1-9]|1[0-9]|20)$",
                        "type": "string"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array",
                      "uniqueItems": true
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "sites": {
                    "items": {
                      "pattern": "^(?:[1-9]|1[0-9]|20),(?:[1-9]|1[0-9]|20)$",
                      "type": "string"
                    },
                    "maxItems": 4,
                    "minItems": 4,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "sites",
                  "opposite_pairs"
                ],
                "type": "object"
              },
              "maxItems": 100,
              "minItems": 100,
              "type": "array"
            },
            "maximum_red": {
              "const": 100
            }
          },
          "required": [
            "cycles",
            "maximum_red"
          ],
          "type": "object"
        }
      },
      "required": [
        "lower_strategy",
        "upper_strategy"
      ],
      "type": "object"
    },
    "scope": {
      "const": "20x20 board, squared-distance-5 red conflicts, alternating Amy-first play",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/knight-cycle-game-strategy"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
