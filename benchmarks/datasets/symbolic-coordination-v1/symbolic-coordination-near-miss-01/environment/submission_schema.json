          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        },
        "domain": {
          "const": "QQ"
        },
        "map_schema_version": {
          "const": "1"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        }
      },
