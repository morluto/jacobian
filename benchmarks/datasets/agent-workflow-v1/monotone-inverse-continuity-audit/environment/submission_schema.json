{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "evidence", "scope", "completeness", "claimed_assurance", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/monotone-inverse-continuity-audit"},
    "conclusion": {"const": "CONTINUITY_IS_NECESSARY"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_slope", "right_slope", "offset", "jump", "left_endpoint_value", "left_limit", "right_breakpoint_value", "right_endpoint_value", "gap_witness"],
      "properties": {
        "left_slope": {"type": "string"},
        "right_slope": {"type": "string"},
        "offset": {"type": "string"},
        "jump": {"type": "string"},
        "left_endpoint_value": {"type": "string"},
        "left_limit": {"type": "string"},
        "right_breakpoint_value": {"type": "string"},
        "right_endpoint_value": {"type": "string"},
        "gap_witness": {"type": "string"}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "scope": {"const": "DECLARED_PIECEWISE_RATIONAL_FAMILY_ON_CLOSED_INTERVAL"},
    "completeness": {"const": "COMPLETE"},
    "claimed_assurance": {"const": "COMPUTED"},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "The certificate covers only the declared piecewise rational family and does not machine-check the source Lean declaration."}}
  }
}
