{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/complex-power-sum-elimination"},
    "conclusion": {"enum": ["COMPLETE_TARGET_SET_DERIVED", "INSUFFICIENT_EVIDENCE"]},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["elimination", "branches", "achievability"],
      "properties": {
        "recurrence": {
          "type": "object", "additionalProperties": false,
          "required": ["seed", "product_polynomial", "power_sums"],
          "properties": {
            "seed": {"const": ["2", "s"]},
            "product_polynomial": {"$ref": "#/$defs/polynomial"},
            "power_sums": {
              "type": "object", "additionalProperties": false,
              "required": ["2", "3", "4", "5", "6"],
              "properties": {
                "2": {"$ref": "#/$defs/polynomial"},
                "3": {"$ref": "#/$defs/polynomial"},
                "4": {"$ref": "#/$defs/polynomial"},
                "5": {"$ref": "#/$defs/polynomial"},
                "6": {"$ref": "#/$defs/polynomial"}
              }
            }
          }
        },
        "elimination": {
          "type": "object", "additionalProperties": false,
          "required": ["sum_polynomial", "target_polynomial"],
          "properties": {
            "sum_polynomial": {"$ref": "#/$defs/polynomial"},
            "hypothesis_factorization": {"type": "string", "minLength": 1},
            "target_polynomial": {"$ref": "#/$defs/polynomial"}
          }
        },
        "branches": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sqrt17_sign", "sum", "product", "target", "denominator_norms"],
            "properties": {
              "sqrt17_sign": {"enum": [-1, 1]},
              "sum": {"$ref": "#/$defs/surd"},
              "product": {"$ref": "#/$defs/surd"},
              "target": {"$ref": "#/$defs/surd"},
              "denominator_norms": {
                "type": "object", "additionalProperties": false,
                "required": ["s", "s_minus_12", "five_s_minus_44"],
                "properties": {
                  "s": {"type": "integer"},
                  "s_minus_12": {"type": "integer"},
                  "five_s_minus_44": {"type": "integer"}
                }
              }
            }
          }
        },
        "achievability": {
          "type": "object", "additionalProperties": false,
          "required": ["construction", "quadratic", "branch_coverage"],
          "properties": {
            "construction": {"const": "TAKE_BOTH_COMPLEX_ROOTS"},
            "quadratic": {"const": "T^2-s*T+p"},
            "branch_coverage": {"const": "BOTH_AND_ONLY_BOTH"}
          }
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "polynomial": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/rational"}},
    "surd": {"type": "object", "additionalProperties": false, "required": ["rational", "sqrt17"], "properties": {"rational": {"$ref": "#/$defs/rational"}, "sqrt17": {"$ref": "#/$defs/rational"}}}
  }
}
