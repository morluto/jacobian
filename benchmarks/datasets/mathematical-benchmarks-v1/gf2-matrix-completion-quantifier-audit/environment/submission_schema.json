{
  "$defs": {
    "matrix": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 14,
      "minItems": 8,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "defects": {
          "const": [
            "BAND_SUPPORT_DOES_NOT_IMPLY_SYMMETRY",
            "EXISTENCE_OF_FULL_RANK_COMPLETION_DOES_NOT_LOWER_BOUND_MINIMUM"
          ]
        },
        "dimension": {
          "maximum": 14,
          "minimum": 8,
          "type": "integer"
        },
        "full_rank_completion": {
          "$ref": "#/$defs/matrix"
        },
        "low_rank_completion": {
          "$ref": "#/$defs/matrix"
        },
        "pattern": {
          "$ref": "#/$defs/matrix"
        }
      },
      "required": [
        "dimension",
        "defects",
        "pattern",
        "low_rank_completion",
        "full_rank_completion"
      ],
      "type": "object"
    },
    "row": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 14,
      "minItems": 8,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/matrix-completion.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
