{
    "public_notes": "Submit exactly one result for every case_id in /app/input.json. Case rows may appear in any order; each mathematical result must remain associated with its case_id. The verifier replays the task-specific mathematical predicate from the submitted result.",
    "schema_definitions": {
        "case": {
            "additionalProperties": false,
            "properties": {
                "branch": {
                    "enum": [
                        "INVERTIBLE",
                        "SINGLY_DIVISIBLE",
                        "SQUARE_DIVISIBLE"
                    ]
                },
                "case_id": {
                    "type": "string",
                    "enum": [
                        "invertible-collisions",
                        "singly-divisible",
                        "square-divisible-vacuous",
                        "square-divisible-obstructed"
                    ]
                },
                "density_denominator": {
                    "minimum": 1,
                    "type": "integer"
                },
                "density_numerator": {
                    "minimum": 0,
                    "type": "integer"
                },
                "forbidden_residues": {
                    "items": {
                        "minimum": 0,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "valid_count": {
                    "minimum": 0,
                    "type": "integer"
                }
            },
            "required": [
                "case_id",
                "branch",
                "forbidden_residues",
                "valid_count",
                "density_numerator",
                "density_denominator"
            ],
            "type": "object"
        }
    },
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "additionalProperties": false,
        "properties": {
            "cases": {
                "items": {
                    "$ref": "#/$defs/case"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array",
                "allOf": [
                    {
                        "contains": {
                            "type": "object",
                            "required": [
                                "case_id"
                            ],
                            "properties": {
                                "case_id": {
                                    "const": "invertible-collisions"
                                }
                            }
                        },
                        "minContains": 1,
                        "maxContains": 1
                    },
                    {
                        "contains": {
                            "type": "object",
                            "required": [
                                "case_id"
                            ],
                            "properties": {
                                "case_id": {
                                    "const": "singly-divisible"
                                }
                            }
                        },
                        "minContains": 1,
                        "maxContains": 1
                    },
                    {
                        "contains": {
                            "type": "object",
                            "required": [
                                "case_id"
                            ],
                            "properties": {
                                "case_id": {
                                    "const": "square-divisible-vacuous"
                                }
                            }
                        },
                        "minContains": 1,
                        "maxContains": 1
                    },
                    {
                        "contains": {
                            "type": "object",
                            "required": [
                                "case_id"
                            ],
                            "properties": {
                                "case_id": {
                                    "const": "square-divisible-obstructed"
                                }
                            }
                        },
                        "minContains": 1,
                        "maxContains": 1
                    }
                ]
            }
        },
        "required": [
            "cases"
        ],
        "type": "object"
    },
    "task_id": "jacobian/dead-end-local-density-audit"
}
