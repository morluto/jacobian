{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/divisibility-construction-witness"},
    "conclusion": {"const": "WITNESS_FOUND"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "product_mod_7", "power_difference", "quotient_by_7_pow_7"],
      "properties": {
        "a": {"type": "integer", "minimum": 1, "maximum": 1000},
        "b": {"type": "integer", "minimum": 1, "maximum": 1000},
        "product_mod_7": {"type": "integer", "minimum": 1, "maximum": 6},
        "power_difference": {"type": "integer"},
        "quotient_by_7_pow_7": {"type": "integer"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"const": "divisibility-construction-witness integers 1 through 1000"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1,"maxItems":1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
