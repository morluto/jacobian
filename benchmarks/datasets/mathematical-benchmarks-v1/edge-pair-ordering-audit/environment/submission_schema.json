{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "additionalProperties": false,
          "properties": {
            "free_edge_base": {
              "maximum": 10,
              "minimum": 2,
              "type": "integer"
            },
            "free_edge_exponent": {
              "additionalProperties": false,
              "properties": {
                "binomial_order": {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                }
              },
              "required": [
                "binomial_order",
                "offset"
              ],
              "type": "object"
            },
            "incident_vertex_offsets": {
              "items": {
                "type": "integer"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "incident_vertex_offsets",
            "free_edge_base",
            "free_edge_exponent"
          ],
          "type": "object"
        },
        "pair_semantics": {
          "enum": [
            "ORDERED",
            "UNORDERED"
          ]
        },
        "probe_values": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "coefficient": {
                "minimum": 1,
                "type": "integer"
              },
              "n": {
                "maximum": 6,
                "minimum": 3,
                "type": "integer"
              }
            },
            "required": [
              "n",
              "coefficient"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "pair_semantics",
        "formula",
        "probe_values"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
