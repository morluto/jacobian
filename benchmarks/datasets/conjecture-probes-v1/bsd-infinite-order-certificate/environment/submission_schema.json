{
  "$defs": {
    "point": {
      "items": {
        "$ref": "#/$defs/rat"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "rat": {
      "pattern": "^(?:0|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "ELLIPTIC_POINT_INFINITE_ORDER_CERTIFICATE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "ONE_AUTHORED_ELLIPTIC_CURVE",
        "LUTZ_NAGELL_TRUSTED",
        "NO_BSD_CONCLUSION"
      ]
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "A": {
          "maximum": 20,
          "minimum": -20,
          "type": "integer"
        },
        "B": {
          "maximum": 20,
          "minimum": -20,
          "type": "integer"
        },
        "discriminant": {
          "type": "integer"
        },
        "double": {
          "$ref": "#/$defs/point"
        },
        "order_conclusion": {
          "const": "INFINITE_BY_LUTZ_NAGELL"
        },
        "point": {
          "items": {
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "triple": {
          "$ref": "#/$defs/point"
        },
        "y_square": {
          "minimum": 1,
          "type": "integer"
        },
        "y_square_divides_discriminant": {
          "const": false
        }
      },
      "required": [
        "A",
        "B",
        "point",
        "discriminant",
        "y_square",
        "y_square_divides_discriminant",
        "double",
        "triple",
        "order_conclusion"
      ],
      "type": "object"
    },
    "scope": {
      "const": "integral-lutz-nagell-witness-v1",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/bsd-infinite-order-certificate"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
