{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/metric-tsp-proof-repair"},
    "conclusion": {"const": "REPAIRED"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flaw_location", "invalid_inference", "corrected_claim", "mst_edges", "euler_walk", "shortcut_tour", "optimal_tour", "weights"],
      "properties": {
        "flaw_location": {"const": "STEP_4"},
        "invalid_inference": {"const": "SHORTCUTTING_PRESERVES_EXACT_COST"},
        "corrected_claim": {"type": "string", "minLength": 1},
        "mst_edges": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"enum": ["A", "B", "C", "D", "E", "F"]}
          }
        },
        "euler_walk": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"enum": ["A", "B", "C", "D", "E", "F"]}
        },
        "shortcut_tour": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"enum": ["A", "B", "C", "D", "E", "F"]}
        },
        "optimal_tour": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"enum": ["A", "B", "C", "D", "E", "F"]}
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mst", "euler", "shortcut", "optimal"],
          "properties": {
            "mst": {"type": "integer", "minimum": 0},
            "euler": {"type": "integer", "minimum": 0},
            "shortcut": {"type": "integer", "minimum": 0},
            "optimal": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED", "CHECKED"]},
    "scope": {"const": "metric-tsp-proof-repair exact finite optimization certificate"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
