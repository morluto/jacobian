{
  "$defs": {
    "certificate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "d": {
              "items": {
                "$ref": "#/$defs/rat"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "l": {
              "$ref": "#/$defs/matrix4"
            }
          },
          "required": [
            "l",
            "d"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "leading_principal_determinants": {
              "items": {
                "$ref": "#/$defs/rat"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            }
          },
          "required": [
            "leading_principal_determinants"
          ],
          "type": "object"
        }
      ]
    },
    "matrix4": {
      "items": {
        "$ref": "#/$defs/row4"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "rat": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 1,
          "type": "integer"
        },
        "numerator": {
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "positive_definite_certificate": {
          "$ref": "#/$defs/certificate"
        },
        "proof_mode": {
          "enum": [
            "LDL",
            "SYLVESTER"
          ]
        },
        "scalar_replay": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "proof_mode",
        "scalar_replay",
        "positive_definite_certificate"
      ],
      "type": "object"
    },
    "row4": {
      "items": {
        "$ref": "#/$defs/rat"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "scalar": {
      "additionalProperties": false,
      "properties": {
        "c00_y": {
          "$ref": "#/$defs/rat"
        },
        "m00": {
          "$ref": "#/$defs/rat"
        },
        "objective": {
          "$ref": "#/$defs/rat"
        },
        "y0": {
          "$ref": "#/$defs/rat"
        }
      },
      "required": [
        "y0",
        "c00_y",
        "m00",
        "objective"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/farkas-slice-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
