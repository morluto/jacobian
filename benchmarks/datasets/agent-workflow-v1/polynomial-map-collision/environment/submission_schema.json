{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "const": "jacobian/polynomial-map-collision"
    },
    "conclusion": {
      "const": "TRUE"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_p",
        "image_q"
      ],
      "properties": {
        "image_p": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "image_q": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "claimed_assurance": {
      "enum": ["UNVERIFIED","COMPUTED","CHECKED","VERIFIED"]
    },
    "scope": {
      "const": "jacobian/polynomial-map-collision complete finite input"
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,"maxItems":1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "verification_record_uri": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "evidence/verification-record.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "if": {
    "properties": {
      "claimed_assurance": {
        "const": "VERIFIED"
      }
    }
  },
  "then": {
    "required": [
      "verification_record_uri"
    ]
  }
}
