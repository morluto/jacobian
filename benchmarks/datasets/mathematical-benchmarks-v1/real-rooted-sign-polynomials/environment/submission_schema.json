{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "all_roots_real": {
          "type": "boolean"
        },
        "coefficients": {
          "items": {
            "enum": [
              -1,
              1
            ]
          },
          "maxItems": 4,
          "minItems": 2,
          "type": "array"
        },
        "degree": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "discriminant": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "coefficients",
        "degree",
        "discriminant",
        "all_roots_real"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "candidate_audit": {
          "items": {
            "$ref": "#/$defs/case"
          },
          "maxItems": 28,
          "minItems": 28,
          "type": "array"
        },
        "classified_polynomials": {
          "items": {
            "items": {
              "enum": [
                -1,
                1
              ]
            },
            "maxItems": 4,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "maximum_degree": {
          "const": 3
        },
        "normalized_second_coefficient": {
          "const": -1
        },
        "root_product_square": {
          "const": 1
        },
        "second_power_sum": {
          "const": 3
        }
      },
      "required": [
        "normalized_second_coefficient",
        "second_power_sum",
        "root_product_square",
        "maximum_degree",
        "candidate_audit",
        "classified_polynomials"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/classification-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
