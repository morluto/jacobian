{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "SOURCE_CHAIN_RULE_REPAIRED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 10,
            "minItems": 10,
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "constraints": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 10,
            "minItems": 10,
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "dimension": {
          "const": 8
        },
        "potentials": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "terms": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "coefficient": {
                      "type": "string"
                    },
                    "x_power": {
                      "maximum": 4,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "y_power": {
                      "maximum": 4,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "coefficient",
                    "x_power",
                    "y_power"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "terms"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "rank": {
          "const": 2
        }
      },
      "required": [
        "constraints",
        "rank",
        "dimension",
        "basis",
        "potentials"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/closed-one-form-polynomial-classification"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
