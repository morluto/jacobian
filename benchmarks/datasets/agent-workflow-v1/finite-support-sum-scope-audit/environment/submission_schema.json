{
  "$defs": {
    "checkpoint": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 20,
          "minimum": 2,
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/rat"
        }
      },
      "required": [
        "n",
        "value"
      ],
      "type": "object"
    },
    "rat": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 1,
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 12,
          "minimum": 4,
          "type": "integer"
        },
        "partial_sum_lower_bound": {
          "minimum": 6,
          "type": "integer"
        },
        "ratio_bound": {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "const": 4
            },
            "numerator": {
              "const": 3
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "ratio_threshold": {
          "const": 2
        },
        "summand_values": {
          "items": {
            "$ref": "#/$defs/rat"
          },
          "maxItems": 12,
          "minItems": 6,
          "type": "array"
        },
        "tail_singletons": {
          "items": {
            "maximum": 100,
            "minimum": 5,
            "type": "integer"
          },
          "maxItems": 12,
          "minItems": 6,
          "type": "array",
          "uniqueItems": true
        },
        "truncated_checkpoints": {
          "items": {
            "$ref": "#/$defs/checkpoint"
          },
          "maxItems": 8,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "n",
        "tail_singletons",
        "summand_values",
        "partial_sum_lower_bound",
        "truncated_checkpoints",
        "ratio_threshold",
        "ratio_bound"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "ORIGINAL_SUM_DIVERGES_TRUNCATED_LIMIT_ZERO",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/scope-audit.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "ORIGINAL_SUM_TREATED_AS_NONNEGATIVE_EXTENDED_SUM",
        "TRUNCATED_LIMIT_USES_ELEMENTARY_GEOMETRIC_CONTRACTION"
      ]
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "scope": {
      "const": "ORIGINAL_DOMAIN_AUDIT_AND_TRUNCATED_REPAIR",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/finite-support-sum-scope-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
