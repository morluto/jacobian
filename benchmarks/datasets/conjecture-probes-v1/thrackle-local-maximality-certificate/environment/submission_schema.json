{
  "$defs": {
    "edge": {
      "items": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "excluded_edge_witnesses": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "disjoint_selected": {
                "$ref": "#/$defs/edge"
              },
              "excluded": {
                "$ref": "#/$defs/edge"
              }
            },
            "required": [
              "excluded",
              "disjoint_selected"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "pair_classifications": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "left": {
                "$ref": "#/$defs/edge"
              },
              "relation": {
                "enum": [
                  "SHARED_ENDPOINT",
                  "PROPER_CROSSING"
                ]
              },
              "right": {
                "$ref": "#/$defs/edge"
              }
            },
            "required": [
              "left",
              "right",
              "relation"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 10,
          "type": "array"
        },
        "selected_edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "selected_edges",
        "pair_classifications",
        "excluded_edge_witnesses"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
