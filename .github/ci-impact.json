{
  "version": 2,
  "suites": [
    "unit",
    "component",
    "domain",
    "composition",
    "storage",
    "process",
    "mcp",
    "provider",
    "e2e",
    "lean",
    "npm",
    "static",
    "build",
    "security",
    "duplicate",
    "docs"
  ],
  "rules": [
    {
      "name": "documentation",
      "patterns": [
        "docs/**",
        "*.md",
        ".github/ISSUE_TEMPLATE/**",
        ".github/CODEOWNERS"
      ],
      "suites": [
        "docs"
      ]
    },
    {
      "name": "npm-package",
      "patterns": [
        "npm/**"
      ],
      "suites": [
        "npm"
      ]
    },
    {
      "name": "lean-runtime",
      "patterns": [
        "lean/**"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "lean-python-tests",
      "patterns": [
        "tests/boundary/providers/lean/**"
      ],
      "suites": [
        "lean",
        "static"
      ]
    },
    {
      "name": "optional-provider-tests",
      "patterns": [
        "tests/boundary/providers/cvc5/**",
        "tests/boundary/providers/external_sat/**",
        "tests/boundary/providers/flint/**",
        "tests/boundary/providers/graph/**",
        "tests/boundary/providers/sympy/**"
      ],
      "suites": [
        "provider",
        "static"
      ]
    },
    {
      "name": "optional-provider-sources",
      "patterns": [
        "src/jacobian/provider_runtime.py",
        "src/jacobian/**/*provider*.py",
        "src/jacobian/cvc5*.py",
        "src/jacobian/flint*.py",
        "src/jacobian/**/*cvc5*.py",
        "src/jacobian/**/*flint*.py"
      ],
      "suites": [
        "provider"
      ]
    },
    {
      "name": "unit-tests",
      "patterns": ["tests/unit/**"],
      "suites": ["unit", "static"]
    },
    {
      "name": "component-tests",
      "patterns": ["tests/component/**"],
      "suites": ["component", "static"]
    },
    {
      "name": "domain-tests",
      "patterns": ["tests/domain/**"],
      "suites": ["domain", "static"]
    },
    {
      "name": "composition-tests",
      "patterns": ["tests/composition/**"],
      "suites": ["composition", "static"]
    },
    {
      "name": "storage-tests",
      "patterns": ["tests/boundary/storage/**"],
      "suites": ["storage", "static"]
    },
    {
      "name": "process-tests",
      "patterns": ["tests/boundary/process/**"],
      "suites": ["process", "static"]
    },
    {
      "name": "mcp-tests",
      "patterns": ["tests/boundary/mcp/**"],
      "suites": ["mcp", "static"]
    },
    {
      "name": "end-to-end-tests",
      "patterns": ["tests/e2e/**"],
      "suites": ["e2e", "static"]
    },
    {
      "name": "verification-boundary",
      "patterns": [
        "src/jacobian/runtime/**",
        "src/jacobian/installation/**",
        "src/jacobian/portfolio/**",
        "src/jacobian/providers/**",
        "src/jacobian/artifacts.py",
        "src/jacobian/checker_artifacts.py",
        "src/jacobian/registry.py",
        "src/jacobian/schema_registry.py",
        "src/jacobian/plugins/registry.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "lean-python-adapter",
      "patterns": [
        "src/jacobian/lean*.py",
        "src/jacobian/**/*lean*.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "static",
        "build"
      ]
    },
    {
      "name": "lean-shared-contracts",
      "patterns": [
        "src/jacobian/contracts/capabilities.py",
        "src/jacobian/contracts/checkers.py",
        "src/jacobian/contracts/common.py",
        "src/jacobian/contracts/evidence.py",
        "src/jacobian/contracts/plugins.py",
        "src/jacobian/contracts/results.py",
        "src/jacobian/contracts/verification.py"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "npm-facing-adapter",
      "patterns": [
        "src/jacobian/adapters/mcp/**"
      ],
      "suites": [
        "unit",
        "component",
        "mcp",
        "e2e",
        "npm",
        "static",
        "build"
      ]
    },
    {
      "name": "domain-mathematical-sources",
      "patterns": [
        "src/jacobian/domains/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "static",
        "build"
      ]
    },
    {
      "name": "python-source",
      "patterns": [
        "src/jacobian/**",
        "src/jacobian_checkers/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-automation",
      "patterns": [
        ".github/actions/**",
        ".github/workflows/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-planning-tools",
      "patterns": [
        ".github/local-test-ownership.json",
        ".github/scripts/classify-ci-paths",
        ".github/scripts/emit-plan-receipt",
        ".github/scripts/plan-local-tests",
        ".github/scripts/validate-ci-plan"
      ],
      "suites": ["unit", "process", "static", "build"]
    },
    {
      "name": "benchmark-ci-automation",
      "patterns": [
        ".github/scripts/plan-benchmarks",
        ".github/scripts/validate-benchmark-plan",
        ".github/workflows/benchmarks.yml"
      ],
      "suites": ["unit", "process", "static", "build"]
    },
    {
      "name": "ci-scripts",
      "patterns": [
        ".github/scripts/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-plan-config",
      "patterns": [
        ".github/ci-impact.json",
        ".github/ci-config.json"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "test-topology-runners",
      "patterns": [
        "tools/**",
        "tests/topology.toml"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "makefile",
      "patterns": [
        "Makefile"
      ],
      "suites": [
        "static",
        "build"
      ]
    },
    {
      "name": "python-packaging",
      "patterns": [
        "pyproject.toml",
        "uv.lock"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "pre-commit",
      "patterns": [
        ".pre-commit-config.yaml"
      ],
      "suites": [
        "static"
      ]
    },
    {
      "name": "duplicate-code-policy",
      "patterns": [
        ".jscpd.json"
      ],
      "suites": [
        "duplicate"
      ]
    },
    {
      "name": "generic-test-support",
      "patterns": [
        "tests/support/__init__.py",
        "tests/support/commands.py",
        "tests/support/domains.py",
        "tests/support/runtime_fixtures.py",
        "tests/support/services.py",
        "tests/support/state.py",
        "tests/support/artifacts.py",
        "tests/support/capabilities.py",
        "tests/support/capability_installations.py",
        "tests/support/polynomials.py",
        "tests/conftest.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "provider",
        "e2e",
        "lean",
        "static"
      ]
    },
    {
      "name": "rational-test-support",
      "patterns": [
        "tests/support/rationals.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "provider",
        "e2e",
        "static"
      ]
    },
    {
      "name": "provider-spike-isolation-support",
      "patterns": [
        "tests/support/provider_spike_isolation.py"
      ],
      "suites": [
        "composition",
        "static"
      ]
    },
    {
      "name": "lean-readiness-test-support",
      "patterns": [
        "tests/support/provider_lean.py"
      ],
      "suites": [
        "composition",
        "e2e",
        "lean",
        "static"
      ]
    },
    {
      "name": "external-sat-readiness-test-support",
      "patterns": [
        "tests/support/provider_external_sat.py"
      ],
      "suites": [
        "provider",
        "static"
      ]
    },
    {
      "name": "benchmarks",
      "patterns": [
        "benchmarks/**"
      ],
      "suites": []
    }
  ],
  "fallback": {
    "name": "unclassified-fail-closed",
    "suites": [
      "unit",
      "component",
      "domain",
      "composition",
      "storage",
      "process",
      "mcp",
      "provider",
      "e2e",
      "lean",
      "npm",
      "static",
      "build",
      "security",
      "duplicate",
      "docs"
    ]
  }
}
