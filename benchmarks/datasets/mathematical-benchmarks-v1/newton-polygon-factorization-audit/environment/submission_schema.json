{
  "$defs": {
    "integer_string": {
      "maxLength": 30,
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "OLD_LEMMA_REFUTED_WITH_REPAIR_BOUNDARY"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "ell": {
          "minimum": 2,
          "type": "integer"
        },
        "factor_left": {
          "items": {
            "$ref": "#/$defs/integer_string"
          },
          "maxItems": 10,
          "minItems": 3,
          "type": "array"
        },
        "factor_right": {
          "items": {
            "$ref": "#/$defs/integer_string"
          },
          "maxItems": 10,
          "minItems": 3,
          "type": "array"
        },
        "j": {
          "minimum": 3,
          "type": "integer"
        },
        "prime": {
          "maximum": 19,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "prime",
        "factor_left",
        "factor_right",
        "ell",
        "j"
      ],
      "type": "object"
    },
    "scope": {
      "const": "FROZEN_DVR_LEMMA_EXACT_INTEGER_WITNESS",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/newton-polygon-factorization-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
