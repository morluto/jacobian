#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
PROFILE=core
STATE_DIR="$REPO_ROOT/.jacobian"
DRY_RUN=0
DEV=0
YES=0
ALL=0
CLIENTS=()

usage() {
  sed -n '/^# Source-aware Jacobian agent bootstrap\./,/^$/s/^# \{0,1\}//p' "$0"
}

# Source-aware Jacobian agent bootstrap.
#
# Usage:
#   ./scripts/setup-agent --client codex --profile full-python [options]
#
# Profiles:
#   core            Locked base Python dependencies.
#   full-python     Base plus all maintained Python extras (Flint and cvc5).
#   lean            full-python plus the pinned Lean project build.
#   external-proof  full-python plus fail-closed checks for pinned external
#                   CaDiCaL, DRAT-trim, and Carcara executables.
#
# Options:
#   --client ID      Configure claude, cursor, opencode, codex, or gemini.
#                    Repeat the flag or pass a comma-separated list.
#   --all            Configure every supported client.
#   --profile NAME   Select a profile (default: core).
#   --state-dir PATH Use this fixed state directory (default: ./.jacobian).
#   --dev            Include the locked development dependency group.
#   --yes            Skip the client-config confirmation.
#   --dry-run        Print the sync, init, config, and doctor plan only.
#   --help           Show this help.

while (($#)); do
  case "$1" in
    --client|-c) CLIENTS+=("${2:?--client requires a value}"); shift 2 ;;
    --client=*) CLIENTS+=("${1#*=}"); shift ;;
    --all) ALL=1; shift ;;
    --profile) PROFILE="${2:?--profile requires a value}"; shift 2 ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    --state-dir) STATE_DIR="${2:?--state-dir requires a value}"; shift 2 ;;
    --state-dir=*) STATE_DIR="${1#*=}"; shift ;;
    --dev) DEV=1; shift ;;
    --yes|-y) YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

python3 "$REPO_ROOT/tools/development_profiles.py" validate --profile "$PROFILE" || exit $?
if ((!ALL && ${#CLIENTS[@]} == 0)); then
  echo "select at least one --client or use --all" >&2
  exit 2
fi
VALIDATED_CLIENTS=()
for client_group in "${CLIENTS[@]}"; do
  IFS=',' read -r -a grouped_clients <<< "$client_group"
  for client in "${grouped_clients[@]}"; do
    client="${client#"${client%%[![:space:]]*}"}"
    client="${client%"${client##*[![:space:]]}"}"
    case "$client" in
      claude|cursor|opencode|codex|gemini) VALIDATED_CLIENTS+=("$client") ;;
      *) echo "unknown MCP client: ${client:-<empty>}" >&2; exit 2 ;;
    esac
  done
done
CLIENTS=("${VALIDATED_CLIENTS[@]}")

command -v git >/dev/null || { echo "git is required" >&2; exit 2; }
command -v uv >/dev/null || { echo "uv is required: https://docs.astral.sh/uv/" >&2; exit 2; }
command -v node >/dev/null || { echo "Node.js 18 or newer is required for client configuration" >&2; exit 2; }
NODE_MAJOR=$(node -p 'Number(process.versions.node.split(".")[0])')
test "$NODE_MAJOR" -ge 18 || { echo "Node.js 18 or newer is required" >&2; exit 2; }
test "$(git -C "$REPO_ROOT" rev-parse --show-toplevel)" = "$REPO_ROOT" || {
  echo "$REPO_ROOT is not the root of a Git checkout" >&2
  exit 2
}
test -f "$REPO_ROOT/uv.lock" && test -f "$REPO_ROOT/pyproject.toml" || {
  echo "pyproject.toml and uv.lock are required" >&2
  exit 2
}
REVISION=$(git -C "$REPO_ROOT" rev-parse HEAD)
if test -n "$(git -C "$REPO_ROOT" status --porcelain)"; then
  REPO_STATE=dirty
else
  REPO_STATE=clean
fi
test "$REPO_STATE" = clean || {
  echo "source bootstrap requires a clean checkout so the recorded Git SHA identifies the running code" >&2
  exit 2
}

PINNED_UV=$(tr -d '[:space:]' < "$REPO_ROOT/.uv-version")
ACTIVE_UV=$(uv --version | awk '{print $2}')
test "$ACTIVE_UV" = "$PINNED_UV" || {
  echo "uv $PINNED_UV is required; found $ACTIVE_UV" >&2
  exit 2
}
if ((DRY_RUN)); then
  PYTHON_PATH=$(uv python find --no-python-downloads '>=3.12,<3.14') || {
    echo "dry-run requires an already installed Python 3.12 or 3.13; no download was attempted" >&2
    exit 2
  }
else
  PYTHON_PATH=$(uv python find '>=3.12,<3.14')
fi
PATH=$("$PYTHON_PATH" -c 'import os, sys; from pathlib import Path; print(os.pathsep.join(str(Path(part or ".").resolve()) for part in sys.argv[1].split(os.pathsep)))' "$PATH")
export PATH

require_checkout_path_ignored() {
  local label=$1
  local target=$2
  case "$target" in
    "$REPO_ROOT")
      echo "the repository root cannot be used as $label" >&2
      exit 2
      ;;
    "$REPO_ROOT"/*)
      if ! git -C "$REPO_ROOT" check-ignore -q -- "$target/"; then
        echo "$label inside the checkout must be ignored by Git: $target" >&2
        exit 2
      fi
      ;;
  esac
}

if test -n "${UV_PROJECT_ENVIRONMENT:-}"; then
  UV_PROJECT_ENVIRONMENT=$("$PYTHON_PATH" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$UV_PROJECT_ENVIRONMENT")
  require_checkout_path_ignored "a custom uv project environment" "$UV_PROJECT_ENVIRONMENT"
  export UV_PROJECT_ENVIRONMENT
fi
if test -n "${ELAN_HOME:-}"; then
  ELAN_HOME=$("$PYTHON_PATH" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$ELAN_HOME")
  export ELAN_HOME
fi
if test -n "${JACOBIAN_LEAN_RUNTIME:-}"; then
  JACOBIAN_LEAN_RUNTIME=$("$PYTHON_PATH" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$JACOBIAN_LEAN_RUNTIME")
  export JACOBIAN_LEAN_RUNTIME
fi
STATE_DIR=$("$PYTHON_PATH" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$STATE_DIR")
require_checkout_path_ignored "the Jacobian state directory" "$STATE_DIR"
UV_BIN=$(command -v uv)

PROFILE_SYNC_ARGS=()
SYNC_FLAG_ARGS=(sync-flags --profile "$PROFILE" --no-dev)
((DEV)) && SYNC_FLAG_ARGS=(sync-flags --profile "$PROFILE")
mapfile -t PROFILE_SYNC_ARGS < <("$PYTHON_PATH" "$REPO_ROOT/tools/development_profiles.py" "${SYNC_FLAG_ARGS[@]}")
SYNC=(uv "${PROFILE_SYNC_ARGS[@]}" --project "$REPO_ROOT" --python "$PYTHON_PATH")
PREPARE=("$PYTHON_PATH" "$REPO_ROOT/tools/development_profiles.py" prepare --profile "$PROFILE" --repo "$REPO_ROOT")
INIT=(uv run --project "$REPO_ROOT" --locked --no-sync jacobian --state-dir "$STATE_DIR" init)
CONFIG=(node "$REPO_ROOT/npm/bin/jacobian.cjs" setup --source "$REPO_ROOT" --state-dir "$STATE_DIR" --uv-bin "$UV_BIN" --profile "$PROFILE" --provider-path "$PATH")
test -z "${UV_PROJECT_ENVIRONMENT:-}" || CONFIG+=(--project-environment "$UV_PROJECT_ENVIRONMENT")
test -z "${ELAN_HOME:-}" || CONFIG+=(--elan-home "$ELAN_HOME")
test -z "${JACOBIAN_LEAN_RUNTIME:-}" || CONFIG+=(--lean-runtime "$JACOBIAN_LEAN_RUNTIME")
for client in "${CLIENTS[@]}"; do CONFIG+=(--client "$client"); done
((ALL)) && CONFIG+=(--all)
((YES)) && CONFIG+=(--yes)
((DRY_RUN)) && CONFIG+=(--dry-run)
DOCTOR=(uv run --project "$REPO_ROOT" --locked --no-sync python "$REPO_ROOT/tools/source_agent_doctor.py" --repo "$REPO_ROOT" --state-dir "$STATE_DIR" --profile "$PROFILE" --expected-revision "$REVISION" --provider-path "$PATH" --project-environment "${UV_PROJECT_ENVIRONMENT:-}" --elan-home "${ELAN_HOME:-}" --lean-runtime "${JACOBIAN_LEAN_RUNTIME:-}" --output "$STATE_DIR/bootstrap-doctor.json")

echo "Jacobian source bootstrap"
echo "  checkout: $REPO_ROOT ($REVISION, $REPO_STATE)"
echo "  Python:   $PYTHON_PATH"
echo "  uv:       $ACTIVE_UV"
echo "  profile:  $PROFILE"
echo "  state:    $STATE_DIR"
test -z "${UV_PROJECT_ENVIRONMENT:-}" || echo "  uv env:   $UV_PROJECT_ENVIRONMENT"
test -z "${ELAN_HOME:-}" || echo "  elan:     $ELAN_HOME"
test -z "${JACOBIAN_LEAN_RUNTIME:-}" || echo "  Lean dir: $JACOBIAN_LEAN_RUNTIME"

if ((DRY_RUN)); then
  printf '  sync:     '; printf '%q ' "${SYNC[@]}"; printf '\n'
  printf '  prepare:  '; printf '%q ' "${PREPARE[@]}"; printf '\n'
  printf '  init:     '; printf '%q ' "${INIT[@]}"; printf '\n'
  printf '  doctor:   '; printf '%q ' "${DOCTOR[@]}"; printf '\n'
  "${CONFIG[@]}"
  exit 0
fi

"${SYNC[@]}"
"${PREPARE[@]}"
mkdir -p -- "$STATE_DIR"
"${INIT[@]}"
"${DOCTOR[@]}"
"${CONFIG[@]}"
echo "Source-bound Jacobian MCP is ready. Restart the configured agent client."
