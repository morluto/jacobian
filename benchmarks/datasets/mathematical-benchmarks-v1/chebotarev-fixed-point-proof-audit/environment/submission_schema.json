{
  "$defs": {
    "cycle_row": {
      "additionalProperties": false,
      "properties": {
        "class_size": {
          "minimum": 1,
          "type": "integer"
        },
        "contributes": {
          "type": "boolean"
        },
        "fixed_points": {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        "partition": {
          "enum": [
            "1+1+1+1",
            "2+1+1",
            "2+2",
            "3+1",
            "4"
          ]
        }
      },
      "required": [
        "partition",
        "class_size",
        "fixed_points",
        "contributes"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "actual_discriminant": {
          "type": "integer"
        },
        "cycle_types": {
          "items": {
            "$ref": "#/$defs/cycle_row"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "defects": {
          "items": {
            "enum": [
              "MOD2_IRREDUCIBILITY_FALSE",
              "DISCRIMINANT_WRONG",
              "DOUBLE_TRANSPOSITIONS_HAVE_NO_FIXED_POINTS",
              "PUBLISHED_DENSITY_WRONG"
            ]
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "density": {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "minimum": 1,
              "type": "integer"
            },
            "numerator": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "encoded_answer": {
          "type": "integer"
        },
        "fixed_point_total": {
          "minimum": 0,
          "type": "integer"
        },
        "mod2_factor": {
          "additionalProperties": false,
          "properties": {
            "factor_coefficients": {
              "items": {
                "enum": [
                  0,
                  1
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "multiplicity": {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "factor_coefficients",
            "multiplicity"
          ],
          "type": "object"
        }
      },
      "required": [
        "mod2_factor",
        "actual_discriminant",
        "cycle_types",
        "fixed_point_total",
        "density",
        "encoded_answer",
        "defects"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/chebotarev-audit.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
