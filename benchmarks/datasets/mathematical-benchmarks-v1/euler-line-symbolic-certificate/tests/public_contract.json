          "x",
          "y"
        ],
        "type": "object"
      },
      "rational_function": {
        "additionalProperties": false,
        "properties": {
          "denominator": {
            "items": {
              "$ref": "#/$defs/term"
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array"
          },
          "numerator": {
            "items": {
              "$ref": "#/$defs/term"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "numerator",
          "denominator"
        ],
        "type": "object"
      },
      "term": {
        "additionalProperties": false,
        "properties": {
          "coefficient": {
            "type": "string"
          },
          "exponents": {
            "items": {
              "maximum": 4,
              "minimum": 0,
