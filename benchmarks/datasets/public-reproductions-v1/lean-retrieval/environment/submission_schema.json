{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "candidate_tactic": {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "items": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            "command": {
              "enum": [
                "exact"
              ],
              "type": "string"
            },
            "theorem": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "type": "string"
            }
          },
          "required": [
            "command",
            "theorem",
            "arguments"
          ],
          "type": "object"
        },
        "exhaustive": {
          "type": "boolean"
        }
      },
      "required": [
        "candidate_tactic",
        "exhaustive"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
