{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "common_gcd": {
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "type": "array"
        },
        "parameter": {
          "type": "integer"
        },
        "quotient": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "remainder_constant": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "remainder_x": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "parameter",
        "remainder_constant",
        "remainder_x",
        "common_gcd",
        "quotient"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
