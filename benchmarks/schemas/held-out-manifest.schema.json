{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/held-out-manifest.schema.json",
  "title": "Private held-out Jacobian evaluation bundle",
  "description": "Canonical v3 held-out manifest. The Harbor snapshot lock is canonical: the manifest binds the lock ID/URI/digest, archive digest, selected task IDs/digests, runtime image, Jacobian catalog/policy, Harbor/agent/model/prompt/seed/budgets/stages/condition. Plans, ledgers, and reports refer to the manifest digest instead of duplicating mutable provenance. Archive tasks must agree with the snapshot lock. No v2 compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "bundle_version", "snapshot_lock", "archive", "dataset", "tasks", "conditions", "experiment"],
  "properties": {
    "schema_version": {"const": "3"},
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "snapshot_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "lock_uri", "lock_digest"],
      "properties": {
        "lock_id": {"$ref": "#/$defs/digest", "description": "The snapshot_id from the canonical Harbor snapshot lock. Identifies the immutable benchmark snapshot this held-out dataset binds to."},
        "lock_uri": {"type": "string", "minLength": 1, "description": "Canonical URI where the snapshot lock file is stored."},
        "lock_digest": {"$ref": "#/$defs/digest", "description": "Content-addressed digest of the snapshot lock file itself."}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "pattern": "^s3://[^/]+/.+\\.tar\\.gz$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "manifest_digest", "minimum_independent_families"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"const": "dataset"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "minimum_independent_families": {"type": "integer", "minimum": 2}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "digest", "verifier_root", "verifier_tree_digest", "oracle_root", "oracle_tree_digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "family": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"},
          "verifier_root": {"type": "string", "pattern": "^dataset/[a-z0-9-]+/tests$"},
          "verifier_tree_digest": {"$ref": "#/$defs/digest"},
          "oracle_root": {"type": "string", "pattern": "^dataset/[a-z0-9-]+/solution$"},
          "oracle_tree_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"oneOf": [{"$ref": "#/$defs/control"}, {"$ref": "#/$defs/treatment"}]}
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harbor_version", "agent", "model", "prompt_path", "prompt_digest", "reasoning_effort", "randomization_seed", "max_tokens", "max_cost_usd", "stages"],
      "properties": {
        "harbor_version": {"const": "0.20.0"},
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "codex"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "model": {"type": "string", "minLength": 1},
        "prompt_path": {"type": "string", "pattern": "^prompts/[A-Za-z0-9._/-]+\\.md$"},
        "prompt_digest": {"$ref": "#/$defs/digest"},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "randomization_seed": {"type": "integer"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pilot", "decision"],
          "properties": {
            "pilot": {"$ref": "#/$defs/stage"},
            "decision": {"$ref": "#/$defs/stage"}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "jacobian_enabled"],
      "properties": {
        "id": {"const": "C1"},
        "role": {"const": "PRIMARY_CONTROL"},
        "jacobian_enabled": {"const": false}
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "jacobian_enabled", "image", "source_sha", "platform", "server_version", "policy_profile", "catalog_digest", "policy_digest"],
      "properties": {
        "id": {"const": "C2"},
        "role": {"const": "PRIMARY_TREATMENT"},
        "jacobian_enabled": {"const": true},
        "image": {"type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "platform": {"type": "string", "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"},
        "server_version": {"type": "string", "minLength": 1},
        "policy_profile": {"type": "string", "minLength": 1},
        "catalog_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_ids", "repetitions"],
      "properties": {
        "task_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
        "repetitions": {"type": "integer", "minimum": 3}
      }
    }
  }
}
