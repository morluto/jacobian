{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "CONVERGENCE_MODES_SEPARATED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "const": "NO_OPEN_PROBLEM_OR_LEAN_CLAIM"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "event_mass": {
                "type": "string"
              },
              "index_end": {
                "type": "integer"
              },
              "index_start": {
                "type": "integer"
              },
              "interval_count": {
                "type": "integer"
              },
              "level": {
                "type": "integer"
              }
            },
            "required": [
              "level",
              "interval_count",
              "event_mass",
              "index_start",
              "index_end"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "pointwise_argument": {
          "additionalProperties": false,
          "properties": {
            "hit_count_per_level": {
              "const": 1
            },
            "miss_count_per_level": {
              "const": "AT_LEAST_ONE"
            }
          },
          "required": [
            "hit_count_per_level",
            "miss_count_per_level"
          ],
          "type": "object"
        },
        "probability_argument": {
          "additionalProperties": false,
          "properties": {
            "event_mass_formula": {
              "const": "1/2^k"
            },
            "limit": {
              "const": "ZERO"
            }
          },
          "required": [
            "event_mass_formula",
            "limit"
          ],
          "type": "object"
        },
        "probes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "hit_indices": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 8,
                "minItems": 8,
                "type": "array"
              },
              "point": {
                "type": "string"
              }
            },
            "required": [
              "point",
              "hit_indices"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 3,
          "type": "array"
        },
        "relationship": {
          "const": "IN_PROBABILITY_NOT_IMPLY_ALMOST_SURE"
        },
        "research_scope": {
          "additionalProperties": false,
          "properties": {
            "lean_theorem": {
              "const": "NOT_ELABORATED"
            },
            "underlying_problem": {
              "const": "NOT_ADJUDICATED"
            }
          },
          "required": [
            "underlying_problem",
            "lean_theorem"
          ],
          "type": "object"
        }
      },
      "required": [
        "relationship",
        "levels",
        "probes",
        "probability_argument",
        "pointwise_argument",
        "research_scope"
      ],
      "type": "object"
    },
    "scope": {
      "const": "the frozen dyadic typewriter construction on [0,1)",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/convergence-mode-separation"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
