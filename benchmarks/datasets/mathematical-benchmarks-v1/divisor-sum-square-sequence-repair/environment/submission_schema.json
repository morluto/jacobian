{
  "$defs": {
    "probe": {
      "additionalProperties": false,
      "properties": {
        "a_p": {
          "minimum": 1,
          "type": "integer"
        },
        "b_p": {
          "minimum": 1,
          "type": "integer"
        },
        "prime": {
          "maximum": 97,
          "minimum": 3,
          "type": "integer"
        },
        "square_root": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "prime",
        "a_p",
        "b_p",
        "square_root"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "a_1": {
          "minimum": 1,
          "type": "integer"
        },
        "default_exponent_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "prime_formula": {
          "type": "string"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/probe"
          },
          "maxItems": 10,
          "minItems": 4,
          "type": "array"
        },
        "threshold_rule": {
          "type": "string"
        }
      },
      "required": [
        "a_1",
        "default_exponent_offset",
        "prime_formula",
        "threshold_rule",
        "probes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/sequence-construction.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
