{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "enum": [
            "INVERTIBLE",
            "SINGLY_DIVISIBLE",
            "SQUARE_DIVISIBLE"
          ]
        },
        "case_id": {
          "type": "string"
        },
        "density_denominator": {
          "minimum": 1,
          "type": "integer"
        },
        "density_numerator": {
          "minimum": 0,
          "type": "integer"
        },
        "forbidden_residues": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "valid_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "branch",
        "forbidden_residues",
        "valid_count",
        "density_numerator",
        "density_denominator"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/case"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
