{
  "$defs": {
    "LabelledTrajectory": {
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "$ref": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-state-v1.schema.json"
        },
        "task_group": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Task Group",
          "type": "string"
        },
        "trajectory_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Trajectory Id",
          "type": "string"
        }
      },
      "required": [
        "trajectory_id",
        "task_group",
        "extraction"
      ],
      "title": "LabelledTrajectory",
      "type": "object"
    },
    "ValueEstimatorConfig": {
      "additionalProperties": false,
      "properties": {
        "config_schema_version": {
          "const": "1",
          "default": "1",
          "title": "Config Schema Version",
          "type": "string"
        },
        "linkage": {
          "const": "average",
          "default": "average",
          "title": "Linkage",
          "type": "string"
        },
        "state_selection": {
          "const": "plan-milestone-and-post-milestone-after-tool",
          "default": "plan-milestone-and-post-milestone-after-tool",
          "title": "State Selection",
          "type": "string"
        },
        "text_ngram_range": {
          "const": "word-1-2",
          "default": "word-1-2",
          "title": "Text Ngram Range",
          "type": "string"
        },
        "text_similarity_threshold_millionths": {
          "default": 350000,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Text Similarity Threshold Millionths",
          "type": "integer"
        },
        "trajectory_metric_weighting": {
          "const": "equal",
          "default": "equal",
          "title": "Trajectory Metric Weighting",
          "type": "string"
        },
        "validation": {
          "const": "leave-one-trajectory-out",
          "default": "leave-one-trajectory-out",
          "title": "Validation",
          "type": "string"
        }
      },
      "title": "ValueEstimatorConfig",
      "type": "object"
    }
  },
  "$id": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-value-corpus-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Corpus Id",
      "type": "string"
    },
    "corpus_schema_version": {
      "const": "1",
      "default": "1",
      "title": "Corpus Schema Version",
      "type": "string"
    },
    "evaluator_config": {
      "$ref": "#/$defs/ValueEstimatorConfig",
      "default": {
        "config_schema_version": "1",
        "linkage": "average",
        "state_selection": "plan-milestone-and-post-milestone-after-tool",
        "text_ngram_range": "word-1-2",
        "text_similarity_threshold_millionths": 350000,
        "trajectory_metric_weighting": "equal",
        "validation": "leave-one-trajectory-out"
      }
    },
    "trajectories": {
      "items": {
        "$ref": "#/$defs/LabelledTrajectory"
      },
      "maxItems": 64,
      "minItems": 2,
      "title": "Trajectories",
      "type": "array"
    }
  },
  "required": [
    "corpus_id",
    "trajectories"
  ],
  "title": "TrajectoryValueCorpus",
  "type": "object"
}
