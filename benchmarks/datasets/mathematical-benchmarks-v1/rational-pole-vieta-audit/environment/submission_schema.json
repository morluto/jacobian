{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "FLAGGED_POLE_STEP_INVALID_REPAIRED_SUM"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "cleared_polynomial_coefficients": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 10,
          "type": "array"
        },
        "combined_numerator_coefficients": {
          "items": {
            "type": "integer"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "denominator_coefficients": {
          "items": {
            "type": "integer"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "diagnosis": {
          "const": "POLES_ARE_PLUS_MINUS_SQUARE_ROOTS_NOT_DENOMINATOR_PARAMETERS"
        },
        "pole_square_residuals": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "k": {
                "maximum": 4,
                "minimum": 1,
                "type": "integer"
              },
              "residual": {
                "type": "integer"
              }
            },
            "required": [
              "k",
              "residual"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "root_sum": {
          "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "denominator_coefficients",
        "combined_numerator_coefficients",
        "cleared_polynomial_coefficients",
        "pole_square_residuals",
        "root_sum",
        "diagnosis"
      ],
      "type": "object"
    },
    "scope": {
      "const": "rational-pole-vieta-audit exact symbolic elimination",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/rational-pole-vieta-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
