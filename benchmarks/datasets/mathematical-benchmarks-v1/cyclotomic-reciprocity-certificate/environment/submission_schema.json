{
  "$defs": {
    "coefficients": {
      "items": {
        "type": "integer"
      },
      "maxItems": 17,
      "minItems": 17,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "expanded_coefficients": {
          "$ref": "#/$defs/coefficients"
        },
        "factors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "multiplicity": {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              },
              "order": {
                "maximum": 30,
                "minimum": 2,
                "type": "integer"
              }
            },
            "required": [
              "order",
              "multiplicity"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "leading_coefficient": {
          "not": {
            "const": 0
          },
          "type": "integer"
        },
        "p_at_one": {
          "not": {
            "const": 0
          },
          "type": "integer"
        },
        "reciprocal_coefficients": {
          "$ref": "#/$defs/coefficients"
        },
        "reciprocal_scalar": {
          "const": 1
        },
        "root_orbit_conclusion": {
          "const": "INVERSION_CLOSED_WITH_EQUAL_MULTIPLICITIES"
        }
      },
      "required": [
        "leading_coefficient",
        "factors",
        "expanded_coefficients",
        "reciprocal_coefficients",
        "p_at_one",
        "reciprocal_scalar",
        "root_orbit_conclusion"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
