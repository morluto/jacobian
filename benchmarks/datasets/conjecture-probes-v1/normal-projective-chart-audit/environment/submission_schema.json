{
  "$defs": {
    "point": {
      "items": {
        "$ref": "#/$defs/q"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "q": {
      "maxLength": 128,
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "AFFINE_NORMAL_COUNT_IS_INCOMPLETE_AND_REPAIRED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "ONE_RATIONAL_ELLIPSE",
        "ONE_QUERY_POINT",
        "CONCURRENT_NORMALS_CONJECTURE_NOT_ASSESSED"
      ]
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "finite_parameters": {
          "items": {
            "$ref": "#/$defs/q"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "finite_points": {
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "footpoint_records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "ellipse_residual": {
                "$ref": "#/$defs/q"
              },
              "normal_residual": {
                "$ref": "#/$defs/q"
              },
              "point": {
                "$ref": "#/$defs/point"
              }
            },
            "required": [
              "point",
              "ellipse_residual",
              "normal_residual"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "missing_point": {
          "$ref": "#/$defs/point"
        },
        "missing_projective_parameter": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "finite_parameters",
        "finite_points",
        "missing_projective_parameter",
        "missing_point",
        "footpoint_records"
      ],
      "type": "object"
    },
    "scope": {
      "const": "ellipse-normal-projective-chart-audit-v1",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/normal-projective-chart-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
