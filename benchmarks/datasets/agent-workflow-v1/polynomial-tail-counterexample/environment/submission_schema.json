{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/polynomial-tail-counterexample"},
    "conclusion": {"const": "FALSE"},
    "result": {"type": "object", "additionalProperties": false, "required": ["p_coefficients", "q_coefficients", "p_roots", "q_roots", "x1", "x2"], "properties": {"p_coefficients": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}}, "q_coefficients": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}}, "p_roots": {"type": "array", "items": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}}, "q_roots": {"type": "array", "items": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}}, "x1": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}, "x2": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"}}},
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"const": "polynomial-tail-counterexample exact rational witness"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1,"maxItems":1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
