            "type": "object"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "terms"
      ],
      "type": "object"
    },
    "rational": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "num": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
