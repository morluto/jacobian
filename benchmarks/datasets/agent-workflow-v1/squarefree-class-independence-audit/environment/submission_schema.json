{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "FOUR_ELEMENT_INDEPENDENT_SUBSET_FORCED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "additionalProperties": false,
          "properties": {
            "class_key": {
              "const": "SQUAREFREE_KERNEL"
            },
            "independent_selection": {
              "const": "ONE_ELEMENT_PER_DISTINCT_CLASS"
            },
            "pair_count_formula": {
              "const": "SUM_OF_SQUARED_CLASS_SIZES"
            },
            "product_square_iff": {
              "const": "KERNELS_EQUAL"
            }
          },
          "required": [
            "class_key",
            "product_square_iff",
            "pair_count_formula",
            "independent_selection"
          ],
          "type": "object"
        },
        "consequence": {
          "const": "AT_LEAST_FOUR_SQUAREFREE_CLASSES"
        },
        "modular_obstruction": {
          "additionalProperties": false,
          "properties": {
            "maximum_squares_ruled_out": {
              "const": 3
            },
            "modulus": {
              "maximum": 64,
              "minimum": 2,
              "type": "integer"
            },
            "quadratic_residues": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "target_residue": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "modulus",
            "target_residue",
            "quadratic_residues",
            "maximum_squares_ruled_out"
          ],
          "type": "object"
        },
        "ordered_pair_count": {
          "const": 2023
        }
      },
      "required": [
        "ordered_pair_count",
        "classification",
        "modular_obstruction",
        "consequence"
      ],
      "type": "object"
    },
    "scope": {
      "const": "ALL_FINITE_SETS_OF_POSITIVE_INTEGERS_WITH_2023_SQUARE_PRODUCT_ORDERED_PAIRS",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/squarefree-class-independence-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
