{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "jacobian",
      "extra-files": [
        "npm/package.json",
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$..version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "README.zh-CN.md"
        }
      ]
    }
  }
}
