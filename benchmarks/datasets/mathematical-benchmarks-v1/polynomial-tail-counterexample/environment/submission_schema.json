{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "p_coefficients": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "minItems": 3,
          "type": "array"
        },
        "p_roots": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "type": "array"
        },
        "q_coefficients": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "q_roots": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "type": "array"
        },
        "x1": {
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "type": "string"
        },
        "x2": {
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "p_coefficients",
        "q_coefficients",
        "p_roots",
        "q_roots",
        "x1",
        "x2"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
