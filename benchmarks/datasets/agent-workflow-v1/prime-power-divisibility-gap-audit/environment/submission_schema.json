{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/prime-power-divisibility-gap-audit"},
    "conclusion": {"const": "PRIMEWISE_TO_MODULUS_INFERENCE_INVALID"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prime", "exponent", "coprime_factor", "modulus", "cycle_count", "cycle_groups", "total_sum", "p_valuation_modulus", "p_valuation_total", "local_statement", "global_statement", "missing_condition"],
      "properties": {
        "prime": {"type": "integer", "minimum": 2, "maximum": 29},
        "exponent": {"type": "integer", "minimum": 2, "maximum": 6},
        "coprime_factor": {"const": 1},
        "modulus": {"type": "integer", "minimum": 4, "maximum": 10000},
        "cycle_count": {"type": "integer", "minimum": 4},
        "cycle_groups": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["multiplicity", "cycle_sum"],
            "properties": {"multiplicity": {"type": "integer", "minimum": 1}, "cycle_sum": {"type": "integer", "minimum": 1}}
          }
        },
        "total_sum": {"type": "integer", "minimum": 1},
        "p_valuation_modulus": {"type": "integer", "minimum": 2},
        "p_valuation_total": {"type": "integer", "minimum": 1},
        "local_statement": {"const": "ALL_CYCLE_SUMS_DIVISIBLE_BY_P"},
        "global_statement": {"const": "TOTAL_NOT_DIVISIBLE_BY_M"},
        "missing_condition": {"const": "PRIME_POWER_MULTIPLICITIES"}
      }
    },
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "OPC_TEST_ROW_41_DIVISIBILITY_INFERENCE"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/divisibility-audit.json"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
