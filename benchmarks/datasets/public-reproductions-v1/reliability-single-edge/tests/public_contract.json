{
  "witness": {
    "allowed_paths": [
      "evidence/answer.txt"
    ],
    "max_items": 1,
    "media_types": [
      "text/plain"
    ],
    "min_items": 1
  },
  "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result and validates the declared task-specific witness.",
  "required_witness_filenames": [
    "evidence/answer.txt"
  ],
  "schema_definitions": {},
  "schema_version": "1",
  "submission_path": "/app/submission.json",
  "submission_result": {
    "additionalProperties": false,
    "properties": {
      "probability": {
        "additionalProperties": false,
        "properties": {
          "den": {
            "minimum": 1,
            "type": "integer"
          },
          "num": {
            "type": "integer"
          }
        },
        "required": [
          "num",
          "den"
        ],
        "type": "object"
      },
      "states": {
        "type": "integer"
      }
    },
    "required": [
      "probability",
      "states"
    ],
    "type": "object"
  },
  "submission_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "result": {
        "additionalProperties": false,
        "properties": {
          "probability": {
            "additionalProperties": false,
            "properties": {
          "den": {
            "minimum": 1,
            "type": "integer"
          },
          "num": {
            "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "states": {
            "type": "integer"
          }
        },
        "required": [
