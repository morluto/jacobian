{
  "$defs": {
    "matrix3": {
      "items": {
        "$ref": "#/$defs/row3"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "rational": {
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "type": "string"
    },
    "row3": {
      "items": {
        "$ref": "#/$defs/rational"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "basis_change": {
          "$ref": "#/$defs/matrix3"
        },
        "basis_change_inverse": {
          "$ref": "#/$defs/matrix3"
        },
        "channels": {
          "items": {
            "enum": [
              "A+2B",
              "A-B"
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "determinant_identity": {
          "const": "det(C)=det(A-B)^2*det(A+2B)"
        },
        "invertibility_assumption": {
          "const": "NOT_REQUIRED_FOR_POLYNOMIAL_IDENTITY"
        }
      },
      "required": [
        "basis_change",
        "basis_change_inverse",
        "channels",
        "determinant_identity",
        "invertibility_assumption"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
