{
    "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result. Return exactly five cases in the order given in /app/input.json, preserving each case's id.",
    "schema_definitions": {
        "case": {
            "additionalProperties": false,
            "properties": {
                "findings": {
                    "items": {
                        "enum": [
                            "DIVISION_BY_ZERO",
                            "INTEGER_DIVISION_TRUNCATION",
                            "NAT_SUBTRACTION_TRUNCATION"
                        ]
                    },
                    "type": "array",
                    "uniqueItems": true
                },
                "id": {
                    "type": "string"
                },
                "reason": {
                    "enum": [
                        "FULL_SCOPE_GUARD_BUT_NAT_DIVISION_MAY_TRUNCATE",
                        "LITERAL_ONE_IS_DEFINITIONALLY_ZERO_IN_CUSTOM_TYPE",
                        "ARBITRARY_LT_DOES_NOT_ESTABLISH_NONZERO",
                        "PROOF_TERMS_EXCLUDED_FROM_STATEMENT_ANALYSIS",
                        "ZERO_NUMERATOR_IS_EXACT_BUT_DIVISOR_IS_UNGUARDED"
                    ]
                }
            },
            "required": [
                "id",
                "findings",
                "reason"
            ],
            "type": "object"
        }
    },
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "additionalProperties": false,
        "properties": {
            "cases": {
                "items": false,
                "maxItems": 5,
                "minItems": 5,
                "prefixItems": [
                    {
                        "allOf": [
                            {
                                "$ref": "#/$defs/case"
                            },
                            {
                                "properties": {
                                    "id": {
                                        "const": "guard_after_binder"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "allOf": [
                            {
                                "$ref": "#/$defs/case"
                            },
                            {
                                "properties": {
                                    "id": {
                                        "const": "allzero_div_one"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "allOf": [
                            {
                                "$ref": "#/$defs/case"
                            },
                            {
                                "properties": {
                                    "id": {
                                        "const": "allzero_bad_lt_guard"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "allOf": [
                            {
                                "$ref": "#/$defs/case"
                            },
                            {
                                "properties": {
                                    "id": {
                                        "const": "proof_term_noise"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "allOf": [
                            {
                                "$ref": "#/$defs/case"
                            },
                            {
                                "properties": {
                                    "id": {
                                        "const": "zero_over_variable"
                                    }
                                }
                            }
                        ]
                    }
                ],
                "type": "array"
            }
        },
        "required": [
            "cases"
        ],
        "type": "object"
    },
    "task_id": "jacobian/lean-guard-scope-assurance"
}
