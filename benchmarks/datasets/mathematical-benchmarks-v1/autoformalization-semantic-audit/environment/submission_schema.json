{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "PROPOSED_FORMALIZATION_FAITHFUL",
        "PROPOSED_FORMALIZATION_NOT_FAITHFUL",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "defects": {
          "items": {
            "enum": [
              "MISSING_DIMENSION_PREMISE",
              "DOT_PRODUCT_REPLACED_BY_COORDINATEWISE_ZERO",
              "OTHER"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "missing_premise_certificate": {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "const": 1
            },
            "forced_y": {
              "items": {
                "type": "integer"
              },
              "maxItems": 8,
              "type": "array"
            },
            "x": {
              "items": {
                "type": "integer"
              },
              "maxItems": 8,
              "type": "array"
            }
          },
          "required": [
            "dimension",
            "x",
            "forced_y"
          ],
          "type": "object"
        },
        "operator_mismatch_certificate": {
          "additionalProperties": false,
          "properties": {
            "coordinate_products": {
              "items": {
                "type": "integer"
              },
              "maxItems": 8,
              "type": "array"
            },
            "dimension": {
              "const": 2
            },
            "dot_product": {
              "type": "integer"
            },
            "x": {
              "items": {
                "type": "integer"
              },
              "maxItems": 8,
              "type": "array"
            },
            "y": {
              "items": {
                "type": "integer"
              },
              "maxItems": 8,
              "type": "array"
            }
          },
          "required": [
            "dimension",
            "x",
            "y",
            "dot_product",
            "coordinate_products"
          ],
          "type": "object"
        },
        "semantic_status": {
          "enum": [
            "EQUIVALENT",
            "NOT_EQUIVALENT",
            "NOT_ASSESSED"
          ]
        }
      },
      "required": [
        "semantic_status",
        "defects",
        "missing_premise_certificate",
        "operator_mismatch_certificate"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/autoformalization-semantic-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
