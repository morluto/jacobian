{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "additionalProperties": true,
          "properties": {
            "x": {
              "type": "boolean"
            },
            "y": {
              "type": "boolean"
            },
            "z": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "status": {
          "enum": [
            "SATISFIABLE",
            "UNSATISFIABLE"
          ]
        }
      },
      "required": [
        "status",
        "assignment"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
