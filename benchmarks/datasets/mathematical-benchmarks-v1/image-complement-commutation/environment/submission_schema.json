{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "checked_subsets": {
                "maximum": 32,
                "minimum": 1,
                "type": "integer"
              },
              "classification": {
                "enum": [
                  "BIJECTIVE",
                  "INJECTIVE_NOT_SURJECTIVE",
                  "SURJECTIVE_NOT_INJECTIVE"
                ]
              },
              "commutes": {
                "type": "boolean"
              },
              "first_failure": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "items": {
                      "maximum": 4,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array",
                    "uniqueItems": true
                  }
                ]
              },
              "id": {
                "type": "string"
              },
              "left_image": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "items": {
                      "maximum": 4,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array",
                    "uniqueItems": true
                  }
                ]
              },
              "right_complement": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "items": {
                      "maximum": 4,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array",
                    "uniqueItems": true
                  }
                ]
              }
            },
            "required": [
              "id",
              "classification",
              "commutes",
              "checked_subsets",
              "first_failure",
              "left_image",
              "right_complement"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/image-complement-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
