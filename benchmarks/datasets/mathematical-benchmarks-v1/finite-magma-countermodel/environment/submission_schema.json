{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "minimality_checked_orders": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "order": {
          "minimum": 1,
          "type": "integer"
        },
        "premise_holds_universally": {
          "const": true
        },
        "refuting_assignment": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        },
        "table": {
          "items": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "target_holds_universally": {
          "const": false
        }
      },
      "required": [
        "order",
        "table",
        "refuting_assignment",
        "premise_holds_universally",
        "target_holds_universally",
        "minimality_checked_orders"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
