{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["task_id","conclusion","result","claimed_assurance","scope","completeness","evidence","limitations"],
  "properties":{
    "task_id":{"const":"jacobian/periodic-orbit-polynomial-obstruction"},
    "conclusion":{"enum":["NONCONSTANT_POLYNOMIAL_IMPOSSIBLE","INSUFFICIENT_EVIDENCE"]},
    "result":{"type":"object","additionalProperties":false,"required":["orbit_basis","exact_period_coefficients","orbit_divisibility","modular_reductions","infinite_prime_step","polynomial_identity_step"],"properties":{
      "orbit_basis":{"const":["F(pq)","F(p)","F(q)","F(1)"]},
      "exact_period_coefficients":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer"}},
      "orbit_divisibility":{"const":"pq_DIVIDES_F(pq)-F(p)-F(q)+F(1)"},
      "modular_reductions":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["modulus","residue_basis","residue_coefficients","conclusion"],"properties":{
        "modulus":{"enum":["p","q"]},"residue_basis":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},"residue_coefficients":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer"}},"conclusion":{"enum":["p_DIVIDES_P(q)-P(1)","q_DIVIDES_P(p)-P(1)"]}
      }}},
      "infinite_prime_step":{"enum":["FOR_EACH_PRIME_q_ALL_OTHER_PRIMES_p_DIVIDE_P(q)-P(1)_SO_P(q)=P(1)","FOR_EACH_PRIME_p_ALL_OTHER_PRIMES_q_DIVIDE_P(p)-P(1)_SO_P(p)=P(1)","ALL_PRIMES_DIVIDE_P(1)_SO_P_IS_CONSTANT","INFINITE_PRIMES_GIVE_DISTINCT_VALUES_OF_P"]},
      "polynomial_identity_step":{"enum":["P_EQUALS_CONSTANT_P(1)_ON_INFINITELY_MANY_PRIMES","P_EQUALS_CONSTANT_P(0)_ON_INFINITELY_MANY_PRIMES","P_IS_NONCONSTANT_ON_INFINITELY_MANY_PRIMES","P_EQUALS_IDENTITY_ON_ALL_PRIMES"]}
    }},
    "claimed_assurance":{"enum":["UNVERIFIED","COMPUTED","CHECKED","VERIFIED"]},
    "scope":{"const":"ALL_FUNCTIONS_Z_TO_Z_WITH_FINITE_ITERATE_FIXED_POINT_COUNTS_AND_ALL_P_IN_Z[x]"},
    "completeness":{"enum":["COMPLETE","PARTIAL","UNKNOWN"]},
    "evidence":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"const":"evidence/periodic-orbit-certificate.json"},"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}},
    "limitations":{"const":["STANDARD_ORBIT_DIVISIBILITY_AND_INFINITE_PRIME_LEMMAS_TRUSTED"]}
  }
}
