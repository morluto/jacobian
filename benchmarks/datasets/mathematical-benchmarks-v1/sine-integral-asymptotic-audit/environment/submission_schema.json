{
  "$defs": {
    "remainder": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "type": "integer"
        },
        "integrand": {
          "enum": [
            "SIN",
            "COS"
          ]
        },
        "power": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "integrand",
        "power",
        "coefficient"
      ],
      "type": "object"
    },
    "term": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "type": "integer"
        },
        "function": {
          "enum": [
            "SIN",
            "COS"
          ]
        },
        "power": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "function",
        "power",
        "coefficient"
      ],
      "type": "object"
    },
    "terms": {
      "items": {
        "$ref": "#/$defs/term"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "absolute_remainder_bound": {
          "additionalProperties": false,
          "properties": {
            "domain": {
              "const": "x>0"
            },
            "numerator": {
              "type": "integer"
            },
            "power": {
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "power",
            "domain"
          ],
          "type": "object"
        },
        "corrected_sine_coefficient": {
          "type": "integer"
        },
        "published_sine_coefficient": {
          "type": "integer"
        },
        "si_remainder": {
          "$ref": "#/$defs/remainder"
        },
        "si_terms": {
          "$ref": "#/$defs/terms"
        },
        "tail_remainder": {
          "$ref": "#/$defs/remainder"
        },
        "tail_terms": {
          "$ref": "#/$defs/terms"
        }
      },
      "required": [
        "tail_terms",
        "tail_remainder",
        "si_terms",
        "si_remainder",
        "absolute_remainder_bound",
        "published_sine_coefficient",
        "corrected_sine_coefficient"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
