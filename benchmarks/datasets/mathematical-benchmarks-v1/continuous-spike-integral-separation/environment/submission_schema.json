{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "maxLength": 100,
          "type": "string"
        },
        "baseline_power": {
          "const": 2
        },
        "integral_classification": {
          "const": {
            "spike_area_series": "alpha*sum(1/n)",
            "status": "DIVERGENT"
          }
        },
        "sample_series_classification": {
          "const": {
            "sample_series": "sum(1/n^2)",
            "status": "CONVERGENT"
          }
        },
        "spike_height": {
          "const": "1"
        },
        "spikes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "area": {
                "maxLength": 100,
                "type": "string"
              },
              "center": {
                "maxLength": 100,
                "type": "string"
              },
              "half_width": {
                "maxLength": 100,
                "type": "string"
              },
              "integer_sample": {
                "maxLength": 100,
                "type": "string"
              },
              "left": {
                "maxLength": 100,
                "type": "string"
              },
              "n": {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              "right": {
                "maxLength": 100,
                "type": "string"
              }
            },
            "required": [
              "n",
              "center",
              "half_width",
              "left",
              "right",
              "area",
              "integer_sample"
            ],
            "type": "object"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        }
      },
      "required": [
        "alpha",
        "baseline_power",
        "spike_height",
        "spikes",
        "integral_classification",
        "sample_series_classification"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
