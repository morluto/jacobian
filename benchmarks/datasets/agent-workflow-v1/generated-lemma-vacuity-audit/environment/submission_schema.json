{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/generated-lemma-vacuity-audit"},
    "conclusion": {"enum": ["BOTH_LEMMAS_NON_PROGRESSING", "LEMMAS_PROGRESSING", "INSUFFICIENT_EVIDENCE"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["square_bound_audit", "common_divisor_audit", "source_theorem_status"],
      "properties": {
        "square_bound_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defect", "vacuity_witness", "corrected_contract_ast", "nonvacuous_check"],
          "properties": {
            "defect": {"enum": ["EXISTENTIAL_IMPLICATION_VACUITY", "NONE"]},
            "vacuity_witness": {"$ref": "#/$defs/squareWitness"},
            "corrected_contract_ast": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quantifier", "variable", "body"],
              "properties": {
                "quantifier": {"enum": ["FORALL", "EXISTS"]},
                "variable": {"const": "k"},
                "body": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operator", "antecedent", "consequent"],
                  "properties": {
                    "operator": {"enum": ["IMPLIES", "AND"]},
                    "antecedent": {"const": "a_plus_b_equals_k_squared"},
                    "consequent": {"const": "k_between_declared_bounds"}
                  }
                }
              }
            },
            "nonvacuous_check": {"$ref": "#/$defs/squareWitness"}
          }
        },
        "common_divisor_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defect", "a", "b", "d", "dividends", "original_premise_holds"],
          "properties": {
            "defect": {"enum": ["TRIVIAL_EXISTENTIAL_WITNESS", "NONE"]},
            "a": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "b": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "d": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "dividends": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer"}
            },
            "original_premise_holds": {"type": "boolean"}
          }
        },
        "source_theorem_status": {"const": "NOT_ASSESSED"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/answer.txt"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "squareWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "k", "antecedent_holds", "frozen_formula_holds", "bounds_hold"],
      "properties": {
        "a": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "b": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "k": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "antecedent_holds": {"type": "boolean"},
        "frozen_formula_holds": {"type": "boolean"},
        "bounds_hold": {"type": "boolean"}
      }
    }
  }
}
