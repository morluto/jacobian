{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "proof_steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                "type": "string"
              },
              "inputs": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "output": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "rule",
              "inputs",
              "output"
            ],
            "type": "object"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "selected_premises": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "target_fact": {
          "type": "string"
        }
      },
      "required": [
        "selected_premises",
        "proof_steps",
        "target_fact"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
