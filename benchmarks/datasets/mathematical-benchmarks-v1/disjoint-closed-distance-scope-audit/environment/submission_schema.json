        "horizontal_step": {
          "maximum": 20,
          "minimum": 2,
          "type": "integer"
        },
        "offset": {
          "maximum": 20,
          "minimum": 2,
          "type": "integer"
        },
        "sample_indices": {
          "items": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "separation_certificate": {
          "$ref": "#/$defs/separation"
