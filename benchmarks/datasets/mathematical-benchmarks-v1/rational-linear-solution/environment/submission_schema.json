{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "solution": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
              "type": "string"
            },
            "y": {
              "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        }
      },
      "required": [
        "solution"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
