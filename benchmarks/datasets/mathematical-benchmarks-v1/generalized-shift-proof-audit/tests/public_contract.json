{
    "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result.",
    "schema_definitions": {
        "rat": {
            "additionalProperties": false,
            "properties": {
                "denominator": {
                    "minimum": 1,
                    "type": "integer"
                },
                "numerator": {
                    "type": "integer"
                }
            },
            "required": [
                "numerator",
                "denominator"
            ],
            "type": "object"
        },
        "result": {
            "additionalProperties": false,
            "properties": {
                "collision": {
                    "additionalProperties": false,
                    "properties": {
                        "alpha_first": {
                            "maximum": 20,
                            "minimum": -20,
                            "type": "integer"
                        },
                        "alpha_second": {
                            "maximum": 20,
                            "minimum": -20,
                            "type": "integer"
                        },
                        "first_index": {
                            "maximum": 20,
                            "minimum": -20,
                            "type": "integer"
                        },
                        "second_index": {
                            "maximum": 20,
                            "minimum": -20,
                            "type": "integer"
                        }
                    },
                    "required": [
                        "first_index",
                        "second_index",
                        "alpha_first",
                        "alpha_second"
                    ],
                    "type": "object"
                },
                "fourier_block": {
                    "additionalProperties": false,
                    "properties": {
                        "operator_norm_squared": {
                            "$ref": "#/$defs/rat"
                        },
                        "size": {
                            "maximum": 15,
                            "minimum": 3,
                            "type": "integer"
                        }
                    },
                    "required": [
                        "size",
                        "operator_norm_squared"
                    ],
                    "type": "object"
                },
                "norm_direction": {
                    "additionalProperties": false,
                    "properties": {
                        "diagonal_entries": {
                            "items": {
                                "$ref": "#/$defs/rat"
                            },
                            "maxItems": 8,
                            "minItems": 2,
                            "type": "array"
                        },
                        "hilbert_schmidt_norm_squared": {
                            "$ref": "#/$defs/rat"
                        },
                        "operator_norm_squared": {
                            "$ref": "#/$defs/rat"
                        },
                        "valid_relation": {
                            "const": "OPERATOR_NORM_LE_HILBERT_SCHMIDT_NORM"
                        }
                    },
                    "required": [
                        "valid_relation",
                        "diagonal_entries",
                        "operator_norm_squared",
                        "hilbert_schmidt_norm_squared"
                    ],
                    "type": "object"
                },
                "radical_domain": {
                    "additionalProperties": false,
                    "properties": {
                        "m": {
                            "maximum": 100,
                            "minimum": 2,
                            "type": "integer"
                        },
                        "radicand": {
                            "type": "integer"
                        },
                        "real_status": {
                            "const": "NOT_REAL"
                        }
                    },
                    "required": [
                        "m",
                        "radicand",
                        "real_status"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "collision",
                "fourier_block",
                "norm_direction",
                "radical_domain"
            ],
            "type": "object"
        }
    },
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "$ref": "#/$defs/result"
    },
    "task_id": "jacobian/generalized-shift-proof-audit"
}
