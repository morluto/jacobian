{
  "allowed_assurance": [
    "UNVERIFIED",
    "COMPUTED"
  ],
  "allowed_completeness": [
    "COMPLETE"
  ],
  "assurance_ceiling": "COMPUTED",
  "conclusion": {
    "const": "REPLACE_CONCLUSION"
  },
  "evidence": {
    "allowed_paths": [
      "evidence/answer.txt"
    ],
    "digest_pattern": "^sha256:[0-9a-f]{64}$",
    "max_items": 1,
    "media_types": [
      "text/plain"
    ],
    "min_items": 1,
    "payload_shape": null
  },
  "limitations": {
    "items": {
      "type": "string"
    },
    "type": "array"
  },
  "public_notes": "Replace this note with the complete public submission protocol.",
  "required_artifact_filenames": [
    "evidence/answer.txt"
  ],
  "schema_definitions": {},
  "schema_version": "1",
  "scope": {
    "const": "REPLACE_SCOPE",
    "type": "string"
  },
  "submission_path": "/app/submission.json",
  "submission_result": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  },
  "submission_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "claimed_assurance": {
        "enum": [
          "UNVERIFIED",
          "COMPUTED",
          "CHECKED",
          "VERIFIED"
        ]
      },
      "completeness": {
        "const": "COMPLETE"
      },
      "conclusion": {
        "const": "REPLACE_CONCLUSION"
      },
      "evidence": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "evidence/answer.txt"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "maxItems": 1,
        "minItems": 1,
        "type": "array"
      },
      "limitations": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "result": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "scope": {
        "const": "REPLACE_SCOPE",
        "type": "string"
      },
      "task_id": {
        "const": "jacobian/replace-task-id"
      }
    },
    "required": [
      "task_id",
      "conclusion",
      "result",
      "claimed_assurance",
      "scope",
      "completeness",
      "evidence",
      "limitations"
    ],
    "type": "object"
  },
  "task_id": "jacobian/replace-task-id",
  "verification_record": null
}
