{
  "$defs": {
    "balances": {
      "items": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "flow": {
      "items": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 15,
      "minItems": 15,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "flawed_balances": {
          "$ref": "#/$defs/balances"
        },
        "flawed_flow": {
          "$ref": "#/$defs/flow"
        },
        "repair_balances": {
          "$ref": "#/$defs/balances"
        },
        "repair_flow": {
          "$ref": "#/$defs/flow"
        },
        "zero_edge_index": {
          "maximum": 14,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "flawed_flow",
        "flawed_balances",
        "zero_edge_index",
        "repair_flow",
        "repair_balances"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
