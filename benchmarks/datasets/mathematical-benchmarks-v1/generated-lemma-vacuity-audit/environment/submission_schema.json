        },
        "antecedent_holds": {
          "type": "boolean"
        },
        "b": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "bounds_hold": {
          "type": "boolean"
        },
        "frozen_formula_holds": {
          "type": "boolean"
        },
        "k": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
