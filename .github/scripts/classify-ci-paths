#!/usr/bin/env python3
"""Map changed repository paths to suites using the CI impact manifest."""

from __future__ import annotations

import argparse
import json
import os
import sys
import tomllib
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
MANIFEST = ROOT / ".github" / "ci-impact.json"
TOPOLOGY = ROOT / "tests" / "topology.toml"

# The planner scripts live without a package context; make the sibling helper
# importable both when run as a subprocess and when loaded in-process by tests.
_SCRIPTS_DIR = str(Path(__file__).resolve().parent)
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)
from _ci_paths import normalize_paths, path_values  # noqa: E402

# More-specific ownership rules suppress the general python-source catch-all
# when both match the same path (fnmatch '*' crosses '/').
_SUPPRESSED_WHEN_PRESENT = {
    "domain-mathematical-sources": frozenset({"python-source"}),
    "npm-facing-adapter": frozenset({"python-source"}),
    "ci-planning-tools": frozenset({"ci-scripts"}),
    "benchmark-ci-automation": frozenset({"ci-scripts", "ci-automation"}),
    "topology-runner-tool": frozenset({"test-topology-runners"}),
    "documentation-command-tool": frozenset({"test-topology-runners"}),
    "benchmark-static-tool": frozenset({"test-topology-runners"}),
}


def load_manifest() -> dict[str, Any]:
    with MANIFEST.open(encoding="utf-8") as handle:
        return json.load(handle)


def _provider_options(manifest: dict[str, Any]) -> set[str]:
    catalog = manifest.get("catalog", {})
    provider = catalog.get("provider", {}) if isinstance(catalog, dict) else {}
    options = provider.get("providers", []) if isinstance(provider, dict) else []
    if not isinstance(options, list) or not all(
        isinstance(option, str) and option for option in options
    ):
        raise ValueError("provider catalog must contain non-empty provider names")
    return set(options)


def _provider_selection(values: list[str], manifest: dict[str, Any]) -> list[str]:
    selected: list[str] = []
    for value in values:
        selected.extend(part for part in value.split(",") if part)
    selected = list(dict.fromkeys(selected))
    unknown = sorted(set(selected) - _provider_options(manifest))
    if unknown:
        raise ValueError(f"unknown provider selection: {', '.join(unknown)}")
    return sorted(selected)


def suites_for_path(path: str, manifest: dict[str, Any]) -> set[str]:
    matching_rules: list[dict[str, Any]] = []
    for rule in manifest["rules"]:
        if any(fnmatchcase(path, pattern) for pattern in rule["patterns"]):
            matching_rules.append(rule)
    if matching_rules:
        matched_names = {str(rule["name"]) for rule in matching_rules}
        suppressed: set[str] = set()
        for specific, generals in _SUPPRESSED_WHEN_PRESENT.items():
            if specific in matched_names:
                suppressed.update(generals)
        return {
            str(suite)
            for rule in matching_rules
            if str(rule["name"]) not in suppressed
            for suite in rule["suites"]
        }
    fallback = manifest["fallback"]
    return set(fallback["suites"])


def deployment_for_path(path: str, manifest: dict[str, Any]) -> bool:
    """Return whether a path owns the explicit deployment validation gate."""

    return any(
        str(rule.get("name")) == "deployment"
        and any(fnmatchcase(path, pattern) for pattern in rule["patterns"])
        for rule in manifest["rules"]
    )


def deferred_pull_request_lanes() -> set[str]:
    data = tomllib.loads(TOPOLOGY.read_text(encoding="utf-8"))
    return {
        str(lane["name"])
        for lane in data["lanes"]
        if lane["ci"]["pull_request"] is False
    }


def classify(
    paths: list[str],
    *,
    exhaustive: bool,
    force_lean: bool,
    provider_selection: list[str] | None = None,
    include_provider: bool = False,
) -> dict[str, str]:
    manifest = load_manifest()
    provider_selection = _provider_selection(provider_selection or [], manifest)
    exhaustive = exhaustive or not paths
    all_suites = set(manifest["suites"])
    code_suites = all_suites - {"docs"}
    suites: set[str] = set()

    if exhaustive or not paths:
        suites = all_suites
    else:
        for path in paths:
            suites.update(suites_for_path(path, manifest))

    if not exhaustive:
        suites.difference_update(deferred_pull_request_lanes())

    # Optional providers remain deferred for ordinary pull requests.  An
    # explicit selection is additive and is the caller's authorization to run
    # that lane; it never removes another selected suite.
    if include_provider or provider_selection:
        suites.add("provider")

    if force_lean:
        suites.add("lean")

    run_deploy = exhaustive or any(
        deployment_for_path(path, manifest) for path in paths
    )

    python_lanes = (
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "provider",
        "e2e",
    )
    selected_python_lanes = tuple(lane for lane in python_lanes if lane in suites)
    if exhaustive:
        classification = "exhaustive"
    elif suites == {"docs"}:
        classification = "docs"
    elif suites in (code_suites, all_suites):
        classification = "full"
    elif not suites:
        classification = "none"
    elif suites == {"npm"}:
        classification = "npm"
    elif suites == {"lean"}:
        classification = "lean"
    elif suites <= {*python_lanes, "static"} and selected_python_lanes:
        classification = "python"
    else:
        classification = "selective"

    semantic_lanes = {f"run-{lane}": lane in suites for lane in python_lanes}
    matrix_lanes = (
        "component",
        "storage",
        "mcp",
        "provider",
        "e2e",
    )
    selected_matrix_lanes = [lane for lane in matrix_lanes if lane in suites]
    plan: dict[str, str] = {
        "classification": classification,
        "provider-selection": json.dumps(provider_selection, separators=(",", ":")),
        "run-deploy": str(run_deploy).lower(),
        "run-python": str(bool(selected_python_lanes)).lower(),
        "product-lane-matrix": json.dumps(
            {"include": [{"lane": lane} for lane in selected_matrix_lanes]},
            separators=(",", ":"),
        ),
        **{key: str(value).lower() for key, value in semantic_lanes.items()},
        "run-coverage": str(exhaustive and set(python_lanes) <= suites).lower(),
        "run-compatibility": str(exhaustive and set(python_lanes) <= suites).lower(),
    }
    for suite in (
        "lean",
        "provider",
        "npm",
        "static",
        "build",
        "security",
        "duplicate",
        "docs",
    ):
        plan[f"run-{suite}"] = str(suite in suites).lower()
    return plan


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--force-full",
        "--force-exhaustive",
        dest="exhaustive",
        action="store_true",
        help="Run every configured lane, including coverage and compatibility.",
    )
    parser.add_argument("--force-lean", action="store_true")
    parser.add_argument(
        "--include-provider",
        action="store_true",
        help="Opt in to the deferred optional-provider lane.",
    )
    parser.add_argument(
        "--provider",
        "--providers",
        action="append",
        default=[],
        help="Add an optional provider (repeatable or comma-separated).",
    )
    parser.add_argument("--paths", nargs="+", action="append", dest="path_groups")
    parser.add_argument("--paths-file", type=Path)
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args()
    paths = list(args.paths)
    if paths[:1] == ["--"]:
        paths = paths[1:]
    if args.path_groups:
        paths = [path for group in args.path_groups for path in group] + paths
    elif args.paths_file is not None:
        try:
            paths = path_values(args.paths_file.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            parser.error(str(exc))
    elif not paths and "PATHS" in os.environ:
        try:
            paths = path_values(os.environ["PATHS"])
        except ValueError as exc:
            parser.error(str(exc))
    try:
        paths = normalize_paths(paths)
        plan = classify(
            paths,
            exhaustive=args.exhaustive,
            force_lean=args.force_lean,
            provider_selection=args.provider,
            include_provider=args.include_provider,
        )
    except ValueError as exc:
        parser.error(str(exc))
    for key, value in plan.items():
        print(f"{key}={value}")


if __name__ == "__main__":
    main()
