{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "findings": {
                "items": {
                  "enum": [
                    "DIVISION_BY_ZERO",
                    "INTEGER_DIVISION_TRUNCATION",
                    "NAT_SUBTRACTION_TRUNCATION"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "type": "string"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "findings",
              "reason"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
