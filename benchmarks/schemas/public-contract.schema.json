{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/public-contract.schema.json",
  "title": "Jacobian public task contract",
  "description": "Canonical agent-visible result-and-witness protocol for one Harbor benchmark task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "submission_path",
    "public_notes",
    "submission_result"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^jacobian/[a-z0-9-]+$"
    },
    "submission_path": {
      "type": "string",
      "pattern": "^/app/[a-z0-9._/-]+$"
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_items",
        "max_items",
        "allowed_paths",
        "media_types"
      ],
      "properties": {
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest_pattern": {
          "type": "string"
        },
        "media_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload_shape": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "required_witness_filenames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_notes": {
      "type": "string",
      "minLength": 1
    },
    "submission_result": {
      "type": "object"
    },
    "schema_definitions": {
      "type": "object"
    }
  }
}
