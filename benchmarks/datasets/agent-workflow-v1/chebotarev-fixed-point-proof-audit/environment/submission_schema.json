{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "task_id",
        "conclusion",
        "result",
        "claimed_assurance",
        "scope",
        "completeness",
        "evidence",
        "limitations"
    ],
    "properties": {
        "task_id": {
            "const": "jacobian/chebotarev-fixed-point-proof-audit"
        },
        "conclusion": {
            "enum": [
                "PUBLISHED_SOLUTION_CONTAINS_MULTIPLE_FATAL_ERRORS",
                "PUBLISHED_SOLUTION_CORRECT",
                "INSUFFICIENT_EVIDENCE"
            ]
        },
        "result": {
            "$ref": "#/$defs/result"
        },
        "claimed_assurance": {
            "enum": [
                "UNVERIFIED",
                "COMPUTED"
            ]
        },
        "scope": {
            "const": "CONDITIONAL_ON_FROZEN_S4_PREMISE"
        },
        "completeness": {
            "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNKNOWN"
            ]
        },
        "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "sha256"
                ],
                "properties": {
                    "path": {
                        "const": "evidence/chebotarev-audit.json"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                },
                "description": "Digest-bound descriptor for evidence/chebotarev-audit.json, which must be a JSON object matching #/$defs/evidence_envelope and must not exceed 16 MiB"
            }
        },
        "limitations": {
            "const": [
                "S4_CLASSIFICATION_NOT_REPROVED",
                "CHEBOTAREV_THEOREM_TRUSTED"
            ]
        }
    },
    "$defs": {
        "cycle_row": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "partition",
                "class_size",
                "fixed_points",
                "contributes"
            ],
            "properties": {
                "partition": {
                    "enum": [
                        "1+1+1+1",
                        "2+1+1",
                        "2+2",
                        "3+1",
                        "4"
                    ]
                },
                "class_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "fixed_points": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                },
                "contributes": {
                    "type": "boolean"
                }
            }
        },
        "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mod2_factor",
                "actual_discriminant",
                "cycle_types",
                "fixed_point_total",
                "density",
                "encoded_answer",
                "defects"
            ],
            "properties": {
                "mod2_factor": {
                    "type": "string"
                },
                "actual_discriminant": {
                    "type": "integer"
                },
                "cycle_types": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "items": {
                        "$ref": "#/$defs/cycle_row"
                    }
                },
                "fixed_point_total": {
                    "type": "integer",
                    "minimum": 0
                },
                "density": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "numerator",
                        "denominator"
                    ],
                    "properties": {
                        "numerator": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "denominator": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                },
                "encoded_answer": {
                    "type": "integer"
                },
                "defects": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "MOD2_IRREDUCIBILITY_FALSE",
                            "DISCRIMINANT_WRONG",
                            "DOUBLE_TRANSPOSITIONS_HAVE_NO_FIXED_POINTS",
                            "PUBLISHED_DENSITY_WRONG"
                        ]
                    }
                }
            }
        },
        "evidence_envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "task_id",
                "result",
                "limitations"
            ],
            "properties": {
                "schema_version": {
                    "const": "1"
                },
                "task_id": {
                    "const": "jacobian/chebotarev-fixed-point-proof-audit"
                },
                "result": {
                    "$ref": "#/$defs/result"
                },
                "limitations": {
                    "const": [
                        "S4_CLASSIFICATION_NOT_REPROVED",
                        "CHEBOTAREV_THEOREM_TRUSTED"
                    ]
                }
            }
        }
    }
}
