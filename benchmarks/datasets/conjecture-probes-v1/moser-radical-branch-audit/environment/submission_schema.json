{
  "$defs": {
    "distance": {
      "items": {
        "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "edge": {
      "items": {
        "maximum": 6,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "distance_squared": {
          "$ref": "#/$defs/distance"
        },
        "pair": {
          "$ref": "#/$defs/edge"
        },
        "unit": {
          "type": "boolean"
        }
      },
      "required": [
        "pair",
        "distance_squared",
        "unit"
      ],
      "type": "object"
    },
    "table": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 21,
      "minItems": 21,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "corrected_edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 11,
          "minItems": 11,
          "type": "array"
        },
        "corrected_pair_table": {
          "$ref": "#/$defs/table"
        },
        "corrupted_pair_table": {
          "$ref": "#/$defs/table"
        },
        "false_claimed_edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "repair": {
          "const": "FLIP_VERTEX_5_B_BRANCH_TO_POSITIVE"
        }
      },
      "required": [
        "corrupted_pair_table",
        "false_claimed_edges",
        "repair",
        "corrected_pair_table",
        "corrected_edges"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
