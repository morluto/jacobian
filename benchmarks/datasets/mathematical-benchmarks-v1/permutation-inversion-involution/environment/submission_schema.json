{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "fixed_point_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pair_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pair_inversion_sum": {
          "type": "integer"
        },
        "total_inversions": {
          "minimum": 0,
          "type": "integer"
        },
        "traces": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "inversions": {
                "minimum": 0,
                "type": "integer"
              },
              "permutation": {
                "items": {
                  "maximum": 7,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxItems": 7,
                "minItems": 7,
                "type": "array"
              },
              "transformed": {
                "items": {
                  "maximum": 7,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxItems": 7,
                "minItems": 7,
                "type": "array"
              },
              "transformed_inversions": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "permutation",
              "transformed",
              "inversions",
              "transformed_inversions"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "transformation": {
          "enum": [
            "REVERSE_POSITIONS",
            "COMPLEMENT_VALUES",
            "INVERSE_PERMUTATION"
          ]
        },
        "value_multiplier": {
          "maximum": 1,
          "minimum": -1,
          "type": "integer"
        },
        "value_offset": {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "transformation",
        "value_multiplier",
        "value_offset",
        "pair_inversion_sum",
        "fixed_point_count",
        "pair_count",
        "total_inversions",
        "traces"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/permutation-involution-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
