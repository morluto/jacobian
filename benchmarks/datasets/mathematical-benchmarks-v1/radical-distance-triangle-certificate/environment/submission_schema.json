{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "center_distance_squared": {
          "type": "integer"
        },
        "equality_witness": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "expanded_radicands": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "a2": {
                "type": "integer"
              },
              "a_sqrt2": {
                "type": "integer"
              },
              "b2": {
                "type": "integer"
              },
              "b_sqrt2": {
                "type": "integer"
              },
              "constant": {
                "type": "integer"
              }
            },
            "required": [
              "a2",
              "b2",
              "a_sqrt2",
              "b_sqrt2",
              "constant"
            ],
            "type": "object"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "lower_bound": {
          "type": "integer"
        },
        "method": {
          "enum": [
            "DISTANCE_TRIANGLE_INEQUALITY",
            "SQUARING_AND_CALCULUS",
            "NUMERICAL_SAMPLING"
          ]
        },
        "scaled_centers": {
          "items": {
            "items": {
              "maximum": 4,
              "minimum": -4,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "method",
        "scaled_centers",
        "expanded_radicands",
        "center_distance_squared",
        "lower_bound",
        "equality_witness"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/radical-distance-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
