#!/usr/bin/env python3
"""Map changed repository paths to suites using the CI impact manifest."""

from __future__ import annotations

import argparse
import json
import tomllib
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
MANIFEST = ROOT / ".github" / "ci-impact.json"
TOPOLOGY = ROOT / "tests" / "topology.toml"

# More-specific ownership rules suppress the general python-source catch-all
# when both match the same path (fnmatch '*' crosses '/').
_SUPPRESSED_WHEN_PRESENT = {
    "domain-mathematical-sources": frozenset({"python-source"}),
    "npm-facing-adapter": frozenset({"python-source"}),
    "ci-planning-tools": frozenset({"ci-scripts"}),
    "benchmark-ci-automation": frozenset({"ci-scripts", "ci-automation"}),
}


def load_manifest() -> dict[str, Any]:
    with MANIFEST.open(encoding="utf-8") as handle:
        return json.load(handle)


def suites_for_path(path: str, manifest: dict[str, Any]) -> set[str]:
    matching_rules: list[dict[str, Any]] = []
    for rule in manifest["rules"]:
        if any(fnmatchcase(path, pattern) for pattern in rule["patterns"]):
            matching_rules.append(rule)
    if matching_rules:
        matched_names = {str(rule["name"]) for rule in matching_rules}
        suppressed: set[str] = set()
        for specific, generals in _SUPPRESSED_WHEN_PRESENT.items():
            if specific in matched_names:
                suppressed.update(generals)
        return {
            str(suite)
            for rule in matching_rules
            if str(rule["name"]) not in suppressed
            for suite in rule["suites"]
        }
    fallback = manifest["fallback"]
    return set(fallback["suites"])


def deferred_pull_request_lanes() -> set[str]:
    data = tomllib.loads(TOPOLOGY.read_text(encoding="utf-8"))
    return {
        str(lane["name"])
        for lane in data["lanes"]
        if lane["ci"]["pull_request"] is False
    }


def classify(
    paths: list[str],
    *,
    exhaustive: bool,
    force_lean: bool,
) -> dict[str, str]:
    manifest = load_manifest()
    exhaustive = exhaustive or not paths
    all_suites = set(manifest["suites"])
    code_suites = all_suites - {"docs"}
    suites: set[str] = set()

    if exhaustive or not paths:
        suites = all_suites
    else:
        for path in paths:
            suites.update(suites_for_path(path, manifest))

    if not exhaustive:
        suites.difference_update(deferred_pull_request_lanes())

    if force_lean:
        suites.add("lean")

    python_lanes = (
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "provider",
        "e2e",
    )
    selected_python_lanes = tuple(lane for lane in python_lanes if lane in suites)
    if exhaustive:
        classification = "exhaustive"
    elif suites == {"docs"}:
        classification = "docs"
    elif suites in (code_suites, all_suites):
        classification = "full"
    elif not suites:
        classification = "none"
    elif suites == {"npm"}:
        classification = "npm"
    elif suites == {"lean"}:
        classification = "lean"
    elif suites <= {*python_lanes, "static"} and selected_python_lanes:
        classification = "python"
    else:
        classification = "selective"

    semantic_lanes = {f"run-{lane}": lane in suites for lane in python_lanes}
    matrix_lanes = (
        "component",
        "storage",
        "mcp",
        "provider",
        "e2e",
    )
    selected_matrix_lanes = [lane for lane in matrix_lanes if lane in suites]
    plan: dict[str, str] = {
        "classification": classification,
        "run-python": str(bool(selected_python_lanes)).lower(),
        "product-lane-matrix": json.dumps(
            {"include": [{"lane": lane} for lane in selected_matrix_lanes]},
            separators=(",", ":"),
        ),
        **{key: str(value).lower() for key, value in semantic_lanes.items()},
        "run-coverage": str(exhaustive and set(python_lanes) <= suites).lower(),
        "run-compatibility": str(exhaustive and set(python_lanes) <= suites).lower(),
    }
    for suite in (
        "lean",
        "provider",
        "npm",
        "static",
        "build",
        "security",
        "duplicate",
        "docs",
    ):
        plan[f"run-{suite}"] = str(suite in suites).lower()
    return plan


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--force-full",
        "--force-exhaustive",
        dest="exhaustive",
        action="store_true",
        help="Run every configured lane, including coverage and compatibility.",
    )
    parser.add_argument("--force-lean", action="store_true")
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args()
    paths = args.paths[1:] if args.paths[:1] == ["--"] else args.paths
    for key, value in classify(
        paths,
        exhaustive=args.exhaustive,
        force_lean=args.force_lean,
    ).items():
        print(f"{key}={value}")


if __name__ == "__main__":
    main()
