{
  "$defs": {
    "quadratic_root": {
      "additionalProperties": false,
      "properties": {
        "radical_coefficient": {
          "$ref": "#/$defs/rational_string"
        },
        "radicand": {
          "maximum": 10000,
          "minimum": 2,
          "type": "integer"
        },
        "rational": {
          "$ref": "#/$defs/rational_string"
        }
      },
      "required": [
        "rational",
        "radical_coefficient",
        "radicand"
      ],
      "type": "object"
    },
    "rational_string": {
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "CLAIM_INCONSISTENT"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "excluded_branch": {
          "additionalProperties": false,
          "properties": {
            "pair_sum": {
              "$ref": "#/$defs/rational_string"
            },
            "product": {
              "$ref": "#/$defs/rational_string"
            },
            "product_consequence_lhs": {
              "$ref": "#/$defs/rational_string"
            },
            "product_consequence_rhs": {
              "$ref": "#/$defs/rational_string"
            },
            "residual": {
              "$ref": "#/$defs/rational_string"
            },
            "sum": {
              "$ref": "#/$defs/rational_string"
            }
          },
          "required": [
            "sum",
            "pair_sum",
            "product",
            "product_consequence_lhs",
            "product_consequence_rhs",
            "residual"
          ],
          "type": "object"
        },
        "necessary_polynomial": {
          "items": {
            "maximum": 1000000,
            "minimum": -1000000,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "proposed_classifications": {
          "items": {
            "enum": [
              "PASSES_NECESSARY_CONDITION",
              "FAILS_NECESSARY_CONDITION"
            ]
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "proposed_evaluations": {
          "items": {
            "$ref": "#/$defs/rational_string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "remaining_real_roots": {
          "items": {
            "$ref": "#/$defs/quadratic_root"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "necessary_polynomial",
        "proposed_evaluations",
        "proposed_classifications",
        "remaining_real_roots",
        "excluded_branch"
      ],
      "type": "object"
    },
    "scope": {
      "const": "cyclic-polynomial-sum-audit exact elimination certificate",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/cyclic-polynomial-sum-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
