{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "limit_coordinates": {
          "items": {
            "type": "string"
          },
          "minItems": 100,
          "type": "array"
        },
        "operator_bound": {
          "type": "string"
        },
        "operator_kind": {
          "enum": [
            "DIAGONAL",
            "WEIGHTED_SHIFT"
          ]
        },
        "prefixes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "limit_norm_sq_partial": {
                "type": "string"
              },
              "n": {
                "minimum": 1,
                "type": "integer"
              },
              "preimage_coordinate": {
                "type": "string"
              },
              "preimage_norm_sq_partial": {
                "type": "string"
              },
              "weight": {
                "type": "string"
              }
            },
            "required": [
              "n",
              "weight",
              "preimage_coordinate",
              "limit_norm_sq_partial",
              "preimage_norm_sq_partial"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "preimage_growth": {
          "additionalProperties": false,
          "properties": {
            "bound_coefficient": {
              "type": "string"
            },
            "bound_exponent": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "bound_coefficient",
            "bound_exponent"
          ],
          "type": "object"
        },
        "tail_bound": {
          "additionalProperties": false,
          "properties": {
            "bound_coefficient": {
              "type": "string"
            },
            "bound_exponent": {
              "minimum": 1,
              "type": "integer"
            },
            "verification_terms": {
              "minimum": 100,
              "type": "integer"
            }
          },
          "required": [
            "bound_coefficient",
            "bound_exponent",
            "verification_terms"
          ],
          "type": "object"
        }
      },
      "required": [
        "operator_bound",
        "prefixes",
        "limit_coordinates",
        "tail_bound",
        "operator_kind"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
