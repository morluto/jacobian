#!/usr/bin/env python3
"""Validate the classifier's machine-readable semantic lane plan."""

from __future__ import annotations

import json
import re
import shlex
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tools.makefile_catalog import (  # noqa: E402
    MakefileCatalogError,
    discover_makefiles,
)
from tools.test_plan.ci_outputs import (  # noqa: E402
    boolean_run_keys,
    matrix_lane_names,
    python_run_keys,
)


def _impact_manifest() -> dict:
    return json.loads((ROOT / ".github" / "ci-impact.json").read_text(encoding="utf-8"))


_IMPACT = _impact_manifest()
BOOLEAN_KEYS = boolean_run_keys(_IMPACT)
PROVIDER_SELECTION_KEY = "provider-selection"
RUN_DEPLOY_KEY = "run-deploy"
PYTHON_LANES = python_run_keys(_IMPACT)
FUNCTIONAL_KEYS = tuple(
    key
    for key in BOOLEAN_KEYS
    if key not in {"run-coverage", "run-compatibility", "run-docs"}
)
FULL_REQUIRED_KEYS = tuple(
    key
    for key in BOOLEAN_KEYS
    if key not in {"run-coverage", "run-compatibility", "run-docs"}
)
CLASSIFICATIONS = {
    "none",
    "docs",
    "npm",
    "lean",
    "python",
    "selective",
    "full",
    "exhaustive",
}


def fail(message: str) -> None:
    raise SystemExit(message)


def _validate_catalog() -> None:
    """Prove impact, topology, and displayed Make commands agree."""

    try:
        manifest = json.loads(
            (ROOT / ".github" / "ci-impact.json").read_text(encoding="utf-8")
        )
        catalog = manifest["catalog"]
        suites = set(manifest["suites"])
        if not isinstance(catalog, dict):
            fail("CI catalog must be an object")
        catalog_suites = {
            name
            for name, entry in catalog.items()
            if not isinstance(entry, dict) or not entry.get("local_only", False)
        }
        if catalog_suites != suites:
            fail("CI catalog suites must match impact manifest suites")
        for rule in manifest["rules"]:
            if not isinstance(rule, dict) or not {"name", "patterns", "suites"} <= set(
                rule
            ):
                fail("CI impact rules have an invalid shape")
            unknown = set(rule["suites"]) - catalog_suites
            if unknown:
                fail(
                    f"CI impact rule {rule['name']} names unknown suites: "
                    f"{sorted(unknown)}"
                )

        topology_data = tomllib.loads(
            (ROOT / "tests" / "topology.toml").read_text(encoding="utf-8")
        )
        topology_lanes = {lane["name"] for lane in topology_data["lanes"]}
        catalog_lanes = {
            entry["topology_lane"]
            for name, entry in catalog.items()
            if name in catalog_suites and entry.get("topology_lane") is not None
        }
        if catalog_lanes != topology_lanes:
            fail("CI catalog topology lanes must match tests/topology.toml")

        targets = set(
            re.findall(
                r"(?m)^([A-Za-z0-9_.-]+):(?:[^=]|$)",
                discover_makefiles(ROOT).text(),
            )
        )
        for name, entry in catalog.items():
            command = entry.get("command") if isinstance(entry, dict) else None
            if not isinstance(command, str) or not command:
                fail(f"CI catalog entry {name} has no command")
            argv = shlex.split(command)
            if len(argv) != 2 or argv[0] != "make" or argv[1] not in targets:
                fail(f"CI catalog command for {name} is not a Make target: {command}")
            subsumes = entry.get("local_subsumes", [])
            if (
                not isinstance(subsumes, list)
                or not all(isinstance(item, str) and item for item in subsumes)
                or name in subsumes
                or any(item not in catalog_suites for item in subsumes)
            ):
                fail(f"CI catalog entry {name} has invalid local_subsumes")

        visiting: set[str] = set()
        visited: set[str] = set()

        def visit_subsumptions(name: str) -> None:
            if name in visiting:
                fail("CI catalog local_subsumes must be acyclic")
            if name in visited:
                return
            visiting.add(name)
            for child in catalog[name].get("local_subsumes", []):
                visit_subsumptions(str(child))
            visiting.remove(name)
            visited.add(name)

        for name in catalog:
            visit_subsumptions(name)

        provider = catalog.get("provider", {})
        if not isinstance(provider, dict) or not provider.get("providers"):
            fail("provider catalog must declare selectable providers")
        provider_lane = next(
            lane for lane in topology_data["lanes"] if lane["name"] == "provider"
        )
        if provider_lane["required_provider"] != "optional":
            fail("provider catalog requires the optional topology provider")

        # plan-local-tests and the product workflow hardcode the local-only
        # deployment gate.  The catalog must keep that contract so a missing
        # entry surfaces as a CI-time validation failure rather than an import
        # or runtime crash in the planner.
        deploy = catalog.get("deploy", {})
        if (
            not isinstance(deploy, dict)
            or deploy.get("local_only") is not True
            or deploy.get("topology_lane") is not None
            or deploy.get("command") != "make deploy-check"
        ):
            fail(
                "CI catalog must keep a local-only deploy gate "
                "with command 'make deploy-check'"
            )
    except (
        MakefileCatalogError,
        OSError,
        KeyError,
        TypeError,
        ValueError,
        tomllib.TOMLDecodeError,
    ) as exc:
        fail(f"invalid CI validation catalog: {exc}")


def _only_enabled(plan: dict[str, str], *allowed: str) -> bool:
    allowed_set = set(allowed)
    return all((plan[key] == "true") == (key in allowed_set) for key in BOOLEAN_KEYS)


def _validate_classification(plan: dict[str, str]) -> None:
    classification = plan["classification"]
    if classification == "none":
        if not _only_enabled(plan):
            fail("none CI must disable every product lane")
        if plan[RUN_DEPLOY_KEY] != "false":
            fail("none CI must disable deployment validation")
    elif classification == "docs":
        if not _only_enabled(plan, "run-docs"):
            fail("docs CI must enable only run-docs")
        if plan[RUN_DEPLOY_KEY] != "false":
            fail("docs CI must disable deployment validation")
    elif classification == "npm":
        if not _only_enabled(plan, "run-npm"):
            fail("npm CI must enable only run-npm")
        if plan[RUN_DEPLOY_KEY] != "false":
            fail("npm CI must disable deployment validation")
    elif classification == "lean":
        if not _only_enabled(plan, "run-lean"):
            fail("lean CI must enable only run-lean")
        if plan[RUN_DEPLOY_KEY] != "false":
            fail("lean CI must disable deployment validation")
    elif classification == "python":
        allowed = {"run-deploy", "run-python", "run-static", *PYTHON_LANES}
        if (
            plan["run-python"] != "true"
            or not any(plan[key] == "true" for key in PYTHON_LANES)
            or any(plan[key] == "true" for key in BOOLEAN_KEYS if key not in allowed)
        ):
            fail("python CI must enable a semantic Python lane")
    elif classification == "full":
        if any(plan[key] != "true" for key in FULL_REQUIRED_KEYS):
            fail("full CI must enable every code lane")
    elif classification == "selective":
        if not any(plan[key] == "true" for key in FUNCTIONAL_KEYS):
            fail("selective CI must enable a functional lane")
        if all(plan[key] == "true" for key in FULL_REQUIRED_KEYS):
            fail("selective CI cannot have the full code-lane shape")
    elif classification == "exhaustive":
        pass
    else:
        fail(f"unhandled CI classification: {classification}")


def main() -> None:
    _validate_catalog()
    plan: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.rstrip("\n")
        if "=" not in line:
            fail(f"invalid CI plan line: {line}")
        key, value = line.split("=", 1)
        if key in plan:
            fail(f"duplicate CI plan key: {key}")
        plan[key] = value

    expected = {
        "classification",
        "product-lane-matrix",
        PROVIDER_SELECTION_KEY,
        RUN_DEPLOY_KEY,
        *BOOLEAN_KEYS,
    }
    if set(plan) != expected:
        fail(f"CI plan keys differ: expected {sorted(expected)}, got {sorted(plan)}")
    if plan["classification"] not in CLASSIFICATIONS:
        fail(f"invalid CI classification: {plan['classification']}")
    for key in BOOLEAN_KEYS:
        if plan[key] not in {"true", "false"}:
            fail(f"invalid CI plan value for {key}: {plan[key]}")
    if plan[RUN_DEPLOY_KEY] not in {"true", "false"}:
        fail(f"invalid CI plan value for {RUN_DEPLOY_KEY}: {plan[RUN_DEPLOY_KEY]}")

    try:
        provider_selection = json.loads(plan[PROVIDER_SELECTION_KEY])
    except json.JSONDecodeError as exc:
        fail(f"invalid provider-selection JSON: {exc}")
    if (
        not isinstance(provider_selection, list)
        or len(set(provider_selection)) != len(provider_selection)
        or not all(
            isinstance(provider, str) and provider for provider in provider_selection
        )
    ):
        fail("provider-selection must be a unique array of provider names")
    try:
        manifest = json.loads(
            (ROOT / ".github" / "ci-impact.json").read_text(encoding="utf-8")
        )
        known_providers = set(manifest["catalog"]["provider"]["providers"])
    except (OSError, KeyError, TypeError, ValueError) as exc:
        fail(f"cannot read provider catalog: {exc}")
    if set(provider_selection) - known_providers:
        fail("provider-selection contains an unknown provider")
    if provider_selection and plan["run-provider"] != "true":
        fail("provider-selection requires run-provider=true")

    try:
        matrix = json.loads(plan["product-lane-matrix"])
    except json.JSONDecodeError as exc:
        fail(f"invalid product-lane-matrix JSON: {exc}")
    if not isinstance(matrix, dict) or set(matrix) != {"include"}:
        fail("product-lane-matrix must contain only an include array")
    include = matrix["include"]
    if not isinstance(include, list):
        fail("product-lane-matrix include must be an array")
    matrix_lanes = matrix_lane_names(_IMPACT)
    expected_lanes = [lane for lane in matrix_lanes if plan[f"run-{lane}"] == "true"]
    actual_lanes: list[str] = []
    for entry in include:
        if not isinstance(entry, dict) or set(entry) != {"lane"}:
            fail("product-lane-matrix entries must contain only lane")
        lane = entry["lane"]
        if not isinstance(lane, str) or lane not in matrix_lanes:
            fail(f"invalid product-lane-matrix lane: {lane!r}")
        actual_lanes.append(lane)
    if actual_lanes != expected_lanes:
        fail("product-lane-matrix must exactly match selected matrix-compatible lanes")

    has_python = any(plan[key] == "true" for key in PYTHON_LANES)
    if (plan["run-python"] == "true") != has_python:
        fail("run-python must equal the union of semantic Python lanes")
    for key in ("run-coverage", "run-compatibility"):
        if plan[key] == "true" and not (
            plan["run-unit"] == "true" and plan["run-domain"] == "true"
        ):
            fail(f"{key} requires unit and domain lanes")
    if plan["classification"] == "exhaustive":
        if any(plan[key] != "true" for key in BOOLEAN_KEYS):
            fail("exhaustive CI must enable every lane")
        if plan[RUN_DEPLOY_KEY] != "true":
            fail("exhaustive CI must enable deployment validation")
    elif plan["run-coverage"] == "true" or plan["run-compatibility"] == "true":
        fail("coverage and compatibility are exhaustive-only lanes")
    _validate_classification(plan)


if __name__ == "__main__":
    main()
