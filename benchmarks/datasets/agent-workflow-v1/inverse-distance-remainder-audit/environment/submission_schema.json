{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/inverse-distance-remainder-audit"},
    "conclusion": {"enum": ["CUBIC_REMAINDER_DISPROVED_AND_EXPANSION_REPAIRED", "INSUFFICIENT_EVIDENCE"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_status", "second_order_term", "directional_witnesses", "response_audit"],
      "properties": {
        "claim_status": {"const": "FALSE"},
        "second_order_term": {
          "type": "object", "additionalProperties": false,
          "required": ["dot_square_coefficient", "norm_square_coefficient", "denominator_power", "remainder"],
          "properties": {
            "dot_square_coefficient": {"$ref": "#/$defs/rational"},
            "norm_square_coefficient": {"$ref": "#/$defs/rational"},
            "denominator_power": {"const": 5},
            "remainder": {"const": "O(|y|^3/|x|^4)"}
          }
        },
        "directional_witnesses": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["direction", "quadratic_coefficient", "sign", "normalized_residual_limit"],
            "properties": {
              "direction": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/rational"}},
              "quadratic_coefficient": {"$ref": "#/$defs/rational"},
              "sign": {"enum": ["POSITIVE", "NEGATIVE"]},
              "normalized_residual_limit": {"const": "quadratic_coefficient"}
            }
          }
        },
        "response_audit": {
          "type": "object", "additionalProperties": false,
          "required": ["conclusion", "defects"],
          "properties": {
            "conclusion": {"const": "RIGHT_CONCLUSION_WITH_INVALID_ORDER_STEP"},
            "defects": {
              "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true,
              "items": {"enum": ["EPSILON_SQUARED_ORDER_MISCLASSIFIED", "EXPLICIT_QUADRATIC_TERM_DROPPED", "CUBIC_REMAINDER_FALSE"]}
            }
          }
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer", "minimum": -1000000, "maximum": 1000000}, "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000}}}
  }
}
