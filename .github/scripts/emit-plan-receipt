#!/usr/bin/env python3
"""Emit a provenance-bound receipt for a validated Harbor benchmark plan."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path, PurePosixPath
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from benchmarks.tooling.receipts import canonical_json, digest_bytes  # noqa: E402

EVENTS = {"pull_request", "merge_group", "push", "schedule", "workflow_dispatch"}
SHA = re.compile(r"[0-9a-f]{40,64}\Z")
MAX_PATHS = 10_000
MAX_PLAN_KEYS = 256


def fail(message: str) -> None:
    raise SystemExit(message)


def _sha256(payload: bytes) -> str:
    return digest_bytes(payload)


def _relative_path(value: str, label: str) -> str:
    if not value or "\\" in value:
        fail(f"{label} must be a non-empty POSIX repository path")
    path = PurePosixPath(value)
    if path.is_absolute() or ".." in path.parts or "." in path.parts:
        fail(f"{label} must remain inside the repository: {value!r}")
    return path.as_posix()


def _source_path(value: str, label: str) -> tuple[str, Path]:
    relative = _relative_path(value, label)
    path = ROOT / relative
    if not path.is_file():
        fail(f"{label} does not exist: {relative}")
    return relative, path


def _read_paths(path: Path) -> list[str]:
    try:
        values = [
            line.rstrip("\n") for line in path.read_text(encoding="utf-8").splitlines()
        ]
    except OSError as exc:
        fail(f"cannot read changed paths: {exc}")
    if len(values) > MAX_PATHS:
        fail(f"changed paths exceed {MAX_PATHS} entries")
    normalized = [_relative_path(value, "changed path") for value in values if value]
    if len(set(normalized)) != len(normalized):
        fail("changed paths contain duplicates")
    return sorted(normalized)


def _read_plan(path: Path) -> dict[str, str]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        fail(f"cannot read plan: {exc}")
    plan: dict[str, str] = {}
    for line in lines:
        if not line or "=" not in line:
            fail(f"invalid plan line: {line!r}")
        key, value = line.split("=", 1)
        if not key or key in plan:
            fail(f"invalid or duplicate plan key: {key!r}")
        plan[key] = value
    if not plan:
        fail("plan must contain at least one key")
    if len(plan) > MAX_PLAN_KEYS:
        fail(f"plan exceeds {MAX_PLAN_KEYS} keys")
    return plan


def _revision(value: str, label: str) -> str:
    if value and SHA.fullmatch(value) is None:
        fail(f"invalid {label}: {value}")
    return value


def build_receipt(
    *,
    kind: str,
    event: str,
    base: str,
    head: str,
    planner: str,
    configs: list[str],
    plan_file: Path,
    paths_file: Path,
) -> dict[str, Any]:
    if kind != "benchmark":
        fail("kind must be 'benchmark'")
    if event not in EVENTS:
        fail(f"unsupported event: {event}")
    base = _revision(base, "base revision")
    head = _revision(head, "head revision")
    planner_name, planner_path = _source_path(planner, "planner")
    plan = _read_plan(plan_file)
    paths = _read_paths(paths_file)
    config_digests: dict[str, str] = {}
    for config in configs:
        name, path = _source_path(config, "config")
        config_digests[name] = _sha256(path.read_bytes())
    receipt: dict[str, Any] = {
        "receipt_version": "1",
        "plan_kind": kind,
        "event": event,
        "base_sha": base,
        "head_sha": head,
        "changed_paths": paths,
        "changed_paths_digest": _sha256(
            ("\n".join(paths) + ("\n" if paths else "")).encode()
        ),
        "planner": planner_name,
        "planner_digest": _sha256(planner_path.read_bytes()),
        "config_digests": config_digests,
        "plan_digest": _sha256(
            "".join(f"{key}={plan[key]}\n" for key in sorted(plan)).encode()
        ),
        "plan": plan,
    }
    receipt["receipt_digest"] = _sha256(canonical_json(receipt))
    return receipt


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--kind",
        required=True,
        help="Harbor plan kind; must be 'benchmark'",
    )
    parser.add_argument("--event", required=True)
    parser.add_argument("--base", default="")
    parser.add_argument("--head", default="")
    parser.add_argument("--planner", required=True)
    parser.add_argument("--config", action="append", default=[])
    parser.add_argument("--plan-file", type=Path, required=True)
    parser.add_argument("--paths-file", type=Path, required=True)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    receipt = build_receipt(
        kind=args.kind,
        event=args.event,
        base=args.base,
        head=args.head,
        planner=args.planner,
        configs=args.config,
        plan_file=args.plan_file,
        paths_file=args.paths_file,
    )
    rendered = json.dumps(receipt, indent=2, sort_keys=True) + "\n"
    if args.output is None:
        print(rendered, end="")
    else:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
        print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
