{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "BALANCED_ROW_PERMUTATION_CONSTRUCTED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "const": "This finite construction does not prove the general theorem in a proof assistant."
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "balanced_matrix": {
          "items": {
            "items": {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "column_layers": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "input_position": {
                  "maximum": 5,
                  "minimum": 0,
                  "type": "integer"
                },
                "row": {
                  "maximum": 7,
                  "minimum": 0,
                  "type": "integer"
                },
                "symbol": {
                  "maximum": 4,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "row",
                "input_position",
                "symbol"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "minItems": 8,
            "type": "array"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "row_permutations": {
          "items": {
            "items": {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        }
      },
      "required": [
        "row_permutations",
        "balanced_matrix",
        "column_layers"
      ],
      "type": "object"
    },
    "scope": {
      "const": "the frozen 8 by 6 matrix",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/balanced-row-permutation"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
