{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "integer_witness": {
          "additionalProperties": false,
          "properties": {
            "a_values": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "b_max": {
              "type": "integer"
            },
            "b_min": {
              "type": "integer"
            },
            "b_values": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "cancellation_indices": {
              "items": {
                "type": "integer"
              },
              "type": "array",
              "uniqueItems": true
            },
            "period": {
              "type": "integer"
            },
            "sum_values": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "period",
            "a_values",
            "b_values",
            "sum_values",
            "b_min",
            "b_max",
            "cancellation_indices"
          ],
          "type": "object"
        },
        "nat_redundancy": {
          "additionalProperties": false,
          "properties": {
            "a_lower_bound": {
              "const": 0
            },
            "b_lower_bound": {
              "const": 1
            },
            "rule": {
              "const": "ORDERED_ADDITION_LOWER_BOUND"
            },
            "sum_lower_bound": {
              "const": 1
            }
          },
          "required": [
            "a_lower_bound",
            "b_lower_bound",
            "sum_lower_bound",
            "rule"
          ],
          "type": "object"
        },
        "semantic_status": {
          "const": "STRICTLY_WEAKER"
        }
      },
      "required": [
        "semantic_status",
        "nat_redundancy",
        "integer_witness"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
