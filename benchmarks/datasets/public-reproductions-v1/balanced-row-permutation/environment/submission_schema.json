{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "balanced_matrix": {
          "items": {
            "items": {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "column_layers": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "input_position": {
                  "maximum": 5,
                  "minimum": 0,
                  "type": "integer"
                },
                "row": {
                  "maximum": 7,
                  "minimum": 0,
                  "type": "integer"
                },
                "symbol": {
                  "maximum": 4,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "row",
                "input_position",
                "symbol"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "minItems": 8,
            "type": "array"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "row_permutations": {
          "items": {
            "items": {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        }
      },
      "required": [
        "row_permutations",
        "balanced_matrix",
        "column_layers"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
