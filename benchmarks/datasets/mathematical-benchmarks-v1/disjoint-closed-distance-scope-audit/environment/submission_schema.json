        "vertical_scale": {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "horizontal_step",
        "vertical_scale",
        "offset",
        "sample_indices",
        "distance_squared",
        "epsilon_witnesses",
        "separation_certificate",
        "formal_conclusion",
        "corrected_conclusion"
      ],
      "type": "object"
    },
    "separation": {
