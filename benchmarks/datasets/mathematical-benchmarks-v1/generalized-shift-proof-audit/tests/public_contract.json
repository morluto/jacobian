          "type": "object"
        },
        "radical_domain": {
          "additionalProperties": false,
          "properties": {
            "m": {
              "maximum": 100,
              "minimum": 2,
              "type": "integer"
            },
            "radicand": {
              "type": "integer"
            },
            "real_status": {
              "const": "NOT_REAL"
            }
          },
          "required": [
            "m",
            "radicand",
            "real_status"
          ],
          "type": "object"
        }
