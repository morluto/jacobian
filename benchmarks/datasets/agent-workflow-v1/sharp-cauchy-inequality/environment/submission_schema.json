{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["task_id","conclusion","result","claimed_assurance","scope","completeness","evidence","limitations"],
  "properties":{
    "task_id":{"const":"jacobian/sharp-cauchy-inequality"},"conclusion":{"enum":["SHARP_CONSTANT_CERTIFIED","INSUFFICIENT_EVIDENCE"]},
    "result":{"$ref":"#/$defs/result"},"claimed_assurance":{"enum":["UNVERIFIED","COMPUTED","CHECKED","VERIFIED"]},
    "scope":{"const":"FROZEN_INEQUALITY_AND_SUBMITTED_SYMBOLIC_CERTIFICATE"},"completeness":{"enum":["COMPLETE","PARTIAL","UNKNOWN"]},
    "evidence":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"const":"evidence/inequality-certificate.json"},"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}},
    "limitations":{"const":["ELEMENTARY_REAL_ORDER_AND_SQUARE_ROOT_LEMMAS_TRUSTED","POSITIVE_HOMOGENEITY_NORMALIZATION_TRUSTED"]}
  },
  "$defs":{
    "rat":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],"properties":{"numerator":{"type":"integer"},"denominator":{"type":"integer","minimum":1}}},
    "term":{"type":"object","additionalProperties":false,"required":["exponents","coefficient"],"properties":{"exponents":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"integer","minimum":0,"maximum":4}},"coefficient":{"type":"integer","minimum":-20,"maximum":20}}},
    "poly":{"type":"array","items":{"$ref":"#/$defs/term"},"maxItems":80},
    "witness":{"type":"object","additionalProperties":false,"required":["a","b","c","x","y","z"],"properties":{"a":{"$ref":"#/$defs/rat"},"b":{"$ref":"#/$defs/rat"},"c":{"$ref":"#/$defs/rat"},"x":{"$ref":"#/$defs/rat"},"y":{"$ref":"#/$defs/rat"},"z":{"$ref":"#/$defs/rat"}}},
    "amgm":{"type":"object","additionalProperties":false,"required":["d","u","v","residual","sos_twice","constraint_residual"],"properties":{"d":{"$ref":"#/$defs/poly"},"u":{"$ref":"#/$defs/poly"},"v":{"$ref":"#/$defs/poly"},"residual":{"$ref":"#/$defs/poly"},"sos_twice":{"$ref":"#/$defs/poly"},"constraint_residual":{"$ref":"#/$defs/poly"}}},
    "cs":{"type":"object","additionalProperties":false,"required":["d","a2","x2","across","xcross","gram_residual","gram_sos","total_a_square","total_x_square"],"properties":{"d":{"$ref":"#/$defs/poly"},"a2":{"$ref":"#/$defs/poly"},"x2":{"$ref":"#/$defs/poly"},"across":{"$ref":"#/$defs/poly"},"xcross":{"$ref":"#/$defs/poly"},"gram_residual":{"$ref":"#/$defs/poly"},"gram_sos":{"$ref":"#/$defs/poly"},"total_a_square":{"$ref":"#/$defs/poly"},"total_x_square":{"$ref":"#/$defs/poly"}}},
    "result":{"type":"object","additionalProperties":false,"required":["constant","proof_mode","certificate","equality_witness"],"properties":{"constant":{"$ref":"#/$defs/rat"},"proof_mode":{"enum":["CS_COMPOSITION","AMGM_SQUARES"]},"certificate":{"oneOf":[{"$ref":"#/$defs/amgm"},{"$ref":"#/$defs/cs"}]},"equality_witness":{"$ref":"#/$defs/witness"}}}
  }
}
