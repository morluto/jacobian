{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/noncompact-lefschetz-proof-audit"},
    "conclusion": {"enum": ["FROZEN_LEMMA_REFUTED", "FROZEN_LEMMA_VALID", "INSUFFICIENT_EVIDENCE"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterexample", "theorem_audit", "downstream_status", "original_question_status"],
      "properties": {
        "counterexample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["space", "translation", "fixed_point_equation", "fixed_point_exists", "proper", "compact_support_cohomology", "top_degree_action", "lefschetz_number"],
          "properties": {
            "space": {"const": "R"},
            "translation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["numerator", "denominator"],
              "properties": {
                "numerator": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
                "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000}
              }
            },
            "fixed_point_equation": {"const": "x+q=x"},
            "fixed_point_exists": {"type": "boolean"},
            "proper": {"type": "boolean"},
            "compact_support_cohomology": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["degree", "dimension"],
                "properties": {
                  "degree": {"type": "integer", "minimum": 0, "maximum": 1},
                  "dimension": {"type": "integer", "minimum": 0, "maximum": 1}
                }
              }
            },
            "top_degree_action": {"enum": [-1, 1]},
            "lefschetz_number": {"type": "integer", "minimum": -1, "maximum": 1}
          }
        },
        "theorem_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frozen_lemma_status", "invalid_step", "repair_boundary"],
          "properties": {
            "frozen_lemma_status": {"enum": ["FALSE", "TRUE", "NOT_ASSESSED"]},
            "invalid_step": {"enum": ["COMPACTLY_SUPPORTED_DIAGONAL_THOM_CLASS", "FIXED_POINT_EQUATION", "POINCARE_DUALITY", "NONE"]},
            "repair_boundary": {"enum": ["REQUIRES_ADDITIONAL_HYPOTHESES_OR_DIFFERENT_ARGUMENT", "NO_REPAIR_REQUIRED"]}
          }
        },
        "downstream_status": {"enum": ["UNSUPPORTED_BY_FROZEN_ARGUMENT", "ESTABLISHED_BY_FROZEN_ARGUMENT"]},
        "original_question_status": {"const": "NOT_ASSESSED"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/answer.txt"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
