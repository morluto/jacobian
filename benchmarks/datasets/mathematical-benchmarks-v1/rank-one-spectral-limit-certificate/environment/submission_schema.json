{
  "$defs": {
    "checkpoint": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 30,
          "minimum": 4,
          "type": "integer"
        },
        "reciprocal_sum": {
          "$ref": "#/$defs/rat"
        },
        "root": {
          "$ref": "#/$defs/rat"
        }
      },
      "required": [
        "n",
        "reciprocal_sum",
        "root"
      ],
      "type": "object"
    },
    "rat": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 1,
          "type": "integer"
        },
        "numerator": {
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "checkpoints": {
          "items": {
            "$ref": "#/$defs/checkpoint"
          },
          "maxItems": 8,
          "minItems": 3,
          "type": "array"
        },
        "limit": {
          "$ref": "#/$defs/rat"
        },
        "partial_fraction": {
          "additionalProperties": false,
          "properties": {
            "left_coefficient": {
              "maximum": 3,
              "minimum": -3,
              "type": "integer"
            },
            "right_coefficient": {
              "maximum": 3,
              "minimum": -3,
              "type": "integer"
            },
            "scale": {
              "$ref": "#/$defs/rat"
            }
          },
          "required": [
            "scale",
            "left_coefficient",
            "right_coefficient"
          ],
          "type": "object"
        },
        "rank_one_sign": {
          "const": "DIAGONAL_MINUS_LAMBDA_ONES"
        },
        "root_formula": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rank_one_sign",
        "partial_fraction",
        "checkpoints",
        "root_formula",
        "limit"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/spectral-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
