{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "const": "jacobian/reliability-series-path"
    },
    "conclusion": {
      "const": "TRUE"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "states"
      ],
      "properties": {
        "probability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num",
            "den"
          ],
          "properties": {
            "num": {
              "type": "string"
            },
            "den": {
              "type": "string"
            }
          }
        },
        "states": {
          "type": "integer"
        }
      }
    },
    "claimed_assurance": {
      "enum": ["UNVERIFIED","COMPUTED"]
    },
    "scope": {
      "const": "jacobian/reliability-series-path complete finite input"
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,"maxItems":1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
