{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "STEINER_TRIPLE_SYSTEM_CONSTRUCTED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "The verifier checks the submitted finite order-27 design and does not prove the source theorem for arbitrary v and t."
      ]
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "items": {
              "maximum": 26,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array",
            "uniqueItems": true
          },
          "maxItems": 117,
          "minItems": 117,
          "type": "array",
          "uniqueItems": true
        },
        "order": {
          "const": 27
        }
      },
      "required": [
        "order",
        "blocks"
      ],
      "type": "object"
    },
    "scope": {
      "const": "FINITE_STEINER_TRIPLE_SYSTEM_OF_ORDER_27",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/steiner-triple-system-27"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
