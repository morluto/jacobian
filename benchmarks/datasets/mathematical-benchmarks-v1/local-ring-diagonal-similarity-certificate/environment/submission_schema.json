{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "DIAGONAL_ENTRIES_MATCH_BY_UNIT_PERMUTATION"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "BP": {
          "items": {
            "items": {
              "maximum": 124,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "PA": {
          "items": {
            "items": {
              "maximum": 124,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "determinant_modulus": {
          "maximum": 124,
          "minimum": 0,
          "type": "integer"
        },
        "matched_pairs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "a_value": {
                "type": "integer"
              },
              "b_value": {
                "type": "integer"
              },
              "column": {
                "type": "integer"
              },
              "row": {
                "type": "integer"
              },
              "unit_entry": {
                "type": "integer"
              }
            },
            "required": [
              "row",
              "column",
              "b_value",
              "a_value",
              "unit_entry"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "modulus": {
          "const": 125
        },
        "permutation_sign": {
          "enum": [
            -1,
            1
          ]
        },
        "signed_term_modulus": {
          "maximum": 124,
          "minimum": 0,
          "type": "integer"
        },
        "unit_permutation": {
          "items": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "modulus",
        "PA",
        "BP",
        "determinant_modulus",
        "unit_permutation",
        "permutation_sign",
        "signed_term_modulus",
        "matched_pairs"
      ],
      "type": "object"
    },
    "scope": {
      "const": "frozen-six-dimensional-Z-mod-125-certificate",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/local-ring-diagonal-similarity-certificate"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
