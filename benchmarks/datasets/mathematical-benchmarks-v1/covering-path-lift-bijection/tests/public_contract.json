{
    "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result.",
    "schema_definitions": {
        "lifts": {
            "items": {
                "additionalProperties": false,
                "properties": {
                    "endpoint": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string"
                    },
                    "trace": {
                        "items": {
                            "type": "string"
                        },
                        "maxItems": 4,
                        "minItems": 3,
                        "type": "array"
                    }
                },
                "required": [
                    "start",
                    "trace",
                    "endpoint"
                ],
                "type": "object"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
        }
    },
    "schema_version": "1",
    "submission_path": "/app/submission.json",
    "submission_result": {
        "additionalProperties": false,
        "properties": {
            "base_path": {
                "items": {
                    "type": "string"
                },
                "maxItems": 4,
                "minItems": 3,
                "type": "array",
                "uniqueItems": true
            },
            "bijection": {
                "items": {
                    "additionalProperties": false,
                    "properties": {
                        "source": {
                            "type": "string"
                        },
                        "target": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "source",
                        "target"
                    ],
                    "type": "object"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
            },
            "forward_lifts": {
                "$ref": "#/$defs/lifts"
            },
            "local_covering_checked": {
                "const": true
            },
            "reverse_lifts": {
                "$ref": "#/$defs/lifts"
            },
            "reverse_path": {
                "items": {
                    "type": "string"
                },
                "maxItems": 4,
                "minItems": 3,
                "type": "array",
                "uniqueItems": true
            }
        },
        "required": [
            "base_path",
            "reverse_path",
            "forward_lifts",
            "reverse_lifts",
            "bijection",
            "local_covering_checked"
        ],
        "type": "object"
    },
    "task_id": "jacobian/covering-path-lift-bijection"
}
