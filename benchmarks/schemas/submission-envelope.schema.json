{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jacobian Harbor submission envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["result"],
  "properties": {
    "result": {"type": "object"},
    "witness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
