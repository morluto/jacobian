{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/jcb-postdoc-014"},
    "conclusion": {"const": "DISPROVED"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_path", "same_non_double_flats", "mdr"],
      "properties": {
        "certificate_path": {"const": "evidence/syzygy-certificate.json"},
        "same_non_double_flats": {"const": true},
        "mdr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["f", "g"],
          "properties": {"f": {"const": 4}, "g": {"const": 5}}
        }
      }
    },
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "jacobian/jcb-postdoc-014 public answer-visible exact graded relation diagnostic"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/syzygy-certificate.json"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"const": ["PUBLIC_ANSWER_VISIBLE", "BENCHMARK_VERIFIER_NOT_PRODUCT_AUTHORITY"]}
  }
}
