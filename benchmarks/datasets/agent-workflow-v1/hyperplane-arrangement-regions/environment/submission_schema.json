{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "REGION_COUNT_CERTIFIED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "duplicate_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "ordered_planes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "coefficients": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              },
              "increment": {
                "minimum": 0,
                "type": "integer"
              },
              "label": {
                "enum": [
                  "cube_x0",
                  "cube_x1",
                  "cube_y0",
                  "cube_y1",
                  "cube_z0",
                  "cube_z1",
                  "tetra_A1C1D1",
                  "tetra_BC1D1",
                  "tetra_BA1D1",
                  "tetra_BA1C1"
                ]
              }
            },
            "required": [
              "label",
              "coefficients",
              "increment"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 10,
          "type": "array"
        },
        "regions": {
          "type": "integer"
        }
      },
      "required": [
        "regions",
        "ordered_planes",
        "duplicate_groups"
      ],
      "type": "object"
    },
    "scope": {
      "const": "the ten frozen cube and tetrahedron face planes",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/hyperplane-arrangement-regions"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
