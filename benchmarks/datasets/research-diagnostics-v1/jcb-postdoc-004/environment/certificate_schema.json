{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vertex_count", "edges", "claims"],
  "properties": {
    "schema_version": {"const": "1"},
    "vertex_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "edges": {
      "type": "array",
      "maxItems": 190,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0, "maximum": 19},
          {"type": "integer", "minimum": 0, "maximum": 19}
        ],
        "items": false
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "independence_number",
        "neighborhood_independence",
        "local_average",
        "hamiltonian_path_exists"
      ],
      "properties": {
        "connected": {"const": true},
        "independence_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "neighborhood_independence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "integer", "minimum": 0, "maximum": 20}
        },
        "local_average": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 0, "maximum": 400},
            "denominator": {"type": "integer", "minimum": 1, "maximum": 20}
          }
        },
        "hamiltonian_path_exists": {"const": false}
      }
    }
  }
}
