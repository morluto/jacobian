{
  "$defs": {
    "lifts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "trace": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "start",
          "trace",
          "endpoint"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "FIBERS_BIJECTED_BY_PATH_LIFTING",
        "INVALID_COVER",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "base_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "bijection": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "forward_lifts": {
          "$ref": "#/$defs/lifts"
        },
        "local_covering_checked": {
          "const": true
        },
        "reverse_lifts": {
          "$ref": "#/$defs/lifts"
        },
        "reverse_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "base_path",
        "reverse_path",
        "forward_lifts",
        "reverse_lifts",
        "bijection",
        "local_covering_checked"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/covering-path-lift-bijection"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
