{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jacobian Harbor dataset header",
  "description": "Dataset metadata. Membership is declared by one member fragment per direct Harbor task bundle under the dataset root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset"],
  "properties": {
    "schema_version": {"const": "2"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "claim_class", "answer_visibility", "default_execution_profile"],
      "properties": {
        "id": {"type": "string", "pattern": "^jacobian/[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "claim_class": {"type": "string", "minLength": 1},
        "answer_visibility": {"type": "string", "minLength": 1},
        "default_execution_profile": {"type": "string", "minLength": 1},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "authors": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
