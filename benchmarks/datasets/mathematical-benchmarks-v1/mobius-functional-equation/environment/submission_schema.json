{
  "$defs": {
    "matrix": {
      "items": {
        "items": {
          "maximum": 1,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "poly": {
      "items": {
        "maximum": 100,
        "minimum": -100,
        "type": "integer"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "ratfun": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "$ref": "#/$defs/poly"
        },
        "numerator": {
          "$ref": "#/$defs/poly"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "coefficient_matrix": {
          "$ref": "#/$defs/matrix"
        },
        "matrix_determinant": {
          "const": 2
        },
        "orbit": {
          "items": {
            "$ref": "#/$defs/ratfun"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "right_hand_sides": {
          "items": {
            "$ref": "#/$defs/ratfun"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "solution_at_x": {
          "$ref": "#/$defs/ratfun"
        },
        "solution_values": {
          "items": {
            "$ref": "#/$defs/ratfun"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "orbit",
        "right_hand_sides",
        "solution_values",
        "coefficient_matrix",
        "matrix_determinant",
        "solution_at_x"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/functional-equation-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
