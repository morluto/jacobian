                "body": {
                  "additionalProperties": false,
                  "properties": {
                    "antecedent": {
                      "const": "a_plus_b_equals_k_squared"
                    },
                    "consequent": {
                      "const": "k_between_declared_bounds"
                    },
                    "operator": {
