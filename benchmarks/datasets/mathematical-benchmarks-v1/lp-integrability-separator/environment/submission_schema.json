{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "beta": {
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
          "type": "string"
        },
        "critical_p": {
          "const": "2"
        },
        "infinity_power_coefficient": {
          "const": "-1/2"
        },
        "lower_regime": {
          "const": {
            "obstruction": "INFINITY_POWER_TAIL",
            "p_interval": "0<p<2"
          }
        },
        "origin_power_coefficient": {
          "const": "-1/2"
        },
        "p2_integral_each": {
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
          "type": "string"
        },
        "p2_log_exponent": {
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
          "type": "string"
        },
        "upper_regime": {
          "const": {
            "obstruction": "ORIGIN_POWER_SINGULARITY",
            "p_interval": "p>2"
          }
        }
      },
      "required": [
        "beta",
        "origin_power_coefficient",
        "infinity_power_coefficient",
        "p2_log_exponent",
        "p2_integral_each",
        "critical_p",
        "lower_regime",
        "upper_regime"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
