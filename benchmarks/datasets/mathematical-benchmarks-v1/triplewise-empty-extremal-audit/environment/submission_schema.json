{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "constructions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "family": {
                "items": {
                  "items": {
                    "maximum": 10,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "type": "array"
              },
              "n": {
                "enum": [
                  7,
                  8,
                  11
                ]
              }
            },
            "required": [
              "n",
              "family"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "maximum_formula": {
          "const": "1+n+floor(n/2)"
        },
        "upper_bound_certificate": {
          "additionalProperties": false,
          "properties": {
            "element_frequency_cap": {
              "const": 2
            },
            "nonsingleton_incidence_floor": {
              "const": 2
            },
            "singleton_cap": {
              "const": "n"
            }
          },
          "required": [
            "element_frequency_cap",
            "singleton_cap",
            "nonsingleton_incidence_floor"
          ],
          "type": "object"
        }
      },
      "required": [
        "maximum_formula",
        "upper_bound_certificate",
        "constructions"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
