{
  "$defs": {
    "ArtifactStateRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Artifact Uri",
          "type": "string"
        },
        "role": {
          "enum": [
            "MATHEMATICAL_RESULT",
            "OBLIGATION",
            "SCOPE",
            "VERIFICATION_RECORD"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_capability_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Capability Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_uri",
        "role",
        "source_capability_id"
      ],
      "title": "ArtifactStateRef",
      "type": "object"
    },
    "BindingValidity": {
      "enum": [
        "UNKNOWN",
        "VALID",
        "INVALID"
      ],
      "title": "BindingValidity",
      "type": "string"
    },
    "CandidateState": {
      "enum": [
        "ABSENT",
        "PRESENT",
        "REJECTED",
        "CHECKED",
        "VERIFIED"
      ],
      "title": "CandidateState",
      "type": "string"
    },
    "CheckerState": {
      "enum": [
        "NOT_CHECKED",
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "CheckerState",
      "type": "string"
    },
    "CleanRoomTerminalEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_schema_version": {
          "const": "1",
          "default": "1",
          "title": "Evidence Schema Version",
          "type": "string"
        },
        "verifier_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Verifier Digest",
          "type": "string"
        },
        "clean_room": {
          "const": true,
          "title": "Clean Room",
          "type": "boolean"
        },
        "verifier_execution_status": {
          "enum": [
            "COMPLETED",
            "TIMEOUT",
            "CANCELLED",
            "ERROR"
          ],
          "title": "Verifier Execution Status",
          "type": "string"
        },
        "acceptance": {
          "$ref": "#/$defs/TerminalAcceptance"
        },
        "input_binding_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Binding Valid"
        },
        "artifact_binding_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Binding Valid"
        },
        "source_binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Binding Digest",
          "type": "string"
        }
      },
      "required": [
        "verifier_digest",
        "clean_room",
        "verifier_execution_status",
        "acceptance",
        "source_binding_digest"
      ],
      "title": "CleanRoomTerminalEvidence",
      "type": "object"
    },
    "ExtractedTrajectoryState": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "source_event_index": {
          "minimum": 0,
          "title": "Source Event Index",
          "type": "integer"
        },
        "boundary": {
          "$ref": "#/$defs/StateBoundary"
        },
        "hard_state": {
          "$ref": "#/$defs/TrajectoryHardState"
        },
        "soft_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrajectorySoftState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hard_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hard State Digest",
          "type": "string"
        },
        "changed_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changed Fields",
          "type": "array"
        },
        "milestone_kinds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MilestoneKind"
          },
          "title": "Milestone Kinds",
          "type": "array"
        },
        "milestone_eligible": {
          "title": "Milestone Eligible",
          "type": "boolean"
        },
        "milestone_reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Milestone Reason",
          "type": "string"
        }
      },
      "required": [
        "index",
        "source_event_index",
        "boundary",
        "hard_state",
        "hard_state_digest",
        "milestone_eligible",
        "milestone_reason"
      ],
      "title": "ExtractedTrajectoryState",
      "type": "object"
    },
    "MilestoneKind": {
      "enum": [
        "OBJECT_ADDED",
        "ARTIFACT_ADDED",
        "CANDIDATE_PRODUCED",
        "CANDIDATE_REPAIRED",
        "CHECKER_ACCEPTED",
        "CHECKER_REJECTED",
        "OBLIGATION_OPENED",
        "OBLIGATION_DISCHARGED",
        "BINDING_BECAME_VALID",
        "BINDING_BECAME_INVALID",
        "SCOPE_CHANGED",
        "SCOPE_ESCALATION_REJECTED",
        "COMPLETENESS_CHANGED",
        "ASSURANCE_CHANGED"
      ],
      "title": "MilestoneKind",
      "type": "string"
    },
    "ReasoningProtocolState": {
      "enum": [
        "NOT_STARTED",
        "READY",
        "READY_TO_INVOKE",
        "AWAITING_AFTER_TOOL",
        "FINALIZED",
        "INVALID"
      ],
      "title": "ReasoningProtocolState",
      "type": "string"
    },
    "StateBoundary": {
      "enum": [
        "PLAN",
        "TOOL_RESULT",
        "AFTER_TOOL",
        "FINAL",
        "TERMINAL"
      ],
      "title": "StateBoundary",
      "type": "string"
    },
    "TerminalAcceptance": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "INCONCLUSIVE"
      ],
      "title": "TerminalAcceptance",
      "type": "string"
    },
    "TrajectoryHardState": {
      "additionalProperties": false,
      "properties": {
        "state_schema_version": {
          "const": "1",
          "default": "1",
          "title": "State Schema Version",
          "type": "string"
        },
        "task_family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Family",
          "type": "string"
        },
        "typed_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TypedObjectRef"
          },
          "title": "Typed Objects",
          "type": "array"
        },
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactStateRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "candidate_state": {
          "$ref": "#/$defs/CandidateState",
          "default": "ABSENT"
        },
        "latest_candidate_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Candidate Digest"
        },
        "checker_state": {
          "$ref": "#/$defs/CheckerState",
          "default": "NOT_CHECKED"
        },
        "open_obligation_uris": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Open Obligation Uris",
          "type": "array"
        },
        "discharged_obligation_uris": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Discharged Obligation Uris",
          "type": "array"
        },
        "execution_status": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Status"
        },
        "completeness_status": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness Status"
        },
        "completeness_assurance": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness Assurance"
        },
        "assurance_level": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assurance Level"
        },
        "scope_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Digest"
        },
        "scope_escalation_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scope Escalation Errors",
          "type": "array"
        },
        "binding_validity": {
          "$ref": "#/$defs/BindingValidity",
          "default": "UNKNOWN"
        },
        "latest_meaningful_transitions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MilestoneKind"
          },
          "title": "Latest Meaningful Transitions",
          "type": "array"
        },
        "reasoning_protocol_state": {
          "$ref": "#/$defs/ReasoningProtocolState",
          "default": "NOT_STARTED"
        }
      },
      "required": [
        "task_family"
      ],
      "title": "TrajectoryHardState",
      "type": "object"
    },
    "TrajectorySoftState": {
      "additionalProperties": false,
      "description": "Optional model-authored external summaries; never hidden chain-of-thought.",
      "properties": {
        "soft_state_schema_version": {
          "const": "1",
          "default": "1",
          "title": "Soft State Schema Version",
          "type": "string"
        },
        "plan_summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Summary"
        },
        "latest_after_tool_summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest After Tool Summary"
        },
        "final_summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Summary"
        }
      },
      "title": "TrajectorySoftState",
      "type": "object"
    },
    "TypedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "source_capability_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Capability Id",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "content_digest",
        "source_capability_id"
      ],
      "title": "TypedObjectRef",
      "type": "object"
    }
  },
  "$id": "https://jacobian.invalid/docs/reference/evaluations/schemas/trajectory-state-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "extraction_schema_version": {
      "const": "1",
      "default": "1",
      "title": "Extraction Schema Version",
      "type": "string"
    },
    "extractor_id": {
      "const": "jacobian.observable-trajectory-state.v1",
      "default": "jacobian.observable-trajectory-state.v1",
      "title": "Extractor Id",
      "type": "string"
    },
    "source_format": {
      "const": "codex-jsonl",
      "default": "codex-jsonl",
      "title": "Source Format",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "task_family": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Family",
      "type": "string"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/ExtractedTrajectoryState"
      },
      "title": "States",
      "type": "array"
    },
    "terminal_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/CleanRoomTerminalEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assurance_authority": {
      "const": false,
      "default": false,
      "title": "Assurance Authority",
      "type": "boolean"
    }
  },
  "required": [
    "source_digest",
    "task_family",
    "states"
  ],
  "title": "TrajectoryExtraction",
  "type": "object"
}
