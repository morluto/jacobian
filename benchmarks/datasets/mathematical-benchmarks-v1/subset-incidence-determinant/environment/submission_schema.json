{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "diagonal_weights": {
          "items": {
            "enum": [
              -1,
              1
            ]
          },
          "type": "array"
        },
        "general_determinant": {
          "type": "string"
        },
        "general_even_count": {
          "type": "string"
        },
        "mask_order": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sample_n": {
          "type": "integer"
        },
        "trace": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "determinant": {
                "enum": [
                  -1,
                  1
                ]
              },
              "even_nonempty_count": {
                "minimum": 0,
                "type": "integer"
              },
              "n": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "n",
              "even_nonempty_count",
              "determinant"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sample_n",
        "mask_order",
        "diagonal_weights",
        "trace",
        "general_even_count",
        "general_determinant"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
