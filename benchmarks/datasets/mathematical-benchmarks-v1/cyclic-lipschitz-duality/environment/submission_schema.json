{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "dual_value": {
          "const": "15"
        },
        "flow": {
          "items": {
            "type": "string"
          },
          "maxItems": 60,
          "minItems": 60,
          "type": "array"
        },
        "primal_value": {
          "const": "15"
        },
        "sequence": {
          "items": {
            "type": "string"
          },
          "maxItems": 60,
          "minItems": 60,
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "flow",
        "primal_value",
        "dual_value"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
