{
  "evidence": {
    "allowed_paths": [
      "evidence/answer.json"
    ],
    "digest_pattern": "^sha256:[0-9a-f]{64}$",
    "max_items": 1,
    "media_types": [
      "application/json"
    ],
    "min_items": 1,
    "payload_shape": null
  },
  "public_notes": "Exact nonzero-domain audit and repair for one Petersen-graph modular flow only.\n\nThe evidence file must be a JSON object with exactly four fields: `schema_version` must be `\"1\"`, `task_id` must equal the submission task ID, `result` must be an exact JSON copy of `submission.json`'s result object, and `limitations` must be an exact JSON copy of its limitations list.",
  "required_artifact_filenames": [
    "evidence/answer.json"
  ],
  "schema_definitions": {
    "balances": {
      "items": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "flow": {
      "items": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 15,
      "minItems": 15,
      "type": "array"
    }
  },
  "schema_version": "1",
  "submission_path": "/app/submission.json",
  "submission_result": {
    "additionalProperties": false,
    "properties": {
      "flawed_balances": {
        "$ref": "#/$defs/balances"
      },
      "flawed_flow": {
        "$ref": "#/$defs/flow"
      },
      "repair_balances": {
        "$ref": "#/$defs/balances"
      },
      "repair_flow": {
        "$ref": "#/$defs/flow"
      },
      "zero_edge_index": {
        "maximum": 14,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "flawed_flow",
      "flawed_balances",
      "zero_edge_index",
      "repair_flow",
      "repair_balances"
    ],
    "type": "object"
  },
  "submission_schema": {
    "$defs": {
      "balances": {
        "items": {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 10,
        "minItems": 10,
        "type": "array"
      },
      "flow": {
        "items": {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 15,
        "minItems": 15,
        "type": "array"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "result": {
        "additionalProperties": false,
        "properties": {
          "flawed_balances": {
            "$ref": "#/$defs/balances"
          },
          "flawed_flow": {
            "$ref": "#/$defs/flow"
          },
          "repair_balances": {
            "$ref": "#/$defs/balances"
          },
          "repair_flow": {
            "$ref": "#/$defs/flow"
          },
          "zero_edge_index": {
            "maximum": 14,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "flawed_flow",
          "flawed_balances",
          "zero_edge_index",
          "repair_flow",
          "repair_balances"
        ],
        "type": "object"
      },
      "witness": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "evidence/answer.json"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "maxItems": 1,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "result",
      "witness"
    ],
    "type": "object"
  },
  "task_id": "jacobian/tutte-flow-domain-audit"
}
