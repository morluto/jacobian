{
  "$defs": {
    "radical": {
      "items": {
        "$ref": "#/$defs/rational"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "rational": {
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "corrected_mahler_measure": {
          "$ref": "#/$defs/radical"
        },
        "factors": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "flawed_monic_result": {
          "$ref": "#/$defs/radical"
        },
        "leading_coefficient": {
          "$ref": "#/$defs/rational"
        },
        "outside_contributions": {
          "items": {
            "$ref": "#/$defs/radical"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "factors",
        "outside_contributions",
        "flawed_monic_result",
        "leading_coefficient",
        "corrected_mahler_measure"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
