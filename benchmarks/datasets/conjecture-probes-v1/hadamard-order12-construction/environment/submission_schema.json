{
  "$defs": {
    "entry_row": {
      "items": {
        "enum": [
          -1,
          1
        ]
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "integer_row": {
      "items": {
        "type": "integer"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "HADAMARD_ORDER12_CONSTRUCTION"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "const": [
        "ORDER_12_ONLY",
        "NO_GENERAL_HADAMARD_CONJECTURE_CONCLUSION"
      ]
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "determinant": {
          "type": "integer"
        },
        "determinant_abs": {
          "const": 2985984
        },
        "gram": {
          "items": {
            "$ref": "#/$defs/integer_row"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "matrix": {
          "items": {
            "$ref": "#/$defs/entry_row"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "scope_identity": {
          "const": "hadamard-order12-construction:normalized-v1"
        }
      },
      "required": [
        "matrix",
        "gram",
        "determinant",
        "determinant_abs",
        "scope_identity"
      ],
      "type": "object"
    },
    "scope": {
      "const": "hadamard-order12-construction:normalized-v1",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/hadamard-order12-construction"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
