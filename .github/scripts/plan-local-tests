#!/usr/bin/env python3
"""Print the CI lanes and local commands implied by repository changes."""

from __future__ import annotations

import argparse
import ast
import fnmatch
import json
import shlex
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

ROOT = Path(__file__).resolve().parents[2]
CLASSIFIER = ROOT / ".github" / "scripts" / "classify-ci-paths"
OWNERSHIP = ROOT / ".github" / "local-test-ownership.json"

COMMANDS = {
    "unit": ("make test-unit",),
    "component": ("make test-component",),
    "domain": ("make test-domain",),
    "composition": ("make test-composition",),
    "storage": ("make test-storage",),
    "process": ("make test-process",),
    "mcp": ("make test-mcp",),
    "provider": ("make test-provider",),
    "e2e": ("make test-e2e",),
    "lean": ("make test-lean",),
    "npm": ("make npm-test",),
    "static": ("make check-static",),
    "build": ("make build",),
    "security": ("make security-audit",),
    "duplicate": ("make duplicate-code",),
    "docs": ("make docs-linkcheck",),
}

TOPOLOGY_LANES = (
    "unit",
    "component",
    "domain",
    "composition",
    "storage",
    "process",
    "mcp",
    "provider",
    "lean",
    "e2e",
)

HIGH_IMPACT_PATHS = {
    "src/jacobian/__init__.py",
    "tests/conftest.py",
    "pyproject.toml",
    "uv.lock",
}


class Change(NamedTuple):
    status: str
    path: str


def git_paths(*args: str) -> list[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    return [path for path in result.stdout.splitlines() if path]


def git_changes(*args: str) -> list[Change]:
    result = subprocess.run(
        ["git", *args],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    changes: list[Change] = []
    for line in result.stdout.splitlines():
        status, *paths = line.split("\t")
        if not paths:
            continue
        # A rename/copy has two paths. Retain both and its non-exact status so
        # focused selection fails closed even when only one side still exists.
        changes.extend(Change(status[0], path) for path in paths)
    return changes


def changed_entries(base: str) -> list[Change]:
    subprocess.run(
        ["git", "rev-parse", "--verify", f"{base}^{{commit}}"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    )
    entries = {
        *git_changes("diff", "--name-status", f"{base}..HEAD"),
        *git_changes("diff", "--name-status"),
        *git_changes("diff", "--cached", "--name-status"),
        *(
            Change("?", path)
            for path in git_paths("ls-files", "--others", "--exclude-standard")
        ),
    }
    return sorted(entries, key=lambda entry: (entry.path, entry.status))


def source_module(path: str) -> str | None:
    source = Path(path)
    try:
        relative = source.relative_to("src")
    except ValueError:
        return None
    if relative.suffix != ".py":
        return None
    parts = list(relative.with_suffix("").parts)
    if parts[-1] == "__init__":
        parts.pop()
    return ".".join(parts)


def imports(path: Path) -> set[str] | None:
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    except (OSError, SyntaxError, UnicodeError):
        return None
    imported: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imported.update(alias.name for alias in node.names)
        elif isinstance(node, ast.ImportFrom):
            module = node.module
            if node.level:
                try:
                    relative = path.relative_to(ROOT / "src")
                except ValueError:
                    continue
                module_parts = list(relative.with_suffix("").parts)
                # Relative imports are resolved from the containing package.
                # For __init__.py that package is still its parent directory;
                # retaining "__init__" would invent modules such as
                # jacobian.pkg.__init__.leaf.
                package_parts = module_parts[:-1]
                drop = node.level - 1
                if drop > len(package_parts):
                    return None
                resolved = package_parts[: len(package_parts) - drop]
                if module:
                    resolved.extend(module.split("."))
                module = ".".join(resolved)
            if module:
                imported.add(module)
                imported.update(
                    f"{module}.{alias.name}"
                    for alias in node.names
                    if alias.name != "*"
                )
    return imported


def directly_imports(imported: set[str], module: str) -> bool:
    return any(
        imported_module == module or imported_module.startswith(f"{module}.")
        for imported_module in imported
    )


def test_files() -> list[Path]:
    return sorted((ROOT / "tests").rglob("test_*.py"))


def source_files() -> list[Path]:
    return sorted((ROOT / "src").rglob("*.py"))


def ownership_overrides() -> dict[str, list[str]] | None:
    try:
        data = json.loads(OWNERSHIP.read_text(encoding="utf-8"))
        mappings = data["overrides"]
        if (
            data.get("version") != 1
            or not isinstance(mappings, dict)
            or not all(
                isinstance(pattern, str)
                and isinstance(nodes, list)
                and nodes
                and all(isinstance(node, str) for node in nodes)
                for pattern, nodes in mappings.items()
            )
        ):
            return None
        return mappings
    except FileNotFoundError:
        return {}
    except (KeyError, OSError, TypeError, ValueError):
        return None


def exact_tests(entries: list[Change]) -> tuple[list[str], str | None]:
    """Return focused pytest selectors, or a reason selection is ambiguous."""
    if not entries:
        return [], None
    overrides = ownership_overrides()
    if overrides is None:
        return [], ".github/local-test-ownership.json: invalid manifest"
    selected: set[str] = set()
    parsed_tests: dict[Path, set[str]] = {}
    parsed_sources: dict[Path, set[str]] = {}

    for entry in entries:
        path = entry.path
        if entry.status not in {"A", "M"}:
            return [], f"{path}: {entry.status} changes are not exact"
        override_nodes = {
            node
            for pattern, nodes in overrides.items()
            if fnmatch.fnmatchcase(path, pattern)
            for node in nodes
        }
        if override_nodes:
            if any(
                not node.startswith("tests/")
                or not (ROOT / node.split("::", 1)[0]).is_file()
                for node in override_nodes
            ):
                return [], f"{path}: ownership override is not a test selector"
            selected.update(override_nodes)
            continue

        if (
            path in HIGH_IMPACT_PATHS
            or path.startswith(".github/")
            or path.endswith("/conftest.py")
        ):
            return [], f"{path}: shared infrastructure has broad impact"

        if path.startswith("tests/") and path.endswith(".py"):
            if Path(path).name.startswith("test_"):
                selected.add(path)
                continue
            return [], f"{path}: test support code has broad impact"

        module = source_module(path)
        if module is None:
            return [], f"{path}: no exact Python ownership evidence"

        source_path = ROOT / path
        if not source_path.is_file():
            return [], f"{path}: source is unavailable"

        for candidate in source_files():
            if candidate == source_path:
                continue
            imported = parsed_sources.get(candidate)
            if imported is None:
                imported = imports(candidate)
                if imported is None:
                    return [], f"{candidate.relative_to(ROOT)}: import scan failed"
                parsed_sources[candidate] = imported
            if directly_imports(imported, module):
                return [], (
                    f"{path}: imported by {candidate.relative_to(ROOT)}; "
                    "transitive impact is ambiguous"
                )

        direct = set()
        for candidate in test_files():
            imported = parsed_tests.get(candidate)
            if imported is None:
                imported = imports(candidate)
                if imported is None:
                    return [], f"{candidate.relative_to(ROOT)}: import scan failed"
                parsed_tests[candidate] = imported
            if directly_imports(imported, module):
                direct.add(candidate.relative_to(ROOT).as_posix())
        if not direct:
            return [], f"{path}: no direct importing tests"
        selected.update(direct)

    return sorted(selected), None


def focused_commands(tests: list[str]) -> list[str]:
    grouped: dict[str, list[str]] = {lane: [] for lane in TOPOLOGY_LANES}
    for test in tests:
        path = test.split("::", 1)[0]
        lane = _lane_for_path(path)
        if lane is None:
            # An exact node without a topology owner is unsafe to run narrowly.
            return []
        grouped[lane].append(test)
    return [
        f"make test-{lane} TESTS={shlex.quote(' '.join(selectors))}"
        for lane in TOPOLOGY_LANES
        if (selectors := grouped[lane])
    ]


def _lane_for_path(path: str) -> str | None:
    """Resolve one test path against the checked-in topology manifest."""

    manifest = ROOT / "tests" / "topology.toml"
    if not manifest.is_file():
        return None
    try:
        import tomllib

        raw = tomllib.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    lanes = raw.get("lanes", [])
    if not isinstance(lanes, list):
        return None
    normalized = path.replace("\\", "/")
    matches: list[str] = []

    def matches_pattern(pattern: str) -> bool:
        """Apply topology directory and glob ownership semantics."""

        pattern = pattern.replace("\\", "/")
        if fnmatch.fnmatchcase(normalized, pattern):
            return True
        if pattern.endswith("/**"):
            prefix = pattern[:-3].rstrip("/")
            return normalized == prefix or normalized.startswith(prefix + "/")
        if not any(char in pattern for char in "*?["):
            return normalized == pattern or normalized.startswith(
                pattern.rstrip("/") + "/"
            )
        return False

    for lane in lanes:
        if not isinstance(lane, dict) or not isinstance(lane.get("name"), str):
            continue
        paths = lane.get("paths", [])
        if not isinstance(paths, list):
            continue
        for pattern in paths:
            if not isinstance(pattern, str):
                continue
            if matches_pattern(pattern):
                matches.append(lane["name"])
                break
    return matches[0] if len(matches) == 1 else None


def _command_arguments(command: str) -> list[str]:
    """Convert a displayed make command into an executable argv."""

    return shlex.split(command)


def execute_commands(commands: list[str]) -> int:
    """Execute planner output in fresh make invocations and retain failures."""

    status = 0
    for command in commands:
        completed = subprocess.run(_command_arguments(command), cwd=ROOT, check=False)
        if completed.returncode and status == 0:
            status = completed.returncode
    return status


def classify(paths: list[str]) -> dict[str, str]:
    if not paths:
        return {"classification": "clean"}
    result = subprocess.run(
        [sys.executable, str(CLASSIFIER), "--", *paths],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    return dict(line.split("=", 1) for line in result.stdout.splitlines())


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--base", required=True, help="Base commit or ref.")
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Execute the exact selectors or fail-closed lane commands.",
    )
    args = parser.parse_args()

    try:
        entries = changed_entries(args.base)
    except subprocess.CalledProcessError:
        parser.error(f"base is not a commit: {args.base}")
    paths = sorted({entry.path for entry in entries})
    plan = classify(paths)
    lanes = [suite for suite in COMMANDS if plan.get(f"run-{suite}") == "true"]
    tests, fallback = exact_tests(entries)

    print(f"base: {args.base}")
    print(f"classification: {plan['classification']}")
    print("paths:")
    for path in paths:
        print(f"  {path}")
    print("lanes:")
    for lane in lanes:
        print(f"  {lane}")
    print("selection:")
    if tests:
        print("  focused")
        for test in tests:
            print(f"  {test}")
    elif fallback:
        print(f"  suite fallback ({fallback})")
    else:
        print("  none")
    print("commands:")
    focused_lanes = set(TOPOLOGY_LANES) if tests else set()
    for command in focused_commands(tests):
        print(f"  {command}")
    for lane in lanes:
        if lane in focused_lanes:
            continue
        for command in COMMANDS[lane]:
            print(f"  {command}")

    if args.execute:
        if tests:
            commands = focused_commands(tests)
            if not commands:
                print(
                    "cannot execute: selected tests have no unique topology lane",
                    file=sys.stderr,
                )
                raise SystemExit(2)
        elif fallback:
            commands = [command for lane in lanes for command in COMMANDS[lane]]
        else:
            commands = []
        raise SystemExit(execute_commands(commands))


if __name__ == "__main__":
    main()
