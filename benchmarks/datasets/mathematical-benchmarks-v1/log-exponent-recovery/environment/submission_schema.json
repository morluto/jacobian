{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "reciprocal_log_contributions": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "string"
            },
            "xyz": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "z": {
              "type": "string"
            }
          },
          "required": [
            "x",
            "y",
            "z",
            "xyz"
          ],
          "type": "object"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "value",
        "reciprocal_log_contributions"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
