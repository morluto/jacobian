{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "FALLBACK_ZERO_CERTIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "block_sum_power_lower_bound": {
                "type": "integer"
              },
              "level": {
                "type": "integer"
              },
              "term_count": {
                "type": "integer"
              },
              "upper_power_of_two": {
                "type": "integer"
              }
            },
            "required": [
              "level",
              "term_count",
              "upper_power_of_two",
              "block_sum_power_lower_bound"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "critical_line_relation": {
          "const": "REAL_PART_NOT_ONE_HALF"
        },
        "general_block_power_exponent": {
          "additionalProperties": false,
          "properties": {
            "constant": {
              "type": "integer"
            },
            "level_coefficient": {
              "type": "integer"
            }
          },
          "required": [
            "level_coefficient",
            "constant"
          ],
          "type": "object"
        },
        "real_part": {
          "type": "string"
        },
        "reciprocal_denominator": {
          "maximum": 7,
          "minimum": 3,
          "type": "integer"
        },
        "returned_value": {
          "const": 0
        },
        "summability_status": {
          "const": "DIVERGENT"
        },
        "zero_classification": {
          "const": "FALLBACK_ARTIFACT"
        }
      },
      "required": [
        "reciprocal_denominator",
        "real_part",
        "general_block_power_exponent",
        "blocks",
        "summability_status",
        "returned_value",
        "zero_classification",
        "critical_line_relation"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/series-domain-junk-zero"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
