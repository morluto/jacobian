{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "basis_order": {
          "items": false,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "HD"
            },
            {
              "const": "SUB_RECOVERY"
            }
          ],
          "type": "array"
        },
        "derived_coefficients": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "failed_pattern_occurs": {
          "type": "boolean"
        },
        "multipliers": {
          "items": false,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "type": "array"
        },
        "side_condition_used": {
          "const": "b<=a"
        }
      },
      "required": [
        "failed_pattern_occurs",
        "basis_order",
        "multipliers",
        "derived_coefficients",
        "side_condition_used"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
