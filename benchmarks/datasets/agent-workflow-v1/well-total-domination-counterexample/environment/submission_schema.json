{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "FALSE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "average_degree": {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "minimum": 1,
              "type": "integer"
            },
            "numerator": {
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "connected": {
          "const": true
        },
        "degree_sum": {
          "minimum": 0,
          "type": "integer"
        },
        "hypothesis_holds": {
          "const": true
        },
        "minimal_total_dominating_sets": {
          "items": {
            "items": {
              "type": [
                "string",
                "integer"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "pendant_vertices": {
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "well_totally_dominated": {
          "const": false
        }
      },
      "required": [
        "connected",
        "degree_sum",
        "average_degree",
        "pendant_vertices",
        "hypothesis_holds",
        "minimal_total_dominating_sets",
        "well_totally_dominated"
      ],
      "type": "object"
    },
    "scope": {
      "const": "jacobian/well-total-domination-counterexample supplied five-vertex graph",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/well-total-domination-counterexample"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
