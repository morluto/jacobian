{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "exact_even_fixed_histogram": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "inclusion_sum": {
          "minimum": 1,
          "type": "integer"
        },
        "signed_inclusion_terms": {
          "items": {
            "type": "integer"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "signed_inclusion_terms",
        "inclusion_sum",
        "exact_even_fixed_histogram"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
