            },
            "maxItems": 8,
            "minItems": 2,
            "type": "array"
          },
          "proposed_truth": {
            "type": "boolean"
          }
        },
        "required": [
          "limsup_values",
          "intended_truth",
          "proposed_truth",
          "distinguishing_index"
        ],
        "type": "object"
      }
