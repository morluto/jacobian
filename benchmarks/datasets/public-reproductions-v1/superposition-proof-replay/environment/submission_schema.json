{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "axioms": {
          "items": {
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "root": {
          "const": 7
        },
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "child": {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              },
              "parents": {
                "items": {
                  "maximum": 8,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "child",
              "parents"
            ],
            "type": "object"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "axioms",
        "steps",
        "root"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/resolution-proof.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
