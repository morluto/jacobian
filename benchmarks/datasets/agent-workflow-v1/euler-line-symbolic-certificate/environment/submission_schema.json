{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficient", "exponents"],
      "properties": {
        "coefficient": {"type": "string"},
        "exponents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        }
      }
    },
    "rational_function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/term"}
        },
        "denominator": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/term"}
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"$ref": "#/$defs/rational_function"},
        "y": {"$ref": "#/$defs/rational_function"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/euler-line-symbolic-certificate"},
    "conclusion": {"const": "TRUE"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates", "relation_coefficients"],
      "properties": {
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["O", "G", "H"],
          "properties": {
            "O": {"$ref": "#/$defs/point"},
            "G": {"$ref": "#/$defs/point"},
            "H": {"$ref": "#/$defs/point"}
          }
        },
        "relation_coefficients": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string"}
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED", "CHECKED"]},
    "scope": {"const": "euler-line-symbolic-certificate exact normalized rational-function identities"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
