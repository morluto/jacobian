{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "expected_value": {
          "description": "The expectation of (f(f(x))-x)^2 over ordered x and f",
          "type": "string"
        },
        "ordered_squared_difference_sum": {
          "minimum": 0,
          "type": "integer"
        },
        "other_hit_probability": {
          "description": "P(f(f(x))=y) for one fixed y != x",
          "type": "string"
        },
        "self_hit_probability": {
          "description": "P(f(f(x))=x) for a fixed x",
          "type": "string"
        }
      },
      "required": [
        "self_hit_probability",
        "other_hit_probability",
        "ordered_squared_difference_sum",
        "expected_value"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
