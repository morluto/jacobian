{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "additionalProperties": false,
          "properties": {
            "den": {
              "minimum": 1,
              "type": "integer"
            },
            "num": {
              "type": "integer"
            }
          },
          "required": [
            "num",
            "den"
          ],
          "type": "object"
        },
        "states": {
          "type": "integer"
        }
      },
      "required": [
        "probability",
        "states"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
