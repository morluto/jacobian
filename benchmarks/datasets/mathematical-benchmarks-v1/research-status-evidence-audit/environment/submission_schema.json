{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "MIXED_STATUS_EVIDENCE_QUALITY"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "case_id": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "RESOLVED_BY_CITED_WORK",
                  "PARTIAL_PROGRESS_NO_FULL_RESOLUTION",
                  "HISTORICALLY_OPEN_CURRENT_STATUS_NOT_ESTABLISHED",
                  "PROBLEM_LISTED_STATUS_UNSUPPORTED"
                ]
              },
              "selected_evidence_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "unsupported_inferences": {
                "items": {
                  "enum": [
                    "NEGATIVE_SEARCH_PROVES_CURRENT_STATUS",
                    "HISTORICAL_OPENNESS_PROVES_2026_OPENNESS",
                    "RESOLVED_RANGES_CHARACTERIZED_AS_SMALL_AND_SUFFICIENTLY_LARGE"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "case_id",
              "classification",
              "selected_evidence_ids",
              "unsupported_inferences"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/research-status-evidence-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
