{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/jcb-postdoc-016"},
    "conclusion": {"const": "NO_GLOBAL_CONCLUSION"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_path", "checked_values", "checked_triple_starts", "bounded_reference_replayed", "global_conjecture_status"],
      "properties": {
        "evidence_path": {"const": "evidence/powerful-window.json"},
        "checked_values": {"const": ["8", "9", "10", "11", "12", "13", "14", "15", "16"]},
        "checked_triple_starts": {"const": ["8", "9", "10", "11", "12", "13", "14"]},
        "bounded_reference_replayed": {"const": false},
        "global_conjecture_status": {"const": "OPEN"}
      }
    },
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "jacobian/jcb-postdoc-016 exact values 8 through 16 and seven consecutive triples; public 10^14 reference not replayed"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/powerful-window.json"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"const": ["PUBLIC_10E14_ARTIFACT_NOT_REPLAYED", "FINITE_WINDOW_DOES_NOT_PROVE_UNBOUNDED_CONJECTURE"]}
  }
}
