{
  "$defs": {
    "model": {
      "additionalProperties": false,
      "properties": {
        "distinguishing_index": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        "intended_truth": {
          "type": "boolean"
        },
        "limsup_values": {
          "items": {
            "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "proposed_truth": {
          "type": "boolean"
        }
      },
      "required": [
        "limsup_values",
        "intended_truth",
        "proposed_truth",
        "distinguishing_index"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "FORMULAS_NOT_EQUIVALENT",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "intended_only_model": {
          "$ref": "#/$defs/model"
        },
        "proposed_only_model": {
          "$ref": "#/$defs/model"
        },
        "relationship": {
          "const": "INCOMPARABLE"
        }
      },
      "required": [
        "relationship",
        "intended_only_model",
        "proposed_only_model"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/limsup-quantifier-alignment"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
