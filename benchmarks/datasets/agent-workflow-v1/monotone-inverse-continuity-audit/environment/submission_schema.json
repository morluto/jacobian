{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "CONTINUITY_IS_NECESSARY"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "const": "The certificate covers only the declared piecewise rational family and does not machine-check the source Lean declaration."
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "gap_witness": {
          "type": "string"
        },
        "jump": {
          "type": "string"
        },
        "left_endpoint_value": {
          "type": "string"
        },
        "left_limit": {
          "type": "string"
        },
        "left_slope": {
          "type": "string"
        },
        "offset": {
          "type": "string"
        },
        "right_breakpoint_value": {
          "type": "string"
        },
        "right_endpoint_value": {
          "type": "string"
        },
        "right_slope": {
          "type": "string"
        }
      },
      "required": [
        "left_slope",
        "right_slope",
        "offset",
        "jump",
        "left_endpoint_value",
        "left_limit",
        "right_breakpoint_value",
        "right_endpoint_value",
        "gap_witness"
      ],
      "type": "object"
    },
    "scope": {
      "const": "DECLARED_PIECEWISE_RATIONAL_FAMILY_ON_CLOSED_INTERVAL",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/monotone-inverse-continuity-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
