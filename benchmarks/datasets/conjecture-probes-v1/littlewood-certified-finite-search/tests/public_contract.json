{
  "witness": {
    "allowed_paths": [
      "evidence/answer.txt"
    ],
    "digest_pattern": "^sha256:[0-9a-f]{64}$",
    "max_items": 1,
    "media_types": [
      "application/json"
    ],
    "min_items": 1,
    "payload_shape": null
  },
  "public_notes": "The verifier replays the task-specific mathematical predicate from the submitted result and validates the declared task-specific witness.",
  "required_witness_filenames": [
    "evidence/answer.txt"
  ],
  "schema_definitions": {
    "rat": {
      "pattern": "^[0-9]+(?:/[1-9][0-9]*)?$",
      "type": "string"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "floors": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "lower": {
          "$ref": "#/$defs/rat"
        },
        "n": {
          "maximum": 2000,
          "minimum": 1,
          "type": "integer"
        },
        "nearest": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "upper": {
          "$ref": "#/$defs/rat"
        }
      },
      "required": [
        "n",
        "floors",
        "nearest",
        "lower",
        "upper"
      ],
      "type": "object"
    }
  },
  "schema_version": "1",
  "submission_path": "/app/submission.json",
  "submission_result": {
    "additionalProperties": false,
    "properties": {
      "argmin_n": {
        "maximum": 2000,
        "minimum": 1,
        "type": "integer"
      },
      "comparison_status": {
        "const": "STRICTLY_SEPARATED_INTERVALS"
      },
      "minimum_lower": {
        "$ref": "#/$defs/rat"
      },
      "minimum_upper": {
        "$ref": "#/$defs/rat"
      },
      "records": {
        "items": {
          "$ref": "#/$defs/record"
        },
        "maxItems": 100,
        "minItems": 2,
        "type": "array"
      }
    },
    "required": [
      "records",
      "argmin_n",
      "minimum_lower",
      "minimum_upper",
      "comparison_status"
    ],
    "type": "object"
  },
  "submission_schema": {
