{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/random-function-expectation-audit"},
    "conclusion": {"enum": ["TRUE", "FALSE"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_hit_probability", "other_hit_probability", "ordered_squared_difference_sum", "expected_value"],
      "additionalProperties": false,
      "properties": {
        "self_hit_probability": {"type": "string", "description": "P(f(f(x))=x) for a fixed x"},
        "other_hit_probability": {"type": "string", "description": "P(f(f(x))=y) for one fixed y != x"},
        "ordered_squared_difference_sum": {"type": "integer", "minimum": 0},
        "expected_value": {"type": "string", "description": "The expectation of (f(f(x))-x)^2 over ordered x and f"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED","COMPUTED"]},
    "scope": {"const": "random-function-expectation-audit exact finite expectation"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1,"maxItems":1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
