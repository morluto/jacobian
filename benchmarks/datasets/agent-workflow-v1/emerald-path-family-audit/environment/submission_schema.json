{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "PUBLISHED_SINGLETON_CLASSIFICATION_IS_FALSE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "type": "string"
        },
        "beta": {
          "type": "string"
        },
        "even_offset": {
          "type": "string"
        },
        "odd_offset": {
          "type": "string"
        },
        "trace": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "floor": {
                "type": "integer"
              },
              "n": {
                "type": "integer"
              },
              "value": {
                "type": "string"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "n",
              "x",
              "y",
              "value",
              "floor"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "alpha",
        "beta",
        "even_offset",
        "odd_offset",
        "trace"
      ],
      "type": "object"
    },
    "scope": {
      "const": "PROOFBENCH_APMO_2025_2_CONSTRUCTIVE_SUFFICIENCY_AUDIT",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/emerald-path-family-audit"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
