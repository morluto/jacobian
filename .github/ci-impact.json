{
  "version": 2,
  "suites": [
    "unit",
    "component",
    "domain",
    "composition",
    "storage",
    "process",
    "mcp",
    "provider",
    "lean",
    "e2e",
    "npm",
    "static",
    "build",
    "security",
    "duplicate",
    "docs"
  ],
  "catalog": {
    "unit": {
      "command": "make test-unit",
      "topology_lane": "unit"
    },
    "component": {
      "command": "make test-component",
      "topology_lane": "component",
      "matrix": true
    },
    "domain": {
      "command": "make test-domain",
      "topology_lane": "domain"
    },
    "composition": {
      "command": "make test-composition",
      "topology_lane": "composition"
    },
    "storage": {
      "command": "make test-storage",
      "topology_lane": "storage",
      "matrix": true
    },
    "process": {
      "command": "make test-process",
      "topology_lane": "process"
    },
    "mcp": {
      "command": "make test-mcp",
      "topology_lane": "mcp",
      "matrix": true
    },
    "provider": {
      "command": "make test-provider",
      "topology_lane": "provider",
      "matrix": true,
      "providers": [
        "cvc5",
        "external_sat",
        "flint",
        "graph",
        "sympy"
      ]
    },
    "lean": {
      "command": "make test-lean",
      "topology_lane": "lean"
    },
    "e2e": {
      "command": "make test-e2e",
      "topology_lane": "e2e",
      "matrix": true
    },
    "npm": {
      "command": "make npm-test",
      "topology_lane": null,
      "local_gate": true
    },
    "static": {
      "command": "make check-static",
      "topology_lane": null,
      "local_subsumes": [
        "build"
      ],
      "local_gate": true
    },
    "build": {
      "command": "make build",
      "topology_lane": null
    },
    "security": {
      "command": "make security-audit",
      "topology_lane": null
    },
    "duplicate": {
      "command": "make duplicate-code",
      "topology_lane": null
    },
    "docs": {
      "command": "make docs-linkcheck",
      "topology_lane": null,
      "local_gate": true
    },
    "deploy": {
      "command": "make deploy-check",
      "topology_lane": null,
      "local_only": true
    }
  },
  "rules": [
    {
      "name": "documentation",
      "patterns": [
        "docs/**",
        "*.md",
        ".github/ISSUE_TEMPLATE/**",
        ".github/CODEOWNERS"
      ],
      "suites": [
        "docs"
      ]
    },
    {
      "name": "deployment",
      "patterns": [
        "deploy/**"
      ],
      "suites": [
        "process"
      ]
    },
    {
      "name": "npm-package",
      "patterns": [
        "npm/**"
      ],
      "suites": [
        "npm"
      ]
    },
    {
      "name": "lean-runtime",
      "patterns": [
        "lean/**"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "optional-provider-sources",
      "patterns": [
        "src/jacobian/provider_runtime.py",
        "src/jacobian/**/*provider*.py",
        "src/jacobian/cvc5*.py",
        "src/jacobian/flint*.py",
        "src/jacobian/**/*cvc5*.py",
        "src/jacobian/**/*flint*.py"
      ],
      "suites": [
        "provider"
      ]
    },
    {
      "name": "verification-boundary",
      "patterns": [
        "src/jacobian/runtime/**",
        "src/jacobian/installation/**",
        "src/jacobian/portfolio/**",
        "src/jacobian/providers/**",
        "src/jacobian/artifacts.py",
        "src/jacobian/checker_artifacts.py",
        "src/jacobian/registry.py",
        "src/jacobian/schema_registry.py",
        "src/jacobian/plugins/registry.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "lean-python-adapter",
      "patterns": [
        "src/jacobian/lean*.py",
        "src/jacobian/**/*lean*.py",
        "src/jacobian_checkers/lean4.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "static",
        "build"
      ]
    },
    {
      "name": "lean-shared-contracts",
      "patterns": [
        "src/jacobian/contracts/capabilities.py",
        "src/jacobian/contracts/checkers.py",
        "src/jacobian/contracts/common.py",
        "src/jacobian/contracts/evidence.py",
        "src/jacobian/contracts/plugins.py",
        "src/jacobian/contracts/results.py",
        "src/jacobian/contracts/verification.py"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "npm-facing-adapter",
      "patterns": [
        "src/jacobian/adapters/mcp/**"
      ],
      "suites": [
        "unit",
        "component",
        "mcp",
        "e2e",
        "npm",
        "static",
        "build"
      ],
      "suppresses": [
        "python-source"
      ]
    },
    {
      "name": "domain-mathematical-sources",
      "patterns": [
        "src/jacobian/domains/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "static",
        "build"
      ],
      "suppresses": [
        "python-source"
      ]
    },
    {
      "name": "python-source",
      "patterns": [
        "src/jacobian/**",
        "src/jacobian_checkers/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-automation",
      "patterns": [
        ".github/actions/**",
        ".github/workflows/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-planning-tools",
      "patterns": [
        ".github/scripts/_ci_paths.py",
        ".github/scripts/classify-ci-paths",
        ".github/scripts/emit-plan-receipt",
        ".github/scripts/normalize-ci-paths",
        ".github/scripts/plan-local-tests",
        ".github/scripts/validate-ci-plan",
        "tools/test_plan/**",
        "tools/inventory_test_runtime.py"
      ],
      "suites": [
        "unit",
        "process",
        "static",
        "build"
      ],
      "suppresses": [
        "ci-scripts"
      ]
    },
    {
      "name": "benchmark-ci-automation",
      "patterns": [
        ".github/scripts/_ci_paths.py",
        ".github/scripts/plan-benchmarks",
        ".github/scripts/validate-benchmark-plan",
        ".github/workflows/benchmarks.yml"
      ],
      "suites": [
        "unit",
        "process",
        "static",
        "build"
      ],
      "suppresses": [
        "ci-scripts",
        "ci-automation"
      ]
    },
    {
      "name": "ci-scripts",
      "patterns": [
        ".github/scripts/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-plan-config",
      "patterns": [
        ".github/ci-impact.json",
        ".github/ci-config.json",
        "tests/plan_manifest.toml"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "topology-runner-tool",
      "patterns": [
        "tools/test_topology.py"
      ],
      "suites": [
        "unit",
        "process",
        "static",
        "build"
      ],
      "suppresses": [
        "test-topology-runners"
      ]
    },
    {
      "name": "documentation-command-tool",
      "patterns": [
        "tools/check_doc_commands.py"
      ],
      "suites": [
        "unit",
        "static",
        "build",
        "docs"
      ],
      "suppresses": [
        "test-topology-runners"
      ]
    },
    {
      "name": "benchmark-static-tool",
      "patterns": [
        "tools/check_benchmark_static.py"
      ],
      "suites": [
        "static",
        "build"
      ],
      "suppresses": [
        "test-topology-runners"
      ]
    },
    {
      "name": "test-topology-runners",
      "patterns": [
        "tools/**",
        "tests/topology.toml"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "makefile",
      "patterns": [
        "Makefile",
        "make/**"
      ],
      "suites": [
        "static",
        "build"
      ]
    },
    {
      "name": "python-packaging",
      "patterns": [
        "pyproject.toml",
        "uv.lock"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "pre-commit",
      "patterns": [
        ".pre-commit-config.yaml"
      ],
      "suites": [
        "static"
      ]
    },
    {
      "name": "duplicate-code-policy",
      "patterns": [
        ".jscpd.json"
      ],
      "suites": [
        "duplicate"
      ]
    },
    {
      "name": "generic-test-support",
      "patterns": [
        "tests/support/__init__.py",
        "tests/support/runtime_templates.py",
        "tests/support/runtime_instances.py",
        "tests/support/runtime_profiles.py",
        "tests/support/complete_runtime_fixtures.py",
        "tests/support/resource_contracts.py",
        "tests/support/resource_closure_plugin.py",
        "tests/support/exact_domain.py",
        "tests/support/core_capability_harnesses.py",
        "tests/support/mcp_projection_catalog.py",
        "tests/support/process_entrypoints.py",
        "tests/support/search_entrypoints.py",
        "tests/support/conjecture_entrypoints.py",
        "tests/support/shrinking_entrypoints.py",
        "tests/support/plugin_noisy_module.py",
        "tests/support/services.py",
        "tests/support/state.py",
        "tests/support/artifacts.py",
        "tests/support/capabilities.py",
        "tests/support/capability_installations.py",
        "tests/support/nullstellensatz.py",
        "tests/support/polynomials.py",
        "tests/support/mcp.py",
        "tests/conftest.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "provider",
        "e2e",
        "lean",
        "static"
      ]
    },
    {
      "name": "rational-test-support",
      "patterns": [
        "tests/support/rationals.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "provider",
        "e2e",
        "static"
      ]
    },
    {
      "name": "provider-spike-isolation-support",
      "patterns": [
        "tests/composition/runtime/provider_spike_isolation.py"
      ],
      "suites": [
        "composition",
        "static"
      ]
    },
    {
      "name": "lean-readiness-test-support",
      "patterns": [
        "tests/support/provider_lean.py"
      ],
      "suites": [
        "composition",
        "e2e",
        "lean",
        "static"
      ]
    },
    {
      "name": "external-sat-readiness-test-support",
      "patterns": [
        "tests/support/provider_external_sat.py"
      ],
      "suites": [
        "provider",
        "static"
      ]
    },
    {
      "name": "benchmarks",
      "patterns": [
        "benchmarks/**"
      ],
      "suites": []
    },
    {
      "name": "unit-tests",
      "patterns": [
        "tests/unit/**"
      ],
      "suites": [
        "unit",
        "static"
      ]
    },
    {
      "name": "component-tests",
      "patterns": [
        "tests/component/**"
      ],
      "suites": [
        "component",
        "static"
      ]
    },
    {
      "name": "domain-tests",
      "patterns": [
        "tests/domain/**"
      ],
      "suites": [
        "domain",
        "static"
      ]
    },
    {
      "name": "composition-tests",
      "patterns": [
        "tests/composition/**"
      ],
      "suites": [
        "composition",
        "static"
      ]
    },
    {
      "name": "storage-tests",
      "patterns": [
        "tests/boundary/storage/**"
      ],
      "suites": [
        "storage",
        "static"
      ]
    },
    {
      "name": "process-tests",
      "patterns": [
        "tests/boundary/process/**"
      ],
      "suites": [
        "process",
        "static"
      ]
    },
    {
      "name": "mcp-tests",
      "patterns": [
        "tests/boundary/mcp/**"
      ],
      "suites": [
        "mcp",
        "static"
      ]
    },
    {
      "name": "provider-tests",
      "patterns": [
        "tests/boundary/providers/cvc5/**",
        "tests/boundary/providers/external_sat/**",
        "tests/boundary/providers/flint/**",
        "tests/boundary/providers/graph/**",
        "tests/boundary/providers/sympy/**"
      ],
      "suites": [
        "provider",
        "static"
      ]
    },
    {
      "name": "lean-tests",
      "patterns": [
        "tests/boundary/providers/lean/**"
      ],
      "suites": [
        "lean",
        "static"
      ]
    },
    {
      "name": "e2e-tests",
      "patterns": [
        "tests/e2e/**"
      ],
      "suites": [
        "e2e",
        "static"
      ]
    }
  ],
  "fallback": {
    "name": "unclassified-fail-closed",
    "suites": [
      "unit",
      "component",
      "domain",
      "composition",
      "storage",
      "process",
      "mcp",
      "provider",
      "e2e",
      "lean",
      "npm",
      "static",
      "build",
      "security",
      "duplicate",
      "docs"
    ]
  },
  "meta": {
    "generated_from": "tests/plan_manifest.toml",
    "compiler": "tools.test_plan.compile"
  }
}
