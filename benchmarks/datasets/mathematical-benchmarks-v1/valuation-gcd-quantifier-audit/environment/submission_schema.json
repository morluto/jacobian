{
  "$defs": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "countermodel": {
          "$ref": "#/$defs/system"
        },
        "defect": {
          "const": "EXISTS_PRIME_MIN_ZERO_IS_TOO_WEAK"
        },
        "repair": {
          "$ref": "#/$defs/system"
        }
      },
      "required": [
        "defect",
        "countermodel",
        "repair"
      ],
      "type": "object"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "exponents": {
          "items": {
            "maximum": 6,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "prime": {
          "maximum": 97,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "prime",
        "exponents"
      ],
      "type": "object"
    },
    "system": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 8,
      "minItems": 3,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/result"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/valuation-audit.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
