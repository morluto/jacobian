{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "modulus": {
          "const": 7
        },
        "residue_cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "lhs_residue": {
                "minimum": 0,
                "type": "integer"
              },
              "x_cube_residue": {
                "minimum": 0,
                "type": "integer"
              },
              "x_residue": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "x_residue",
              "x_cube_residue",
              "lhs_residue"
            ],
            "type": "object"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "target_residue": {
          "const": 1
        }
      },
      "required": [
        "modulus",
        "target_residue",
        "residue_cases"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
