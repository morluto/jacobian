{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/grounded-premise-proof"},
    "conclusion": {
      "enum": ["QUOTIENT_GROUP_IS_ABELIAN", "PROOF_NOT_FOUND", "UNSUPPORTED"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_premises", "proof_steps", "target_fact"],
      "properties": {
        "selected_premises": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "proof_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rule", "inputs", "output"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
              "rule": {"type": "string"},
              "inputs": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "output": {"type": "string"}
            }
          }
        },
        "target_fact": {"type": "string"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED", "CHECKED", "VERIFIED"]},
    "scope": {
      "const": "grounded premise selection and proof-DAG reconstruction for the frozen quotient-group claim"
    },
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/answer.txt"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
