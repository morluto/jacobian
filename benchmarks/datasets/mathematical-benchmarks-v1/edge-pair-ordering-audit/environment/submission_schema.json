{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "minLength": 1,
          "type": "string"
        },
        "free_edge_factor_exponent": {
          "minLength": 1,
          "type": "string"
        },
        "incident_ordered_pair_factor": {
          "minLength": 1,
          "type": "string"
        },
        "pair_semantics": {
          "enum": [
            "ORDERED",
            "UNORDERED"
          ]
        },
        "probe_values": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "coefficient": {
                "minimum": 1,
                "type": "integer"
              },
              "n": {
                "maximum": 6,
                "minimum": 3,
                "type": "integer"
              }
            },
            "required": [
              "n",
              "coefficient"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "pair_semantics",
        "incident_ordered_pair_factor",
        "free_edge_factor_exponent",
        "formula",
        "probe_values"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
