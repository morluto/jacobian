{
  "$defs": {
    "entry_row": {
      "items": {
        "enum": [
          -1,
          1
        ]
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "integer_row": {
      "items": {
        "type": "integer"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "determinant": {
          "type": "integer"
        },
        "determinant_abs": {
          "const": 2985984
        },
        "gram": {
          "items": {
            "$ref": "#/$defs/integer_row"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "matrix": {
          "items": {
            "$ref": "#/$defs/entry_row"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "scope_identity": {
          "const": "hadamard-order12-construction:normalized-v1"
        }
      },
      "required": [
        "matrix",
        "gram",
        "determinant",
        "determinant_abs",
        "scope_identity"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
