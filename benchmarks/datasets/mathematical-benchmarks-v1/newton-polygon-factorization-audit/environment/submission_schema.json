{
  "$defs": {
    "integer_string": {
      "maxLength": 30,
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "ell": {
          "minimum": 2,
          "type": "integer"
        },
        "factor_left": {
          "items": {
            "$ref": "#/$defs/integer_string"
          },
          "maxItems": 10,
          "minItems": 3,
          "type": "array"
        },
        "factor_right": {
          "items": {
            "$ref": "#/$defs/integer_string"
          },
          "maxItems": 10,
          "minItems": 3,
          "type": "array"
        },
        "j": {
          "minimum": 3,
          "type": "integer"
        },
        "prime": {
          "maximum": 19,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "prime",
        "factor_left",
        "factor_right",
        "ell",
        "j"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
