{
  "$defs": {
    "extended_bound": {
      "oneOf": [
        {
          "const": "NEGATIVE_INFINITY"
        },
        {
          "const": "POSITIVE_INFINITY"
        },
        {
          "$ref": "#/$defs/rational"
        }
      ]
    },
    "rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 1,
          "type": "integer"
        },
        "numerator": {
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "terminal_bound": {
      "additionalProperties": false,
      "properties": {
        "input_lower": {
          "$ref": "#/$defs/extended_bound"
        },
        "input_upper": {
          "$ref": "#/$defs/extended_bound"
        },
        "output_lower": {
          "$ref": "#/$defs/extended_bound"
        },
        "output_upper": {
          "$ref": "#/$defs/extended_bound"
        }
      },
      "required": [
        "input_lower",
        "input_upper",
        "output_lower",
        "output_upper"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "decrement_lower_bound": {
          "$ref": "#/$defs/rational"
        },
        "initial_potential": {
          "minimum": 1,
          "type": "integer"
        },
        "negative_index_upper": {
          "maximum": 2001,
          "minimum": 2,
          "type": "integer"
        },
        "phase_transitions": {
          "maximum": 2001,
          "minimum": 1,
          "type": "integer"
        },
        "potential_identity_coefficients": {
          "items": {
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "terminal_bounds": {
          "items": {
            "$ref": "#/$defs/terminal_bound"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "threshold": {
          "$ref": "#/$defs/rational"
        },
        "threshold_index_upper": {
          "maximum": 2001,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "potential_identity_coefficients",
        "initial_potential",
        "threshold",
        "decrement_lower_bound",
        "phase_transitions",
        "threshold_index_upper",
        "terminal_bounds",
        "negative_index_upper"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/nonlinear-recurrence-certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
