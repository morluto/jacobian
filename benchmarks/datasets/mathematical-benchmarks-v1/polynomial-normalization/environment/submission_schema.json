{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "terms": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "coefficient": {
                "type": "string"
              },
              "exponents": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "coefficient",
              "exponents"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "terms"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
