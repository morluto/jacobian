            ],
            "title": "CapabilityAssuranceLevel",
            "type": "string"
          },
          "CapabilityCompletenessStatus": {
            "description": "How much of the explicitly declared scope an operation covered.",
            "enum": [
              "NOT_APPLICABLE",
              "UNKNOWN",
              "PARTIAL",
              "COMPLETE"
            ],
            "title": "CapabilityCompletenessStatus",
            "type": "string"
          },
          "CapabilityMode": {
            "description": "The low-friction exploration and explicit verification lanes.",
            "enum": [
              "EXPLORE",
              "VERIFY"
            ],
            "title": "CapabilityMode",
            "type": "string"
          },
          "ExecutionStatus": {
            "description": "Operational completion state, independent of mathematical truth.",
            "enum": [
              "COMPLETED",
              "TIMEOUT",
              "CANCELLED",
              "ERROR"
            ],
            "title": "ExecutionStatus",
            "type": "string"
          },
          "ReasoningInterpretationStatus": {
            "description": "Whether the model received enough result content to interpret the call.",
            "enum": [
              "INTERPRETED",
              "RESULT_UNAVAILABLE"
            ],
            "title": "ReasoningInterpretationStatus",
            "type": "string"
          },
          "ReasoningPhase": {
            "enum": [
              "PLAN",
              "BEFORE_TOOL",
              "AFTER_TOOL",
              "FINAL"
            ],
            "title": "ReasoningPhase",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "capability_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Capability Id"
          },
          "interpretation_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/ReasoningInterpretationStatus"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/$defs/CapabilityMode"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "phase": {
            "$ref": "#/$defs/ReasoningPhase"
          },
          "reported_assurance_level": {
            "anyOf": [
              {
                "$ref": "#/$defs/CapabilityAssuranceLevel"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reported_completeness_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/CapabilityCompletenessStatus"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reported_execution_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutionStatus"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "run_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run Id"
          },
          "summary": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "summary"
        ],
        "title": "reasoning_writeArguments",
        "type": "object"
      },
      "name": "reasoning.write",
      "outputSchema": {
        "$defs": {
          "ReasoningNextRequired": {
            "enum": [
              "BEFORE_TOOL_OR_FINAL",
              "CAPABILITY_INVOKE",
              "AFTER_TOOL",
              "NONE"
            ],
            "title": "ReasoningNextRequired",
            "type": "string"
          },
          "ReasoningRunState": {
            "enum": [
              "READY",
              "READY_TO_INVOKE",
              "TOOL_RUNNING",
              "AWAITING_AFTER_TOOL",
              "FINALIZED"
            ],
            "title": "ReasoningRunState",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "assurance_level_matches": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Assurance Level Matches"
          },
          "call_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "completeness_status_matches": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Completeness Status Matches"
          },
          "execution_status_matches": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Execution Status Matches"
          },
          "log_uri": {
            "pattern": "^reasoning://run/[0-9a-f-]{36}$",
            "title": "Log Uri",
            "type": "string"
          },
          "next_required": {
            "$ref": "#/$defs/ReasoningNextRequired"
          },
          "run_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "sequence": {
            "minimum": 0,
            "title": "Sequence",
            "type": "integer"
          },
          "state": {
            "$ref": "#/$defs/ReasoningRunState"
          }
        },
        "required": [
          "run_id",
          "sequence",
          "state",
          "next_required",
          "log_uri"
        ],
        "title": "ReasoningWriteResult",
        "type": "object"
      },
      "title": "Write a concise external reasoning summary"
    }
  ]
