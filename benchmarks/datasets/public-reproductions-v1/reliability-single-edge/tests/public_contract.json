          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "maxItems": 1,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "result",
      "witness"
    ],
    "type": "object"
  },
  "task_id": "jacobian/reliability-single-edge"
