{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "GRAPHICAL",
            "NONGRAPHICAL"
          ]
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/violation"
          },
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "status",
        "edges",
        "violations"
      ],
      "type": "object"
    },
    "edge": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "violation": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "minimum": 1,
          "type": "integer"
        },
        "lhs": {
          "minimum": 0,
          "type": "integer"
        },
        "rhs": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "k",
        "lhs",
        "rhs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/case"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "cases"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
