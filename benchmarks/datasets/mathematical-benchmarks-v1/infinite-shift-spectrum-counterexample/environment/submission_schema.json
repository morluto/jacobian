{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "MISSING_FINITE_DIMENSIONAL_SCOPE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "basis_index": {
                "type": "integer"
              },
              "s_output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "st_output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "t_output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ts_output": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "basis_index",
              "s_output",
              "t_output",
              "st_output",
              "ts_output"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "basis_window": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 8
            }
          ],
          "type": "array"
        },
        "identity_product": {
          "enum": [
            "ST",
            "TS"
          ]
        },
        "missing_assumption": {
          "const": "FINITE_DIMENSIONALITY"
        },
        "orientation": {
          "enum": [
            "S_RIGHT_T_LEFT",
            "S_LEFT_T_RIGHT"
          ]
        },
        "spectral_conclusion": {
          "const": "EIGENVALUE_SETS_DIFFER"
        },
        "zero_eigenvalue_product": {
          "enum": [
            "ST",
            "TS"
          ]
        },
        "zero_eigenvector_basis_index": {
          "const": 0
        }
      },
      "required": [
        "orientation",
        "basis_window",
        "actions",
        "zero_eigenvalue_product",
        "identity_product",
        "zero_eigenvector_basis_index",
        "spectral_conclusion",
        "missing_assumption"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/infinite-shift-spectrum-counterexample"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
