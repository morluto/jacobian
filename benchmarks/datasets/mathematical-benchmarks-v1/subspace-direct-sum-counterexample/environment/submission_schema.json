{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "FALSE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "dependence_coefficients": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "generators": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "generators",
        "dependence_coefficients"
      ],
      "type": "object"
    },
    "scope": {
      "const": "subspace-direct-sum-counterexample exact rational-linear witness",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/subspace-direct-sum-counterexample"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
