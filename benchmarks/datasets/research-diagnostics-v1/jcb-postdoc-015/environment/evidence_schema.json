{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integer_set", "ordered_differences", "sidon", "fixed_order_checks", "universal_obstruction_replayed"],
  "properties": {
    "schema_version": {"const": "1"},
    "integer_set": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$"}},
    "ordered_differences": {
      "type": "array",
      "maxItems": 992,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minuend", "subtrahend", "difference"],
        "properties": {
          "minuend": {"type": "string"},
          "subtrahend": {"type": "string"},
          "difference": {"type": "string"}
        }
      }
    },
    "sidon": {"type": "boolean"},
    "fixed_order_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_order", "modulus", "base_residues", "candidate_space_size", "decision", "coverage"],
        "properties": {
          "target_order": {"type": "integer", "minimum": 2, "maximum": 64},
          "modulus": {"type": "integer", "minimum": 2, "maximum": 4096},
          "base_residues": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "candidate_space_size": {"type": "integer", "minimum": 1, "maximum": 50000},
          "decision": {"enum": ["EXTENDS", "DOES_NOT_EXTEND"]},
          "coverage": {"enum": ["WITNESS", "ALL_CANDIDATES"]}
        }
      }
    },
    "universal_obstruction_replayed": {"type": "boolean"}
  }
}
