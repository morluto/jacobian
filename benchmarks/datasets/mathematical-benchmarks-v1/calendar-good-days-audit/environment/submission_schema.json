{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "good_dates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "concatenated": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "month": {
                "type": "integer"
              }
            },
            "required": [
              "month",
              "day",
              "concatenated"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "good_dates"
      ],
      "type": "object"
    },
    "witness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "result",
    "witness"
  ],
  "type": "object"
}
