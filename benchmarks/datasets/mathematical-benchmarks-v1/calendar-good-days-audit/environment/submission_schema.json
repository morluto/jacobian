{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "good_dates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "concatenated": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "month": {
                "type": "integer"
              }
            },
            "required": [
              "month",
              "day",
              "concatenated"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "good_dates"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
