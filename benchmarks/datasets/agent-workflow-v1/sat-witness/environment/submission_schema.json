{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "claimed_assurance": {
        "const": "VERIFIED"
      }
    }
  },
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "SATISFIABLE"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "boolean"
            },
            "b": {
              "type": "boolean"
            },
            "c": {
              "type": "boolean"
            },
            "d": {
              "type": "boolean"
            }
          },
          "required": [
            "a",
            "b",
            "c",
            "d"
          ],
          "type": "object"
        },
        "status": {
          "enum": [
            "SATISFIABLE",
            "UNSATISFIABLE"
          ]
        }
      },
      "required": [
        "status",
        "assignment"
      ],
      "type": "object"
    },
    "scope": {
      "const": "jacobian/sat-witness complete finite input",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/sat-witness"
    },
    "verification_record_uri": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "evidence/verification-record.json"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "then": {
    "required": [
      "verification_record_uri"
    ]
  },
  "type": "object"
}
