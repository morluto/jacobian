{
  "$defs": {
    "polynomial": {
      "items": {
        "$ref": "#/$defs/term"
      },
      "maxItems": 70,
      "minItems": 1,
      "type": "array"
    },
    "rational_formula": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "$ref": "#/$defs/polynomial"
        },
        "numerator": {
          "$ref": "#/$defs/polynomial"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "term": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "type": "string"
        },
        "exponents": {
          "items": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "exponents",
        "coefficient"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "BRANCH_COMPLETE_FORMULAS_CERTIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "branch_partition": {
          "const": [
            "GENERIC_DENOMINATOR_NONZERO",
            "RANK_ONE_X_EQUALS_Y"
          ]
        },
        "generic_formula": {
          "$ref": "#/$defs/rational_formula"
        },
        "rationality_conclusion": {
          "const": "E_RATIONAL_IN_BOTH_BRANCHES"
        },
        "singular_formula": {
          "$ref": "#/$defs/rational_formula"
        },
        "variables": {
          "const": [
            "A",
            "B",
            "C",
            "D"
          ]
        }
      },
      "required": [
        "variables",
        "generic_formula",
        "singular_formula",
        "branch_partition",
        "rationality_conclusion"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/exponential-moment-rationality"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
