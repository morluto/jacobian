{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "VALID_NONDIFFERENTIABLE_MAXIMUM",
        "NO_CONSTRUCTION",
        "UNSUPPORTED"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "left_derivative": {
          "type": "string"
        },
        "left_slope": {
          "type": "string"
        },
        "left_value_at_join": {
          "type": "string"
        },
        "peak": {
          "type": "string"
        },
        "right_derivative": {
          "type": "string"
        },
        "right_slope": {
          "type": "string"
        },
        "right_value_at_join": {
          "type": "string"
        }
      },
      "required": [
        "peak",
        "left_slope",
        "right_slope",
        "left_value_at_join",
        "right_value_at_join",
        "left_derivative",
        "right_derivative"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/nondifferentiable-maximum-construction"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
