{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result": {
      "additionalProperties": false,
      "properties": {
        "complement_relation": {
          "const": "IMPLEMENTED_PLUS_INTENDED_EQUALS_PAIR_COUNT_PER_PERMUTATION"
        },
        "implemented_aggregate": {
          "type": "integer"
        },
        "implemented_count": {
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "intended_aggregate": {
          "type": "integer"
        },
        "intended_count": {
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "pair_count": {
          "const": 6
        },
        "witness_permutation": {
          "items": {
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "witness_permutation",
        "implemented_count",
        "intended_count",
        "implemented_aggregate",
        "intended_aggregate",
        "pair_count",
        "complement_relation"
      ],
      "type": "object"
    }
  },
  "required": [
    "result"
  ],
  "type": "object"
}
