{
  "$defs": {
    "rational": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "num": {
          "pattern": "^(?:0|-?[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "const": "COMPLETE"
    },
    "conclusion": {
      "const": "GRAPH_SET_DISTANCE_CERTIFIED"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/certificate.json"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "const": "NO_CLAIM_BEYOND_THE_DECLARED_FINITE_GRAPH"
        }
      ],
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "distance_to_set": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "distance": {
                "minimum": 0,
                "type": "integer"
              },
              "vertex": {
                "type": "string"
              }
            },
            "required": [
              "vertex",
              "distance"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "maximizing_vertices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_degree_vertices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_distance_to_set": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximum_degree_vertices",
        "distance_to_set",
        "maximum_distance_to_set",
        "maximizing_vertices"
      ],
      "type": "object"
    },
    "scope": {
      "const": "EXACT_DECLARED_FINITE_GRAPH:coordination-graph-set-distance-01",
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/coordination-graph-set-distance-01"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
