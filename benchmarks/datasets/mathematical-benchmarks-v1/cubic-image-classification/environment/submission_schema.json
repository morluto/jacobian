{
  "$defs": {
    "affine": {
      "items": false,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_assurance": {
      "enum": [
        "UNVERIFIED",
        "COMPUTED",
        "CHECKED",
        "VERIFIED"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "enum": [
        "IMAGE_CLASSIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "const": "evidence/answer.txt"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "excluded_residues_mod_9": {
          "items": {
            "maximum": 8,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "factorization": {
          "additionalProperties": false,
          "properties": {
            "linear": {
              "const": "A+B+C"
            },
            "quadratic": {
              "const": "A^2+B^2+C^2-AB-AC-BC"
            }
          },
          "required": [
            "linear",
            "quadratic"
          ],
          "type": "object"
        },
        "families": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "A": {
                "$ref": "#/$defs/affine"
              },
              "B": {
                "$ref": "#/$defs/affine"
              },
              "C": {
                "$ref": "#/$defs/affine"
              },
              "covered_residues": {
                "items": {
                  "maximum": 8,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array",
                "uniqueItems": true
              },
              "parameter_min": {
                "minimum": 0,
                "type": "integer"
              },
              "value": {
                "$ref": "#/$defs/affine"
              }
            },
            "required": [
              "parameter_min",
              "A",
              "B",
              "C",
              "value",
              "covered_residues"
            ],
            "type": "object"
          },
          "minItems": 3,
          "type": "array"
        },
        "image_residues_mod_9": {
          "items": {
            "maximum": 8,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "factorization",
        "image_residues_mod_9",
        "excluded_residues_mod_9",
        "families"
      ],
      "type": "object"
    },
    "scope": {
      "type": "string"
    },
    "task_id": {
      "const": "jacobian/cubic-image-classification"
    }
  },
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "type": "object"
}
